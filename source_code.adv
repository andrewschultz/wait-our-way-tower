booleans {
   # game state (noncritical)
   showed_first_note : boolean "false" ;
   warn_score_header : boolean "false" ;
   wait_yet : boolean "false" ;
   me_x_yet : boolean "false" ;
   won_yet : boolean "false" scope="survivor" ;
   in_number_choice : boolean "false" ;

   # option(s)
   opt_hone_aye : boolean "false" ;
   opt_color_coding : boolean "false" ;

   # game state (critical)
   gamestate_r12_e : boolean "false" ;

   # points
   point_can_do      : boolean "false" ; # 00
   point_fell_asleep : boolean "false" ; # 04
   point_halt_error  : boolean "false" ; # 03
   point_hate_rash   : boolean "false" ; # 05
   point_thief_lore  : boolean "false" ; # 01
   point_yell_open   : boolean "false" ; # 02

   # not in place yet
   point_cue_bland  : boolean "false" ; # 101
   point_eh_sink    : boolean "false" ; # 101

   # silly random
   r02_jail : boolean "false" ;

   # general go-blocking
   goblock_12 : dynamic_boolean {( !point_yell_open)} ;

   #core points-done blockers
   coreblock_02 : dynamic_boolean {( opt_hone_aye && point_yell_open )} ;

   #bonus points-done blockers
   bonusblock_02 : dynamic_boolean {( opt_hone_aye && point_yell_open )} ;

   # think variables
   already_got_command : boolean "false" ;
   first_half : boolean "false" ;
   half_bonus : boolean "false" ;
   bonus_obfuscated_note_yet : boolean "false" ;
   bonus_half_note : boolean "false" ;
   think_core_yet : boolean "false" ;
   think_bonus_yet : boolean "false" ;
   think_text_yet : boolean "false" ;
   print_bonus_nag_after : boolean "false" scope="survivor" ;
   print_core_nag_after : boolean "false" ;
   solved_both_parts_core_nag : boolean "false" ;
   solved_both_parts_bonus_nag : boolean "false" ;

   in_bonus_half : boolean "false" ;
   unneeded_half : dynamic_boolean {( tempint == 0 && !in_bonus_half )} ;

   # think variables
   think_cue_bland : boolean "false" ;

   # blocker dynamic booleans
   r02_hone_block : dynamic_boolean {( opt_hone_aye )} ;

   think_any : dynamic_boolean {( 1 == 0 )} ;
   show_overlay : boolean "true" ;
}

vocabulary {
}

locations {
   r02 : location "{r02_loc}" header="{r02_header}" graphic="r02_1" {
      on_command {
         : match "can do" {
            : if (point_can_do) {
               : print "You already showed you could, and you did. Time to move on." ;
               : done ;
            }
            : print "You shake off your feelings of dread. You become a bit more aware of your surroundings. In particular, {puz_point_the_floor}." ;
            : set_integer var="tempint" "0" ;
            : set_true "point_can_do" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_can_do) {
            : match "can _;_ do" {
               : set_integer var="tempint" "0" ;
               : set_false "first_half" ;
               : match "can _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_can_do) {
            : match "thief lore" {
               : if (point_thief_lore) {
                  : print "You don't find anything else hidden in the floor." ;
                  : done ;
               }
               : print "You think back to what thief lore you might know. You only know surface stuff. You think of stuff you could use to pick the lock on the outside. Perhaps it was buried under the floor by the last inhabitant. And what do you know? You find something! A yellow pin! All right!" ;
               : print "The euphoria wears off after you find the pin, though. There's no lock to put it into, and it's too flimsy. But it's something." ;
               : set_true "point_thief_lore" ;
               : set_integer var="tempint" "1" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_thief_lore) {
               : match "thief _;_ lore" {
                  : set_integer var="tempint" "1" ;
                  : set_false "first_half" ;
                  : match "thief _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
         : if (point_thief_lore) {
            : match "yell open" {
               : if (point_yell_open) {
                  : print "No need to yell open again!" ;
                  : done ;
               }
               : print "The yellow pin glows in your hand and explodes." ;
               : set_integer var="tempint" "2" ;
               : set_true "point_yell_open" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_yell_open) {
               : match "* pin" {
                  : print "You fumble with the pin a bit. Whatever you need to do with it doesn't require dexterity..." ;
                  : done ;
               }
               : match "yell _;_ open" {
                  : set_integer var="tempint" "3" ;
                  : set_false "first_half" ;
                  : match "yell _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r12 : location "{r12_loc}" header="{r12_header}" {
      on_command {
         : if (!point_halt_error) {
            : match "n _;s _;e _" {
               : print "Not with the hall terror blocking the way." ;
               : done ;
            }
         }
         : if (point_halt_error && !point_fell_asleep) {
            : match "e _" {
               : cycle key = "r12_e_block" predictable_order = "true" skip_interval = "0" max_loops = "1" {
                  : print "The way seems a bit dark, but before you get too far, you hear a loud voice shout \"{puz_point_fellas_leap}!\" Nope, bad idea to go there as-is." ;
                  : print "Still the voice yelling \"{puz_point_fellas_leap}!\"" ;
               }
               : set_true "gamestate_r12_e" ;
            }
         }
         : match "halt error" {
            : if (point_halt_error) {
               : print "Already done!" ;
               : done ;
            }
            : print "What good can such words do against a terror? But they're worth a try. Surprisingly, the terror lets up a bit. It seems to do some calculations then mentioned, you are not the optimal person to be terrorizing at the time, if you said something like that. It goes in search of other prey. You hear voices after this." ;
            : set_integer var="tempint" "3" ;
            : set_true "point_halt_error" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_halt_error) {
            : match "halt _;_ error" {
               : set_integer var="tempint" "3" ;
               : set_false "first_half" ;
               : match "halt _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_halt_error && !point_fell_asleep) {
            : gosub "listen_stub" ;
         }
         : if (gamestate_r12_e) {
            : match "fell asleep" {
               : if (point_fell_asleep) {
                  : print "You don't want to oversell this." ;
                  : done ;
               }
               : print "Narrative text." ;
               : set_integer var="tempint" "4" ;
               : set_true "point_fell_asleep" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_fell_asleep) {
               : match "fell _;_ asleep" {
                  : set_integer var="tempint" "4" ;
                  : set_false "first_half" ;
                  : match "fell _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r13: location "{r13_loc}" header="{r13_header}" {
      on_command {
         : match "hate rash" {
            : if (point_hate_rash) {
               : print "Already done!" ;
               : done ;
            }
            : print "Narrative text." ;
            : set_integer var="tempint" "5" ;
            : set_true "point_hate_rash" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_hate_rash) {
            : match "hate _;_ rash" {
               : set_integer var="tempint" "5" ;
               : set_false "first_half" ;
               : match "hate _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r14: location "{r14_loc}" header="{r14_header}" {
      on_command {
         : match "eh sink" {
            : if (point_eh_sink) {
               : print "{puz_ace_inc} already sank!" ;
               : done ;
            }
            : print "Ace, Inc. slowly sinks. You hope the message about no humans being there is true. You hear no screams or confusions, just robots whirring and glitching." ;
            : print "What is revealed is a garish cube land." ;
            : set_integer var="tempint" "100" ;
            : set_true "point_eh_sink" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (point_eh_sink) {
            : match "cue bland" {
               : if (point_cue_bland) {
                  : print "Already done!" ;
                  : done ;
               }
               : print "Narrative text." ;
               : set_integer var="tempint" "101" ;
               : set_true "point_cue_bland" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_cue_bland) {
               : match "cue _;_ bland" {
                  : set_integer var="tempint" "101" ;
                  : set_boolean var="already_got_command" {( think_cue_bland && !point_cue_bland )} ; # this is optional. Delete if point does not rely on any other variables.
                  : set_false "first_half" ;
                  : match "cue _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
         : if (!point_eh_sink) {
            : match "sink *" {
               : print "Right idea, but a giant sink might be impassable. Or it might drown you. And {puz_ace_inc} couldn't be changed to a SMALL sink." ;
               : done ;
            }
            : match "eh _;_ sink" {
               : set_integer var="tempint" "100" ;
               : set_false "first_half" ;
               : match "eh _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
}

# Defines things in the world (scenery cannot be carried)
objects {
   phase_tats : object "{i_fspt}" ;
}

connections {

   from, direction, to = [
      r02, east, r12,
      r12, north, r13
   ]

}

barriers {

   # general block going
   block_go_r12 : block {
      location = r12
      block_when = goblock_12
      message = THE DOOR blocks you.
   }

   # block going with HONE/bonus
   block_core_r02 : block {
      location = r02
      block_when = coreblock_02
      message = You have nothing left to do back where you started.
   }

   # block going with HONE/core
   block_bonus_r02 : block {
      location = r12
      block_when = bonusblock_02
      message = You have nothing left to do back where you started.
   }
}

subroutines {
# first standard verbs
# second auxiliary
# third options
   listen_stub : subroutine {
      : if (is_at "r02") {
         : print "You hear nothing but occasionally mutter to yourself <rue my room, aye<#888>>." ;
      } : else_if (is_at "r12") {
         : print {( point_fell_asleep ? "It's quiet now." : point_halt_error ? (gamestate_r12_e ? "The \"{puz_point_fellas_leep}\" order echoes in your head." : "Quiet, for the moment.") : "The hall terror is making all kinds of noise." )} ;
      } : else {
         : print "Nothing." ;
      }
   }
   add_point : subroutine {
      : gosub "check_100" ;
      : collection_modify { collection = "tried_combo_core" index -> (tempint) content -> ("true") } ;
      : print "<Your score has just gone up by a point!<#ff0>>" ;
	  : increment "score" ;
	  : update_graphic ;
   }
   check_100 : subroutine {
      : if (tempint >= 100) {
         : cycle key = "one_right_bug" predictable_order = "true" skip_interval = "0" max_loops = "1" {
            : print "One word right, one word wrong. (NOTE: this text shouldn't come up in release, but if it does, it's a bug. Not a game breaking one, but it affects THINK and showing half-right guesses. So I need to give this point-scoring command a proper index. Let me know which puzzle.)" ;
            : print "One word right, one word wrong. (Again, bug, needs index, let me know which puzzle.)" ;
         }
      }
   }
   say_half : subroutine {
      : match "* -;- *" {
         : print "Feels right, but what to pair that word with?" ;
         : done ;
      }
      : gosub "check_100" ;
      : cycle key = "one_right" predictable_order = "true" skip_interval = "0" max_loops = "1" {
         : print "One of those words felt right, but the other didn't. You must be halfway there{for_bonus}.{already_got_check}" ;
         : print "Again, you feel like you got halfway there{for_bonus}.{already_got_check}" ;
         on_exhausted {
            : print "One word right, one word wrong{for_bonus}.{already_got_check}" ;
         }
      }
      : if (first_half) {
         : if (half_bonus) {
            : collection_modify { collection = "got_first_bonus" index -> (tempint) content -> ("true") ; }
         } : else {
            : collection_modify { collection = "got_first_core" index -> (tempint) content -> ("true") ; }
         }
      } : else {
         : if (half_bonus) {
            : collection_modify { collection = "got_second_bonus" index -> (tempint) content -> ("true") ; }
         } : else {
            : collection_modify { collection = "got_second_core" index -> (tempint) content -> ("true") ; }
         }
      }
      : set_false "already_got_command" ;
      : if (!half_bonus) {
         : done ;
      }
   }

   ########################## options

   check_options : subroutine {
      : match "hone aye;hone eye" {
         : print {( "Available exits are " + (opt_hone_aye ? "already" : "now") + " honed to ones you still need to use to win." )} ;
         : if (tats_number == 0 && !opt_hone_aye) {
            : print "Since you're choosing this option, and you're done here, I'll make a note of that. You can exit, but you can't come back." ;
         }
         : set_true "opt_hone_aye" ;
      }
      : match "ho nigh" {
         : print {( "Exits are " + (opt_hone_aye ? "already" : "now") + " all available, even ones you don't need to revisited." )} ;
         : set_false "opt_hone_aye" ;
      }
   }

   ############################ rejects

   odd_dir_note : subroutine {
      : match "se _;sw _;ne _;nw _" {
         : print "You don't need to use diagonal directions. Only the four main cardinal directions, and (where indicated) up/down." ;
         : done ;
      }
      : match "u _;d _;enter _;in _;exit _;out _" {
         : print "Only the four main cardinal directions are used here, and (only when indicated) up/down." ;
         : done ;
      }
   }

   #########################################diagnostics

   diagnostic_think_core_half : subroutine {
      : set_integer var="counter" "0" ;
      : set_false "think_core_yet" ;
      : while (counter < max_score) {
         : if ((collection_get{ collection -> ("tried_combo_core") index -> ( counter )} == "false")) {
            : if (part_core_score > 0) {
               : if (!think_core_yet) {
                  : print "{think_here_also} is a summary of correct bonus command half-guesses:" ;
                  : set_true "think_core_yet" ;
                  : set_true "think_text_yet" ;
               }
               : print {( (part_core_score != 2 ? (collection_get{ collection -> ("think_first_core") index -> (counter) }) : "{noguess_c_1}") + " " + (part_core_score >= 2 ? (collection_get{ collection -> ("think_second_core") index -> (counter) }) : "{noguess}") + " " + (collection_get{ collection -> ("situations_core") index -> (counter) }) )} ;
               : if (!solved_both_parts_core_nag && part_core_score == 3) {
                  : set_true "print_core_nag_after" ;
               }
            }
         }
         : increment "counter" ;
      }
   }

########################## options


}

themes {
   my_theme : theme {
      status_bar {
         : header_text ;
         : dynamic_text "my_score" ;
      }
      theme_settings {
         parser_delay  = 0
      }
      colors {
         status_bar_pen   = 15
         status_bar_paper = #222
      }
      system_messages {

   i_cant_do_that = That's a valid command, but not right here and now.
   not_present = You can't see ${entity} here.
   ask_new_game                                   = Would you like to restart {wowt}?
   ask_quit                                       = \"Sign out. *SIGH*, nowt!\", you mutter under your breath.\"\nDo you wish to quit {wowt}?
   invalid_choice                                 = {yn_or_12_or_14}
   post_quit = I hope you enjoyed the experience. Pressing {key_enter} will restart {wowt}.
   unknown_verb                                   = {custom_unknown_verb_error}
   you_cant_go_that_direction                     = {exits_err}
   you_see_nothing_special = {nospecial_custom}
   you_see_nothing_special_2 = {nospecial_custom}
      }
   }
}

## Print the objective when the game starts

on_startup {
   : print "{wowt}: an {ifcomp} Petite Mort 2026 entry.";
   : if (won_yet) {
      : print "Thanks for replaying, but this is a reminder to look at the other {ifcomp} entries, too!" ;
      : press_any_key ;
   }
   : if (random(1) == 1) {
      : set_true "r02_jail" ;
   } : else {
      : set_false "r02_jail" ;
   }
   : print "Intro." ;
   : press_any_key ;
   : clear_screen;
}

## Execute this every time a player moves or redescribes a location

on_describe {
}

## Test VERB NOUN that the player types and executes conditional actions

on_command {
   : match "xyzzy _" {
      : print "A hollow voice intones \"Our gaol: argh, ail!\" It's so spooky, you don't dare quibble over details of pronunciation." ;
      : done ;
   }
   : mask {
      : match "load -" {
         : print "You hear a low \"Do load, ooh!\"" ;
      }
      : match "restore -" {
         : print "You hear a tune. It could be called a re-load reel/ode, I guess." ;
      }
      : match "save -" {
         : print "A ghostly apparition with \"Save? Illun', Say!\" Villain written on its front taunts your very reasonable precaution. But you don't need to listen to such meanies." ;
      }
   }
   : match "i _" {
      : if (score < 2) {
         : print "Nothing." ;
         : done ;
      }
      : if (score == 2) {
         : print "Well, you now have a yellow pin, which is something." ;
         : done ;
      }
   }
   : gosub "check_options" ;
   : gosub "odd_dir_note" ;
   : match "z _;wait _" {
      : print "\"Loaf, right? Lo, fright!\"" ;
      : if (!wait_yet) {
         : print "{one_time}This is just a silly general response. Waiting gives no penalty or benefit." ;
         : set_true "wait_yet" ;
      }
   }
   : match "about _" {
      : print "{wowt} was written for {ifcomp} 2026." ;
      : print "{wowt} has the same mechanic as two games I wrote in Inform 7: {l_wp} and {l_ut}. It's about their size. I have other three games in a similar vein." ;
      : print "Every point scoring command is an unusual verb, which it is indicated by the location, or something in the location." ;
      : print "Some text is color-coded. <Green<#0f0>> is a clickable link, and <Orange<#f80>> or purple indicates a verb you can use. <Lavender<#88f>> text clues what to focus on." ;
   }
   : match "credits _;credit _" {
      : print "Thanks to (testers)." ;
      : print "Thanks to IFComp administrators past and present and to reviewers and judges past and present. Without then, I would not have dived into this enjoyable (hey, at least for me) nonsense." ;
      : print "Thanks to Chris Ainsley for creating Adventuron." ;
   }
   : match "help _;hint _;hints _" {
      : if (!me_x_yet) {
         : print "There are no specific hints now you've gotten past the first puzzle, but {xme} will give you a hint item which may be intuitive, but if not, come back here for an explanation." ;
      } : else {
         : cycle key = "help_general" predictable_order = "true" skip_interval = "0" {
            : print "Ahead is an explanation of {xtats}, which gives a number that clues what you need to do in the current room. Note that it doesn't track whether or not you're ready to, though you can still guess, and {vm_think} will hold it for later." ;
            : print "The number 0 means there is nothing else left to do." ;
            : print "A two-digit number tells you something about the two words you need. I didn't make it too out-there, I hope." ;
            : print "The tens digit is the length of the first word, and the ones digit is the length of the second." ;
            : print "So, for instance, using the tats for the first puzzle would give 44, as each of the first puzzle has four letters." ;
            : print "First words range from 1 to 6 letters. Second words range from 2 to 7. This is the final clue. The clues will now cycle." ;
         }
      }
      : print "Fill in later." ;
   }
   : match "history _;version _;versions _" {
      : print "The first release of {wowt} was September 1, 2026, for {ifcomp} Petite Mort." ;
   }
   : match "score _" {
      : print "You've currently scored {score} of {max_score} total points. There are no bonus points." ;
      : if (!warn_score_header) {
         : print "{one_time}This is tracked in the upper left." ;
         : set_true "warn_score_header" ;
      }
   }
   : match "listen _" {
      : gosub "listen_stub" ;
   }
   : match "think _" {
      : set_false "think_text_yet" ;
      : if (commands_figured > 0) {
         : print {( "Here " + (commands_figured > 1 ? "are {number_as_word} things that seemed like they" : "is something that seemed like it") + " should work, but you didn't have the resources yet:" )} ;
      }
      : gosub "diagnostic_think_core_half" ;
      : if (print_core_nag_after) {
         : print "{one_time}You have figured each half of a point-scoring command, but you haven't typed them both together. That still might not work if you haven't prepared by solving other puzzles, but if that's the case, {vd_think} will remind you with context until it does." ;
         : set_true "solved_both_parts_core_nag" ;
         : set_false "print_core_nag_after" ;
      }
      : if (print_bonus_nag_after) {
         : print "{one_time}You have figured each half of a bonus point scoring command, but you haven't typed them both together. {vd_think} will remind you of this try until it works, though game state changes may make, or have made, this undoable until you replay." ;
         : set_true "solved_both_parts_bonus_nag" ;
         : set_false "print_bonus_nag_after" ;
      }
      : if (!think_any) {
         : print "You haven't had any good ideas you weren't able to execute yet." ;
         : done ;
      }
   }
   : match "verbs _;verb _" {
      : print "To complete {wowt}, you only need the four compass directions (well, the exit from the first room is up) and the twelve special commands clued by descriptions." ;
      : print "There are also metaverbs: {vm_about} gives general information, {vm_credits} gives credits, and {vm_versions} shows version history and release dates." ;
      : print "Finally, there is an option: {hone_aye} blocks off exits to done rooms and what is behind them, while {ho_nigh} lets you traverse freely." ;
   }
   : match "take _;drop _" {
      : print "You don't need to TAKE or DROP anything here. It's all done for you." ;
      : done ;
   }
   : match "x me;x myself" {
      : if (!me_x_yet) {
         : print "Weird. You see some numbers on your arm that seem to morph a bit. Perhaps they can help in some way. Let's call them fey stats/phase-tats." ;
         : pocket "phase_tats" ;
         : set_true "me_x_yet" ;
      } : else {
         : print "Nothing on you but the tats which can give hints." ;
      }
      : done ;
   }
   : if (me_x_yet) {
      : match "_ tats;_ fey;_ phase;_ stats" {
         : print "The tats swirl and form a number: {tats_number}." ;
         : done ;
      }
   }

   : match "can _;eh _;halt _;sink _;thief _;yell _" { #obfuscation of non solutions, regular points
      : print "{custom_unknown_verb_error}" ;
      : done ;
   }

}

on_tick {
   : if (!showed_first_note) {
      : print "{one_time}{vm_about} will give general game information. {vm_verbs} will describe {wowt}'s stripped-down parser." ;
      : set_true "showed_first_note" ;
   }
}

on_render {
   : if (!show_overlay) {
      : done ;
   }
   : if (is_at "r02") {
      : if (r02_jail) {
         : overlay "r02_rand_1" x="0" y="0" ;
      } : else {
         : overlay "r02_rand_2" x="0" y="0" ;
      }
   }
}

assets {
   graphics {
      r_blank : base64_png "iVBORw0KGgoAAAANSUhEUgAAAQAAAAAYAQMAAAAvTrFnAAAAA1BMVEX//wCKxvRFAAAAD0lEQVR4XmPAAKNgFIwCAAMYAAFrMpCEAAAAAElFTkSuQmCC" ;
      r02_1 : base64_png "iVBORw0KGgoAAAANSUhEUgAAAQAAAAAoAQMAAAArNLbKAAAAA1BMVEUAAACnej3aAAAAE0lEQVR4XmPAC0bBKBgFo2AUAAAFKAABhzzafQAAAABJRU5ErkJggg==" ;
      r02_rand_1 : base64_png "iVBORw0KGgoAAAANSUhEUgAAABUAAAAPAQMAAAAxlBYoAAAABlBMVEUAAAD///+l2Z/dAAAALUlEQVR4XmMAgfr/Hxhc3AUYQvMDgBhChwAxWDw8gCEXiHPA9AcG30CIOBAAAP4GEalNIq2XAAAAAElFTkSuQmCC" ;
      r02_rand_2 : base64_png "iVBORw0KGgoAAAANSUhEUgAAABUAAAAPAQMAAAAxlBYoAAAABlBMVEUAAAD///+l2Z/dAAAALElEQVR4XmMAgfr/Hxhc3AUYQvMDgBhChwAxSNyzPIAhGogjwTSQLwgRBwIAAdsRs8NGrrsAAAAASUVORK5CYII=" ;
   }
}
