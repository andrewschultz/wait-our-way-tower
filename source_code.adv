            : match "door _;_ cloud" {
               : set_integer var="tempint" "22" ;
               : set_false "first_half" ;
               : match "door _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r31 : location "{r31_loc}" header="{r31_header}" {
      on_command {
