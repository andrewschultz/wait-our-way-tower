##################################noun keywords

   noun_keywords : subroutine {
      : if (is_present "thug") {
         : match "_ thug;_ round;_ ground" {
            : print "{trtg_status}" ;
            : set_true "gamestate_thug_pass" ;
            : done ;
         }
      }
      : if (is_present "broke_lass") {
         : match "_ lass;_ broke" {
            : print "She doesn't look or feel broke." ;
            : done ;
         }
      }
      : if (is_present "mage_urgent") {
         : match "_ mage;_ urgent" {
            : print {( point_right_angles ? "His urgency seems a bit more focused." : "A bit of an energetic mess. How to calm him down?" )} ;
            : done ;
         }
      }
   }

##################################multi-room functions

   fey_loops_check : subroutine {
      : if (!point_fey_loops) {
         : return ;
      }
      : if (!is_at "r04" && !is_at "r14") {
         : return ;
      }
      : match "_ fey;_ loops" {
         : print {( "There's nothing wild about the fey loops or the passage through them now you've found them. You would probably get exhausted or bored wandering through them too many times." + (gamestate_thug_gone ? " You got use out of them with the thug." : "But they could be useful, somehow.") )} ;
         : done ;
      }
   }

##################################testjumps

   testing_stuff : subroutine {
      : match "testjump _" {
         : gosub "testjump" ;
         : done ;
      }
      : match "tatmv _" {
         : if (!tats_each_move) {
            : set_true "tats_each_move" ;
            : print "Tats each move switched on, starting this move." ;
         } : else {
            : set_false "tats_each_move" ;
            : print "Tats each move switched off." ;
            : done ;
         }
      }
      : match "imv _" {
         : if (!inventory_each_move) {
            : set_true "inventory_each_move" ;
            : print "Inventory each move switched on, starting this move." ;
         } : else {
            : set_false "inventory_each_move" ;
            : print "Inventory each move switched off." ;
            : done ;
         }
      }
      : match "lmv _" {
         : if (!listen_each_move) {
            : set_true "listen_each_move" ;
            : print "Listen each move switched on, starting this move." ;
         } : else {
            : set_false "listen_each_move" ;
            : print "Listen each move switched off." ;
            : done ;
         }
      }
   }

   testjump : subroutine {
      : if (score > 0) {
         : print "Too late to TESTJUMP. Start and try again with 0 points." ;
         : done ;
      }
      : match "testjump 1" {
         : gosub "testjump_part_1" ;
         : set_integer var="score" "5" ;
         : goto "r21" ;
         : redescribe ;
         : done ;
      }
      : match "testjump 1n" {
         : gosub "testjump_part_1a" ;
         : goto "r31" ;
         : redescribe ;
         : done ;
      }
      : match "testjump 1s" {
         : gosub "testjump_part_1a" ;
         : goto "r11" ;
         : redescribe ;
         : done ;
      }
      : match "testjump 2" {
         : gosub "testjump_part_1" ;
         : gosub "testjump_part_2" ;
         : set_true "gamestate_fail_oops_known" ;
         : set_integer var="score" "39" ;
         : goto "r24" ;
         : redescribe ;
         : done ;
      }
      : match "testjump 3" {
         : gosub "testjump_part_1" ;
         : gosub "testjump_part_2" ;
         : set_true "gamestate_fail_oops_known" ;
         : set_true "point_fey_loops" ;
         : set_true "point_warm_acres" ;
         : set_integer var="score" "41" ;
         : destroy "thug" ;
         : set_true "gamestate_thug_gone" ;
         : goto "r25" ;
         : redescribe ;
         : done ;
      }
      : print "TESTJUMP 1 sends you to outside the cell, hall cleared, 5 points." ;
      : print "TESTJUMP 1N/1S also clears north and south of the hall, placing you north or south." ;
      : print "TESTJUMP 2 sends you to 1 room before the chase, 39 points." ;
      : print "TESTJUMP 3 sends you to the chase room after you won, 41 points." ;
      : done ;
   }

   testjump_part_1 : subroutine {
      : set_true "point_can_do" ;
      : set_true "point_thief_lore" ;
      : set_true "point_yell_open" ;
      : set_true "point_halt_error" ;
      : set_true "point_fell_asleep" ;
      : set_true "gamestate_r21_e" ;
   }

   testjump_part_1a : subroutine {
      : gosub "testjump_part_1" ;
      : set_true "point_duh_losing" ;
      : set_true "point_hate_rash" ;
      : set_integer var="score" "7" ;
      : goto "r31" ;
      : goto "r21" ;
      : goto "r11" ;
   }

   testjump_part_2 : subroutine {
      : goto "r00" ;
      : goto "r01" ;
      : goto "r02" ;
      : goto "r03" ;
      : goto "r04" ;
      : goto "r10" ;
      : goto "r11" ;
      : goto "r12" ;
      : goto "r13" ;
      : goto "r14" ;
      : goto "r20" ;
      : goto "r21" ;
      : goto "r22" ;
      : goto "r23" ;
      : goto "r24" ;
      : goto "r30" ;
      : goto "r31" ;
      : goto "r32" ;
      : goto "r33" ;
      : goto "r34" ;
      : goto "r40" ;
      : goto "r41" ;
      : goto "r42" ;
      : goto "r43" ;
      : goto "r44" ;
      : set_true "point_hate_rash" ;
      : set_true "point_duh_losing" ;
      : set_true "point_dry_vendors" ;
      : set_true "point_dumb_parable" ;
      : set_true "point_no_injuries" ;
      : set_true "point_coin_ovations" ;
      : set_true "point_tightened_rousing" ;
      : set_true "point_pitch_earning" ;
      : set_true "point_chest_reigning" ;
      : set_true "point_dump_liars" ;
      : set_true "point_feel_daring" ;
      : set_true "point_free_crusty" ;
      : set_true "point_say_four" ;
      : set_true "point_say_loaners" ;
      : set_true "point_pose_teasing" ;
      : set_true "point_sun_catching" ;
      : set_true "point_tufty_key" ;
      : set_true "point_door_cloud" ;
      : set_true "point_flow_tripling" ;
      : set_true "point_me_growth" ;
      : set_true "point_cloth_robbing" ;
      : set_true "point_eh_sink" ;
      : set_true "point_cue_bland" ;
      : set_true "point_ply_towels" ;
      : set_true "point_tense_ops" ;
      : set_true "point_frame_easily" ;
      : set_true "point_seek_rest" ;
      : set_true "point_girl_only" ;
      : set_true "point_fly_traps" ;
      : set_true "point_vine_eater" ;
      : set_true "point_catch_acing" ;
      : set_true "point_herd_all" ;
      : set_true "point_shape_up" ;
      : set_true "point_heard_all" ;
      : set_true "point_whee_plucky" ;
      : set_true "gamestate_bros_second_trigger" ;
      : set_true "gamestate_bros_second_placed" ;
   }

}

themes {
   my_theme : theme {
      status_bar {
         : header_text ;
         : dynamic_text "my_score" ;
      }
      theme_settings {
         parser_delay  = 0
         layout = SB G D X LOCK
      }
      colors {
         status_bar_pen   = 15
         status_bar_paper = #222
      }
      system_messages {

   i_cant_do_that = You found a good guess for a point-scoring command elsewhere.\n(I should reject this more generically. Let me know in my GitHub repo.)
   not_present = You can't see ${entity} here.
   ask_new_game                                   = Would you like to restart {this_game}?
   ask_quit                                       = \"Sign out. *SIGH*, nowt!\", you mutter under your breath.\"\nDo you wish to quit {this_game}?
   invalid_choice                                 = {yn_or_12_or_14}
   post_quit = I hope you enjoyed the experience. Pressing {key_enter} will restart {this_game}.
   unknown_verb                                   = {custom_unknown_verb_error}
   you_cant_go_that_direction                     = {exits_err}
   you_see_nothing_special = {nospecial_custom}
   you_see_nothing_special_2 = {nospecial_custom}
      }
   }
}

## Print the objective when the game starts

on_startup {
   : print "{this_game}: an {ifcomp} 2026 entry.";
   : if (won_yet) {
      : print "Thanks for replaying, but this is a reminder to look at the other {ifcomp} entries, too!" ;
      : press_any_key ;
   }
   : gosub "colorclue_choice" ;
   : print "You, Will Durness, didn't want to do anything crazy on your three-day weekend. Day one's going well! (Technically.)" ;
   : press_any_key ;
   : print "You decided to start doomscrolling in order to stop daydreaming, because daydreaming is impractical, and then after 20 minutes of doomscrolling you started daydreaming again, and you felt bad about that, so you went and doomscrolled to another site, before you went back to daydreaming again. You finally managed to focus on a game you'd beaten several times before, one that felt really smart the first time winning but didn't afterwards. Then you followed several pro baseball box scores between teams you didn't care about. One game went to extra innings. You wanted to just go to bed but felt like a quitter doing so." ;
   : print "You entertain some vague notion of having adventures, wild or not, where you don't have to win the lottery but maybe even just gain perspective you hadn't had before, in big or small matters. But you recall people saying \"Stop fretting! Do what must be done! Be lucky you have all you have!\"" ;
   : press_any_key;
   : clear_screen ;
   : print "To block them out, you visit websites you wasted time on in the past, feeling bad for the ones you forgot. Sigh, trite site, right? you comment to yourself. Then you hear a whirling behind you and several ghostly shapes. You look behind you. \"But it's not EctoComp yet,\" you say. \"Who the heck are you?\"" ;
   : print "You're not sure if one or all three of them say it. \"Come to Wait Our Way Tower. You will get what you want. Not enough of it of course.\" They point bony fingers at you. It is your choice." ;
   : press_any_key ;
   : clear_screen ;
   : print "Or is it? You might as well. As you follow them, you remember you forgot to put the laundry in the dryer four hours earlier. Tough luck. You ask them what it's about ..." ;
   : print "WORD RIFTING, they respond, drifting." ;
   : print "\"I know you are. Or gliding or whatever.\"" ;
   : print "\"NO. DRIFTING.\"" ;
   : print "You realize you haven't talked to a person since you checked in at the athletic club. You let out a torrent of words." ;
   : print "\"WE'RE DRAINING,\" one says, and again you quiet down. Until you approach a large tower. Who are you, you ask?" ;
   : print "\"WE'RE DRIVEN,\" they say, and all your responses seem fragmented." ;
   : print "You feel mesmerized as they guard you to the top of a tower. It's not a very big or tall tower, but it has more than one floor." ;
   : press_any_key ;
   : clear_screen ;
   : print "You find yourself in a small room in the corner of the tower. The figures shrug as the door you entered slams shut. How do I get out, you wonder? What is going on here?" ;
   : print "Well, that's it. You are stuck in {wowtc}. But how long will you have to wait? And why?" ;
   : press_any_key ;
   : clear_screen ;
}

## Execute this every time a player moves or redescribes a location

on_describe {
   : if (!bonus_point_lo_maps && (is_at "r11" || is_at "r31")) {
      : gosub "loam_apse_stuff" ;
   }
   : if (is_present "only_girl") {
      : print "The girl from the isle, {puz_point_her_doll} in hand, is here." ;
   } : else_if (girl_present) {
      : print "The girl from the isle tags along, {puz_point_her_doll} in hand." ;
      : create "only_girl" ;
   }
   : if (is_present "thug") {
      : print {( "The {trtg} " + (is_at("r25") ? "stands here, blocking further passages. How to get around it?" : is_at("r24") ? "chases after you." : "continues to chase after you.") )} ;
   }
   : if (gamestate_end_companions) {
      : if (is_just_entered()) {
         : if (is_present "mage_urgent") {
            : print "{endgame_friends} welcome{endgame_plural} you back." ;
            : done ;
         }
         : if (is_at "end_zone") {
            : print {( "{endgame_friends} follow{endgame_plural} you here." )};
            : create "mage_urgent" ;
            : if (point_broke_lass) {
               : create "broke_lass" ;
            }
         } : else_if (!gameflag_note_pals_stay_end) {
            : print "{one_time}any companions you meet in the endgame won't follow you back to the main area." ;
            : set_true "gameflag_note_pals_stay_end" ;
            : done ;
         }
      } : else_if (is_present "mage_urgent") {
         : print "{endgame_friends} wait{endgame_plural} around, ready to follow." ;
         : done ;
      }
   }
}

## Test VERB NOUN that the player types and executes conditional actions

on_tick {
   : if (tats_each_move) {
      : gosub "set_tats_num" ;
      : print "Tats num this turn {my_tats_num}." ;
   }
   : if (inventory_each_move) {
      : gosub "take_inventory" ;
   }
   : if (listen_each_move) {
      : gosub "listen_stub" ;
   }
   : if (!showed_first_note) {
      : print "{one_time}{vm_about} will give general game information. {vm_verbs} will describe {this_game}'s stripped-down parser." ;
      : set_true "showed_first_note" ;
   }
   : if (won_yet && !showed_read_ooh_note) {
      : print "{one_time}remember, there is nothing to REDO, but there's something else... ask right and I'll discuss my thoughts on writing the game, briefly." ;
      : set_true "showed_read_ooh_note" ;
   }
   : if (is_present("thug") && lastroom != "null") {
      : if (gamestate_thug_pass) {
         : set_false "gamestate_thug_pass" ;
         : done ;
      }
      : cycle key = "thug_fail" predictable_order = "true" skip_interval = "0" {
         : print "Thud. The thug got you. It snickers {puz_point_fail_oops} before lumbering away back to its ground." ;
         : print "Thud. The thug got you again. It again snickers {puz_point_fail_oops} before lumbering away back to its ground." ;
      }
      : set_true "gamestate_fail_oops_known" ;
      : create "thug" target="r25" ;
      : set_false "gamestate_thug_chase" ;
      : update_graphic ;
      : done ;
   }
   : if (gamestate_thug_chase && ((is_at "r04" && previous_location() == "r14") || (is_at "r14" && previous_location() == "r04"))) {
      : print "You send the thug running in loops! It eventually runs out of breath as you run around in loops, until it wanders off to sulk. Bye bye thug!" ;
      : set_true "gamestate_thug_gone" ;
      : set_false "gamestate_thug_chase" ;
      : destroy "thug" ;
      : press_any_key ;
      : update_graphic ;
      : done ;
   }
   : if (gamestate_thug_chase && !is_present("thug")) {
      : print "The thug follows you." ;
      : create "thug" ;
      : if (!note_thug_pass && is_at "r24") {
         : print "{one_time}Some diagnostic actions, and a potential point-scoring action or two, will daze the thug a bit. So you have some leeway." ;
         : set_true "note_thug_pass" ;
      }
      : if (is_just_entered()) {
         : if (lastroom == current_location()) {
            : print {( "The thug catches you doubling back. It roughs you up a bit, nothing serious (perhaps it's lonely and has no-one else to groom its thugginess on. Small victories!) before giving a {puz_point_fail_oops} then " + (is_at "r25" ? "doing a dumb little dance in place." : "trudging back to The Groom-Thug Room, where perhaps it anticipates, rightly or wrongly, another round of this." ) )} ;
            : create "thug" target="r25" ;
            : set_false "gamestate_thug_chase" ;
            : set_true "gamestate_fail_oops_known" ;
            : if (!is_at "r25") {
               : update_graphic ;
            }
            : done ;
         }
         : set_string var="lastroom" {( previous_location() )} ;
         : done ;
      }
   }

}

on_command {
   : if (won_yet) {
      : match "read ooh" {
         : print "Hooray! You found the bonus point where I describe a bit about the game but not too much." ;
         : print "I've always had more than a bit of a problem with self help, and its over simple advice. We'd like simple general principles, of course, but they tend to ignore our own experience.\nAlso, what are we helping ourselves for? What should we help ourselves for?\nI found more that small things help give me a boost to work through big problems, and sometimes distracting myself the right way with them can really give me a shot in the arm. It's sort of like the lottery in reverse, where I might have a one in 10 chance of getting a 20 times boost." ;
         : press_any_key ;
         : print "It's that sort of thing I bring into my game writing. I find it hard to write about big issues, not because I don't care about them, but because I feel like I haven't lived them. So what I came up with here was having a surprising amount of non-physical verbs and nouns and concepts you had to do. How to fight through things? This might not be super dramatic, but I wanted it to be something worthwhile, something you'd enjoy, maybe something that might help you with something in the future, big or small, if you didn't know what." ;
         : print "I hope I didn't overdo it. The one problem of giving a character lethargy or self doubt to fight through is that they doubt why they're playing this game. I doubted why I was writing this at several points. I'm not the first person to write about it, but I hope I gave an interesting perspective." ;
         : print "Anyway, thanks for reading, with enthusiasm no less, faked or otherwise. Have a bonus point, and poke at those other IFComp games now!" ;
         : done ;
      }
   }
   : gosub "noun_keywords" ;
   : if (is_at "r33" || is_at "r43") {
      : match "_ aw;_ flake;_ off;_ lake" {
         : if (is_at "r33") {
            : print {( "Aw-Flake-Off-Lake houses all manner of people looking for leisure. It's really packed. " + ( has_visited "r43" ? "But you've found adventure beyond." : "Maybe there's something for you." ) )} ;
         } : else {
            : print {( "It's pretty " + (point_flow_tripling ? "active here now you figured how to speed things up, but there are plenty of places to go ashore and pause if the currnt is too much." : "calm now. What could be beyond?") )} ;
         }
      }
   }
   : if (girl_present) {
      # HERD ALL for the cats
      : match "_ awl" {
         : print "You don't need to go poking holes in anything." ;
      }
      : match "herd all" {
         : if (point_herd_all) {
            : print "You've already herded all the cats for when they are needed." ;
            : done ;
         }
         : if (!is_at "r00" || !point_fly_traps) {
            : print "Nothing to herd en masse here." ;
            : set_true "think_herd_all" ;
            : collection_modify { collection = "tried_combo_core" index -> (36) content -> ("true") } ;
            : gosub "note_thinks" ;
            : done ;
         }
         : if (!point_catch_acing) {
            : print "Perhaps you could herd a bunch of cats if the one nearby were more friendly." ;
            : set_true "think_herd_all" ;
            : collection_modify { collection = "tried_combo_core" index -> (36) content -> ("true") } ;
            : set_true "think_herd_all_right_place" ;
            : gosub "note_thinks" ;
            : done ;
         }
         : print "Your cat friend perks its ears up. It runs off, meowing, looking back for you to follow. Between you and the girl, you find a lot of cats, who all let you and the girl pet them. While you don't see any reason to have a herd of cats right now, perhaps they could be handy later. They will come when you need them and be very inconvenient for someone. Until then, being cats, they'll find nice quiet secluded places. But you've won them over." ;
         : set_integer var="tempint" "36" ;
         : set_false "think_herd_all" ;
         : set_true "point_herd_all" ;
         : gosub "add_point" ;
         : done ;
      }
      # HEARD ALL for the dogs
      : match "heard all" {
         : if (point_heard_all) {
            : print "You already listened around for all the possible dogs." ;
            : done ;
         }
         : if (!is_at "r40") {
            : print "Nothing to potentially hear en masse here." ;
            : set_true "think_heard_all" ;
            : collection_modify { collection = "tried_combo_core" index -> (38) content -> ("true") } ;
            : gosub "note_thinks" ;
            : done ;
         }
         : if (!point_shape_up) {
            : print "You're not in the mood to listen that much yet." ;
            : set_true "think_heard_all" ;
            : collection_modify { collection = "tried_combo_core" index -> (38) content -> ("true") } ;
            : set_true "think_heard_all_right_place" ;
            : gosub "note_thinks" ;
            : done ;
         }
         : print "You are ready to listen around for any other dogs that might be hidden, and some turn up to be fearful and hiding, but you and the girl find them all. Your original friend is quite happy with all this and wags its tail a bit extra. This whole bunch of dogs may be useful, but not here. It's good to know you they will have your back somewhere else, later." ;
         : set_integer var="tempint" "38" ;
         : set_false "think_heard_all" ;
         : set_true "point_heard_all" ;
         : gosub "add_point" ;
         : done ;
      }
      # these half-thinks have to come after.
      : if (!point_heard_all) {
         : match "heard _;_ all" { #?? this is potentially wretched if we get ALL in R40 / R00 backwards. We should note the doll has some weird power. Maybe this will give you an idea what else to do.
            : set_integer var="tempint" "38" ;
            : set_boolean var="already_got_command" {( think_herd_all && !point_herd_all )} ;
            : set_false "first_half" ;
            : match "heard _" {
               : set_true "first_half" ;
            }
            : gosub "say_half" ;
            : done ;
         }
      }
      : if (!point_herd_all) {
         : match "herd _;_ all" {
            : set_integer var="tempint" "36" ;
            : set_boolean var="already_got_command" {( think_herd_all && !point_herd_all )} ; # this is optional. Delete if point does not rely on any other variables.
            : set_false "first_half" ;
            : match "herd _" {
               : set_true "first_half" ;
            }
            : gosub "say_half" ;
            : done ;
         }
      }
   }

   : if (is_carried("vie_neater")) {
      : match "vine eater" {
         : if (!is_at "r00" || !point_fly_traps) {
            : print {( is_at "r42" ? "The sea crest is too delicate and isn't stopping you going anywhere. That'd be a waste of the {puz_point_vie_neater}." : "You see nothing resembling vines that can be eaten. Well, not here and now. But if you ever do..." )} ;
            : set_true "think_vine_eater" ;
            : collection_modify { collection = "tried_combo_core" index -> (34) content -> ("true") } ;
            : gosub "note_thinks" ;
            : done ;
         }
         : if (point_vine_eater) {
            : print "You already got vines eaten!" ;
            : done ;
         }
         : print "Your Vie-Neater summoning brings a Vine Eater which gobbles the fly traps. It nods to you. You crumble the Vie-Neater in a ball, throw it in the Eater's mouth, then watch as the Eater ambles away.\nBehind where the flytraps were, you watch a {puz_point_cat_chasing} but doing a bad job of it." ;
         : destroy "vie_neater" ;
         : set_integer var="tempint" "34" ;
         : set_false "think_vine_eater" ;
         : set_true "point_vine_eater" ;
         : gosub "add_point" ;
         : done ;
      }
      : if (!point_vine_eater) {
         : match "vine _;_ eater" {
            : set_integer var="tempint" "34" ;
            : set_boolean var="already_got_command" {( think_vine_eater && !point_vine_eater )} ; # this is optional. Delete if point does not rely on any other variables.
            : set_false "first_half" ;
            : match "vine _" {
               : set_true "first_half" ;
            }
            : gosub "say_half" ;
            : done ;
         }
      }
   }
   : if (gamestate_fail_oops_known && !point_fey_loops) {
      : match "fey loops" {
         : set_true "gamestate_thug_pass" ;
         : if (!is_at "r04" && !is_at "r14") {
            : print "You look for fey loops that might catch the enemy, but not here. Perhaps there is not potential enough for looping here, with walls or terrain may get in the way." ;
            : set_true "think_fey_loops" ;
            : collection_modify { collection = "tried_combo_core" index -> (41) content -> ("true") } ;
            : gosub "note_thinks" ;
            : done ;
         }
         : print "You don't believe you will find any fey loops here, even if they might be somewhere. They're always the last place you look." ;
         : print {( "Because of course there's no point looking once you find them. Which you have, here. Recalling the surrounding map, this WAS the only place it could be -- the other locations ostensibly near each other were blocked by a wall, or water, or something. The loops weren't easy to find, but now you have, it's pretty clear how to go to the " + (is_at "r04" ? "{dir_n_y}" : "{dir_n_s}") + ", making the first (and only) loop in the game map." )} ;
         : if (gamestate_thug_chase) {
            : print "The thug is momentarily stunned by this development and does not take the time to thump you." ;
         }
         : set_integer var="tempint" "41" ;
         : set_false "think_fey_loops" ;
         : set_true "point_fey_loops" ;
         : gosub "add_point" ;
         : done ;
      }
      : match "fey _;_ loops" {
         : set_true "gamestate_thug_pass" ;
         : set_integer var="tempint" "41" ;
         : set_boolean var="already_got_command" {( think_fey_loops && !point_fey_loops )} ; # this is optional. Delete if point does not rely on any other variables.
         : set_false "first_half" ;
         : match "fey _" {
            : set_true "first_half" ;
         }
         : gosub "say_half" ;
         : done ;
      }
   }
   : match "xyzzy _" {
      : print "A hollow voice intones \"Our gaol: argh, ail!\" It's so spooky, you don't dare quibble over details of pronunciation." ;
      : done ;
   }
   : mask {
      : match "load -" {
         : print "You hear a low \"Do load, ooh!\"" ;
      }
      : match "restore -" {
         : print "You hear a tune. It could be called a re-load reel/ode, I guess." ;
      }
      : match "save -" {
         : print "A ghostly apparition with \"Save? Illun', Say!\" Villain written on its front taunts your very reasonable precaution. But you don't need to listen to such meanies." ;
      }
   }
   : match "i _" {
      : gosub "take_inventory" ;
      : if (!shorten_inventory) {
         : if (original "verb" == "inventory") {
            : print "{one_time}{vd_i_long} can be shortened to {vd_inv} or {vd_i} for convenience." ;
         }
         : if (original "verb" == "inv") {
            : print "{one_time}{vd_inv} can be shortened further to {vd_i} for convenience." ;
         }
         : set_true "shorten_inventory" ;
      }
      : print {( me_x_yet ? "While you're not carrying them, your tats will help give you clues if/when you need them" : "Perhaps you should inspect or EXAMINE yourself for something hidden on you." )} ;
      : done ;
   }
   : gosub "check_options" ;
   : gosub "odd_dir_note" ;
   : match "z _;wait _" {
      : print "\"Loaf, right? Lo, fright!\"" ;
      : if (!wait_yet) {
         : print "{one_time}This is just a silly general response. Waiting gives no penalty or benefit." ;
         : set_true "wait_yet" ;
      }
   }
   : match "about _" {
      : print "{this_game} was written for {ifcomp} 2026." ;
      : print "{this_game} has the same mechanic as two games I wrote in Inform 7: {l_wp} and {l_ut}. It's about their size. I have other three games in a similar vein." ;
      : print "Every point scoring command is an unusual verb, which is indicated by the location, or something in the location." ;
      : print "Some text is color-coded in meta-commands. <Green<#0f0>> is a clickable link, and <Orange<#f80>> or purple indicates a verb you can use. <Lavender<#88f>> text clues what to focus on. <Light grey<#ccc>> text indicates a name that fits the game's feel, but you don't need to tinker with it." ;
      : print "Directional text is color-coded, too. <RED<#f00>> means you need to solve a puzzle to go a certain way. <GREEN<#0f0>> means you've been that way. <YELLOW<#ff0>> means you can go that way but haven't, yet." ;
   }
   : match "credits _;credit _" {
      : print "Thanks to, in alphabetical order, {cred_aj}, {cred_de}, {cred_sh},  {cred_rh}, {cred_lp}, and {cred_mr} for testing. I was behind schedule, and they found a lot, including very good points I wasn't able to fully address in the IFComp release. Links are to itch.io -- <IFDB<#0f0>> links don't play well with the Adventuron version I'm using." ;
      : print "Thanks to {cred_ca} for creating Adventuron." ;
      : print "Thanks to IFComp administrators past and present and to reviewers and judges past and present. They give me an excuse to keep trying stuff." ;
      : if (!credits_yet) {
         : print "{one_time}Green text here links to a person's itch.io account. Also, <*CREDITS<#f80>> gives general ADVENTURON credits." ;
      }
   }
   : match "help _;hint _;hints _" {
      : if (!me_x_yet) {
         : if (score == 0) {
            : print "Before potentially spoiling the first puzzle, I'd like to note you can {xme} for a hint device that gives clues for all puzzles." ;
         } : else {
            : print "There are no specific hints now you've gotten past the first puzzle, but {xme} will give you a hint item which was meant to be intuitive. If it is not, come back here for an explanation." ;
         }
         : done ;
      } : else {
         : set_true "gamestate_thug_pass" ;
         : cycle key = "help_general" predictable_order = "true" skip_interval = "0" {
            : print "There are no in-game hints for specific puzzles, so ahead is an explanation of {xtats}, It gives a number that clues what you need to do in the current room. Before spoiling it, I'll mention that each point-scoring command the tats hint is a two-word command." ;
            : print "So it's meant to be information that doesn't require much or any additional calculation. Also note that it doesn't track whether or not you're ready to, though you can still guess, and {vd_think} will hold it for later." ;
            : print "If there is no number, there is nothing left to do. (All rooms have something to do at some point.)" ;
            : print "Swirling numbers mean come back later." ;
            : print "Each of the number's two digits matches with one word." ;
            : print {( "The tens digit is the length of the first word you need, and the ones digit is the length of the second." + (score == 0 ? " Note: game mechanic spoilers are ahead." : "") )} ;
            : print "Let's say you are at an ICE CREAM stand and you get the number 16." ;
            : print "To get the ICE CREAM, you need to type a command with a one-letter word, then a six-letter word." ;
            : print "What's more, the command needs to sound like ICE CREAM." ;
            : print "There aren't many one-letter words, so you can guess the first is I, then CREAM has a sound tacked on the start." ;
            : print "I SCREAM is thus the answer." ;
            : print "Most words should be in the three to six letter range, though there is one with nine letters and a few with eight. (The clues will now cycle.)" ;
         }
      }
      : done ;
   }
   : match "history _;version _;versions _" {
      : set_true "gamestate_thug_pass" ;
      : print "The first release of {this_game} was September 1, 2026, for {ifcomp}." ;
      : print "Maintenance releases are possible and likely, but this was good enough to release." ;
      : done ;
   }
   : match "score _" {
      : set_true "gamestate_thug_pass" ;
      : print {( "You've currently scored {score} of {max_score} total core points." + (think_any ? "You have also figured {number_as_word} point-scoring command" + ( commands_figured > 1 ? "s" : "" ) + " before you had the necessary support. Type {vd_think} for details." : "" ) )};
      : print "You also found {bonus_score} of {max_bonus_score} bonus points." ;
      : gosub "note_score_upper_right" ;
   }
   : match "listen _" {
      : set_true "gamestate_thug_pass" ;
      : gosub "listen_stub" ;
   }
   : match "map _;m _" {
      : set_true "gamestate_thug_pass" ;
      : gosub "map_stub" ;
   }
   : match "think _" {
      : set_true "gamestate_thug_pass" ;
      : set_false "think_text_yet" ;
      : if (think_any) {
         : print {( "Here " + (commands_figured > 1 ? "are {number_as_word} things that seemed like they" : "is something that seemed like it") + " should work, but you didn't have the resources yet:" )} ;
      }
      : if (think_bah_slumping) {
         : print "You tried to say <BAH SLUMPING<#f80>> to the boss lumping insults at you {here_r26} but didn't have enough support yet." ;
      }
      : if (think_broke_lass) {
         : print "You tried to summon the <BROKE LASS<#f80>> {here_r35} but the major gent was too irritating." ;
      }
      : if (think_cloth_robbing) {
         : print "You tried to go <CLOTH ROBBING<#f80>> {here_r14} but didn't have the proper tool(s)." ;
      }
      : if (think_coin_ovations) {
         : print "You tried to get <COIN OVATIONS<#f80>> from the Knowin' Juries {here_r12} but didn't have the storytelling ability yet." ;
      }
      : if (think_door_cloud) {
         : print "You tried to ask the dork, loud {here_r30} to show you a <DOOR CLOUD<#f80>> but couldn't point them to any you could open." ;
      }
      : if (think_fey_loops) {
         : print "You tried to find <FEY LOOPS<#f80>> but weren't in an area that might support them." ;
      }
      : if (think_frame_easily) {
         : print "You had ideas how to stop the fray (measly) {here_r23} from fighting, but they weren't ones you had confidence to <FRAME EASILY<#f80>> yet." ;
      }
      : if (think_free_crusty) {
         : print "You tried to get the freak, rusty {here_r22} to see themselves as <FREE CRUSTY<#f80>> but you were worried you'd say the wrong thing." ;
      }
      : if (think_heard_all) {
         : print "Your efforts to have <HEARD ALL<#f80>> fell short without enough entities to hear." ;
      }
      : if (think_herd_all) {
         : print "Your efforts to <HERD ALL<#f80>> fell short without enough entities to herd." ;
      }
      : if (think_pitch_earning) {
         : print "You tried to <PITCH EARNING<#f80>> to the titan {here_r02}, but it wasn't in a state to listen yet." ;
      }
      : if (think_ply_towels) {
         : print "You tried to <PLY TOWELS<#f80>> to the plight owls {here_r34}, but you didn't have any towels yet." ;
      }
      : if (think_right_angles) {
         : print "You discovered <RIGHT ANGLES<#f80>>, but it wasn't quite for you. Perhaps someone else could visit {here_r15} and learn more from it." ;
      }
      : if (think_say_four) {
         : print "You tried to <SAY FOUR<#f80>> {here_r10} to buy safe oars, but you didn't have the money yet." ;
      }
      : if (think_say_loaners) {
         : print "You tried to <SAY LOANERS<#f80>> {here_r33} to the sail owners, but you needed both money and equipment." ;
      }
      : if (think_tense_ops) {
         : print "You tried to sort out <TENSE OPS<#f80>> {here_r44} with the ten sops, but you didn't have the self-confidence yet." ;
      }
      : if (think_vine_eater) {
         : print "You tried to activate the <VINE EATER<#f80>>, but there was no vegetation that needed culling." ;
      }
      : if (think_warm_acres) {
         : print "You tried to make <WARM ACRES<#f80>> {here_r24}, but you didn't have the support, so the war makers stood their cold ground." ;
      }
      : gosub "diagnostic_think_core_half" ;
      : if (print_core_nag_after) {
         : print "{one_time}You have figured each half of a point-scoring command, but you haven't typed them both together. That still might not work if you haven't prepared by solving other puzzles, but if that's the case, {vd_think} will remind you with context until it does." ;
         : set_true "solved_both_parts_core_nag" ;
         : set_false "print_core_nag_after" ;
      }
      : if (print_bonus_nag_after) {
         : print "{one_time}You have figured each half of a bonus point scoring command, but you haven't typed them both together. {vd_think} will remind you of this try until it works, though game state changes may make, or have made, this undoable until you replay." ;
         : set_true "solved_both_parts_bonus_nag" ;
         : set_false "print_bonus_nag_after" ;
      }
      : if (!think_any) {
         : print "You haven't had any good ideas you weren't able to execute yet." ;
         : done ;
      }
   }
   : match "verbs _;verb _" {
      : set_true "gamestate_thug_pass" ;
      : print "To complete {this_game}, you only need the four compass directions (well, the exit from the first room is up) and special commands clued by descriptions and such. You {v_take_drop} automatically." ;
      : print "If you're not in an action sequence, you can also use a number to move to a square you've visited before. You start at <20<#f80>>, one east of it is <21<#f80>>, and north from there is <31<#f80>>. The pre-endgame map is a 5x5 grid, so its northeast corner is <44<#f80>>." ;
      : print "{v_listen} may be entertaining in places." ;
      : print "{vm_meta} gives a list of metaverbs, or in-game actions that don't affect the world. They provide information on game play." ;
      : print "{vm_diag} lists diagnostic verbs, which give information about your game status." ;
      : print "{vm_opt} lists options that change text output or restrict unneeded travel." ;
   }
   : match "opt _;opts _;options _;option _" {
      : print "There are three options in {this_game}." ;
      : print "{vo_hone_aye} blocks off exits to rooms if you've compled them and everything behind, to help focus on what to do next, while {vo_ho_nigh} lets you traverse freely." ;
      : print "{optt_ch} {yn} turns color hints on or off." ;
      : print "{optt_notify} {yn} turns score notification on or off." ;
   }
   : match "meta _" {
      : print "Meta-verbs besides, well, {vm_meta}:" ;
      : print "{vm_about} discusses the game's origin and general flow." ;
      : print "{vm_credits} gives credit to people who helped create this game or make it better." ;
      : print "{vm_versions} shows version history and release dates." ;
      : done ;
   }
   : match "diag _" {
      : set_true "gamestate_thug_pass" ;
      : print "Diagnostic verbs include {vd_i_three} to take inventory, {vd_think} to show where you've been on the right track, and {vd_score} to see your game score." ;
      : if (bonus_point_lo_maps) {
         : print "You've also unlocked the in-game {vd_map} of where you've been." ;
      } : else {
         : print {( "There's one more verb that's intended to be an easy bonus point. " + (has_visited("r11") || has_visited "r31" ? "You've seen it." : "It's in the starting area." ) )} ;
      }
      : done ;
   }
   : match "take _;drop _" {
      : set_true "gamestate_thug_pass" ;
      : print "You don't need to {v_take_drop} anything here. It's all done for you." ;
      : done ;
   }
   : match "x me;x myself" {
      : set_true "gamestate_thug_pass" ;
      : if (!me_x_yet) {
         : print "Weird. You see some numbers on your arm that seem to morph a bit. Perhaps they can help in some way. Let's call them fey stats/phase-tats." ;
         : pocket "phase_tats" ;
         : set_true "me_x_yet" ;
      } : else {
         : print "Nothing on you but the tats which can give hints." ;
      }
      : done ;
   }
   : if (me_x_yet) {
      : match "_ tats;_ fey;_ phase;_ stats" {
         : set_true "gamestate_thug_pass" ;
         : gosub "set_tats_num" ;
         : set_false "tats_blurry" ;
         : if (my_tats_num == -1) {
            : print "Numbers swirl, but nothing definitive. Maybe later?" ;
            : done ;
         }
         : if (my_tats_num < 0) {
            : set_true "tats_blurry" ;
            : set_integer var="my_tats_num" {( 0 - my_tats_num )} ;
         }
         : if (my_tats_num == 0) {
            : print {( zero_explained ? "No number. Done here." : "You see no number right now. Seems reasonable that you're done here, which is good to know." )} ;
            : set_true "zero_explained" ;
            : done ;
         }
         : print "The tats swirl and form a number: {my_tats_num}." ;
         : if (tats_blurry) {
            : print "The number's a bit blurry, though. Maybe you can't do anything right now." ;
         }
         : if (!tats_explanation_yet) {
            : print "{one_time}If you wonder what the numbers mean, you can <HINT TATS<#f80>>. They require no drastic formulas. The tats are there for guidance." ;
            : set_true "tats_explanation_yet" ;
         }
         : done ;
      }
   }

   : gosub "inventory_nouns" ;

   # comment out before release
   : gosub "testing_stuff" ;

   : gosub "gotos" ;

   : match "weight _;_ weight;_ hour;hour _" {
      : print "A hollow voice booms \"INTERESTING.\"" ;
      : done ;
   }
   : match "bah _;blest _;broke _;can _;catch _;chest _;cloth _;coin _;cue _;door _;dry _;duh _;dumb _;dump _;eh _;feel _;fell _;fey _;flow _;fly _;frame _;free _;girl _;halt _;hate _;heard _;herd _;mage _;me _;no _;pitch _;ply _;pose _;right _;say _;seek _;shape _;sun _;tense _;thief _;tightened _;troop _;tufty _;tune _;vine _;warm _;whee _;yell _" { #obfuscation of non solutions, regular points
      : print "{custom_unknown_verb_error}" ;
      : done ;
   }

   : match "wilderness _;_ wilderness" {
      : if (!bonus_point_wilderness) {
         : print "Yes, you feel like you've been in a wilderness for a while. It's been some time since people pointed that out about your name. You thought by blocking the pun out, you'd be more focused. But perhaps the right way to look at things is, if you're stuck in a mental wilderness or whatever and break out, then you'll make a big jump, and you'll have earned it, with all the thought you've put into things.\nThat's really hokey, but it's better than nothing." ;
         : set_true "bonus_point_wilderness" ;
         : gosub "add_bonus_point" ;
         : done ;
      } : else {
         : print "You have confidence you'll work your way out. The immediate and long-term wilderness." ;
         : done ;
      }
   }

   : if (!bonus_point_lo_maps && (is_at "r11" || is_at "r31")) {
      : match "lo maps;low maps" {
         : print "You search the loam apse, and you make extra sure to search low, and hey, how about that? You find some maps of ... this exact area! How curious! Everywhere you've been is filled in." ;
         : print {( has_visited "r25" ? "They're not VERY useful now, but you feel smart having gotten so far without using them." : "This'll be handy to keep track of things!" )} ;
         : print "You can use the command {vd_map} to see them at any time, or just <M<#f80>>." ;
         : set_true "bonus_point_lo_maps" ;
         : gosub "add_bonus_point" ;
         : done ;
      }
      : match "_ maps;lo _;low _" {
         : print "You feel like something interesting and useful should be behind the loam apse, but you don't know how to look, yet." ;
         : done ;
      }
   }

   : match "lo _;low _;thud _;thug _" { #obfuscation of bonus points
      : print "{custom_unknown_verb_error}" ;
      : done ;
   }

   : match "ba _;baa _;baaa _;co _;loners _;queue _;read _;sail _;sink _;sync _;we _;wee _" { #obfuscation of good guesses, regular points
      : print "{custom_unknown_verb_error}" ;
      : done ;
   }

   : match "thug _" { #obfuscation of bonus points
      : print "{custom_unknown_verb_error}" ;
      : done ;
   }

}

