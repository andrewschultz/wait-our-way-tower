game_type = verb_noun
start_at = "r20"
start_theme = my_theme

#cch.py makes sure of things

game_information {
   game_name                    = Wait-Our-Way Tower
   game_version                 = 1.0.0
   game_shortname               = WOWT
   written_by                   = Andrew Schultz
   uuid                         = b3c1f8e2-5d4a-4f9b-8c3d-2a7e5f6a9b1c
   year_of_release              = 2026
   copyright_message            = Free to distribute
   short_synopsis               = IFComp 2026 entry, in the vein of {l_wp} and {l_ut}, but in Adventuron
}

## Defines locations in the world

strings {
   # top level
   wowtc : string "<WAIT-OUR-WAY TOWER<#f80>>" ;
   this_game : string "<Wait-Our-Way Tower<#f80>>" ;
   l_ut : string "<Us Too<#0f0>>[http://andrewschultz.itch.io/us-too]" ;
   l_wp : string "<Why Pout<#0f0>>[http://andrewschultz.itch.io/why-pout]" ;
   ifcomp : string "<IFComp<#f80>>[https://ifcomp.org]" ;

   # basics
   my_score : string "{score}{plus_in_header}/{max_score}" ;
   custom_unknown_verb_error : dynamic_string {( "Nothing special happens. You can use {vm_verbs} for a general overview of standard verbs." )} ;
   exits_err : dynamic_string {(
      (is_at "r00" || is_at "r10" || is_at "r42") ? "Back east only." :
      (is_at "r01" || is_at "r33") ? "This is a T intersection, north-east-west." :
      (is_at "r02" || is_at "r04" || is_at "r14" || is_at "r27") ? "Back west only." :
      (is_at "r03" || is_at "r30") ? "The passage bends north to east." :
      is_at "r13" ? "This is a T intersection, south-east-west." :
      is_at "r15" ? "Back north only." :
      is_at "r20" ? "THE DOOR east is the only exit." :
      (is_at "r11" || is_at "r21" || is_at "r25" || is_at "r31") ? "Only the four main directions." :
      (is_at "r12" || is_at "r22" || is_at "r23" || is_at "r24" || is_at "r26" || is_at "r32") ? "The path runs east-west." :
      is_at "r34" ? "The passage bends north to west." :
      (is_at "r35" || is_at "r40" || is_at "r41" || is_at "r44") ? "Back south only." :
      is_at "r43" ? "Rowing any way other than south or west might leave you lost." :
      "Can't go that way."
      )} ;

   # parser stuff
   nospecial_custom : string "You see no specific item like that. To examine a room, <LOOK<#0f0>>. Note that the parser may not recognize adjectives as synonyms, so using a noun works best." ;
   yn_or_12_or_14 : dynamic_string {( (verb_is "save" || verb_is "load") ? "Please choose from 1 to 4." : in_number_choice ? "Please choose 1 or 2." : "Please choose YES/Y or NO/N." )}

   # noting stuff
   one_time : string "<ONE-TIME NOTE: <#f0f>>" ;
   key_enter : string "the <ENTER<#f88>>/<RETURN<#f88>> key" ;

   v_listen : string "<LISTEN<#f80>>" ;
   v_take_drop : string "<TAKE<#f80>> or <DROP<#f80>>" ;

   # diagnostic verbs
   vd_bonus : string "<BONUS<#f80>>" ;
   vd_hint : string "<HINT<#f80>>/<HINTS<#f80>>" ;
   vd_i : string "<I<#f80>>" ;
   vd_inv : string "<INV<#f80>>" ;
   vd_i_long : string "<INVENTORY<#f80>>" ;
   vd_i_three : string "{vd_i}/{vd_inv}/{vd_i_long}" ;
   vd_map : string "<MAP<#f80>>" ;
   vd_score : string "<SCORE<#f80>>" ;
   vd_think : string "<THINK<#f80>>" ;

   # meta-verbs
   vm_about : string "<ABOUT<#f80>>" ;
   vm_credits : string "<CREDITS<#f80>>" ;
   vm_diag : string "<DIAG<#f80>>" ;
   vm_meta : string "<META<#f80>>" ;
   vm_verbs : string "<VERBS<#f80>>" ;
   vm_versions : string "<VERSIONS<#f80>>" ;

   xtats : string "<X TATS<#f80>>" ;
   xme : string "<X ME<#0f0>>" ;

   # verb option strings
   # options, game specific
   vo_hone_aye : string "<HONE AYE<#ff0>>/<HONE EYE<#ff0>>" ;
   vo_ho_nigh : string "<HO NIGH<#ff0>>" ;

   optt_ch : string "<CH<#88f>> or <COLORHINT<#88f>>" ;
   optt_notify : string "<NOTIFY<#88f>>" ;
   yn : string "<YES<#f88>>/<Y<#f88>> or <NO<#f88>>/<N<#f88>>" ;

   # links for credits
   cred_aj : string "<Andrew Apted<#0f0>>[https://andrewj.itch.io]" ;
