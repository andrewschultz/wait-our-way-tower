   r41 : location "{r41_loc}" header="{r41_header}" {
      on_command {
         : if (!point_eh_sink) {
            : match "_ ace;_ inc" {
               : print "Ugh! It's so dreary to look at. It's a monolith of automation. You doubt any technology can stop it. What could?" ;
               : done ;
            }
            : match "* sync;sync _" {
               : print "You might want to get {puz_point_ace_inc} out of sync. Sounds right, though." ;
               : done ;
            }
         } : else_if (!point_cue_bland) {
            : match "_ cube;_ land" {
               : print "The cubes are all so garish. You wonder why they need to be, what is inside or behind them, where and how to look for it." ;
               : done ;
            }
         }
         : match "eh sink" {
            : if (point_eh_sink) {
               : print "{puz_point_ace_inc} already sank!" ;
               : done ;
            }
            : print "Ace, Inc. slowly sinks. You hope the message about no humans being there is true. You hear no screams or confusions, just robots whirring and glitching." ;
            : print "What is revealed is a garish {puz_point_cube_land}." ;
            : set_integer var="tempint" "26" ;
            : set_true "point_eh_sink" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_eh_sink) {
            : match "sink _" {
               : print "Right idea, but a giant sink might be impassable. Or it might drown you. And {puz_point_ace_inc} couldn't be changed to a SMALL sink." ;
               : done ;
            }
            : match "eh _;_ sink" {
               : set_integer var="tempint" "26" ;
               : set_false "first_half" ;
               : match "eh _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
