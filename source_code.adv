   # blocking strings
   blockstr_go_fwd : string "You're done in the back areas. Time to go forward." ;
   blockstr_endgame_npcs : dynamic_string {( "You got two companions. They " + (point_bah_slumping ? "helped" : "will help") + " enough." )} ;
   block_04_14 : string "Weird! It almost feels like there should be passage that way. You can't say why, but it's disorienting even to plan out a route. For now." ;
   block_dull_oozing  : string "Ehh ... the {puz_point_dull_oozing} slows you down. Trekking further is probably harmless, but what if it isn't? You'd feel dumb getting poisoned by the physical ooze." ;
   block_hey_trash    : string "The call of {puz_point_hey_trash} freezes you. You half want to show them, whomever they are, and whatever you want to show. You'll decide that later. Also, you worry if you go farther, there'll be more people like that, which could put you in danger. So, for now, no." ;
   block_pose_teasing : string "The Bros wonder why you need to be running around like this. You need to chillax! Life will be easier that way. And no offense, but if you do have an exciting life, it's a bit unfair. They deserve it a bit more than you do. So you shouldn't rub it in by just walking past them like that." ;
   block_trrg         : string "The {trtg} won't let you explore anywhere new. Thug life, man!" ;
   block_weep_lucky   : string "The bros weep about how YOU get all the adventure here. You've been through this before, but since you last visited, you do sort of have to admit you've had a lot of adventures. You feel bad for them. They feel like they're the lovable underdogs here, that they should get a chance, but noooooo." ;

   # THINK string(s)
   for_bonus : dynamic_string {( half_bonus ? " for a bonus point" : "" )} ;

   # direction strings
   dir_n_v : string "<NORTH<#0f0>>" ;
   dir_s_v : string "<SOUTH<#0f0>>" ;
   dir_e_v : string "<EAST<#0f0>>" ;
   dir_w_v : string "<WEST<#0f0>>" ;

   dir_n_y : string "<NORTH<#ff0>>" ;
   dir_s_y : string "<SOUTH<#ff0>>" ;
   dir_e_y : string "<EAST<#ff0>>" ;
   dir_w_y : string "<WEST<#ff0>>" ;

   dir_n_n : string "<NORTH<#f00>>" ;
   dir_s_n : string "<SOUTH<#f00>>" ;
   dir_e_n : string "<EAST<#f00>>" ;
   dir_w_n : string "<WEST<#f00>>" ;

   # conditional location strings
   here_r00 : dynamic_string {( is_at "r00" ? "here" : "in the southwest corner" )} ;
   here_r01 : dynamic_string {( is_at "r01" ? "here" : "by the dump, arable" )} ;
   here_r02 : dynamic_string {( is_at "r02" ? "here" : "in the Pit, Churning" )} ;
   here_r03 : dynamic_string {( is_at "r03" ? "here" : "by the sunk etching" )} ;
   here_r04 : dynamic_string {( is_at "r04" ? "here" : "by the meager oath" )} ;
   here_r10 : dynamic_string {( is_at "r10" ? "here" : point_dry_vendors ? "by the Dry Vendors" : "in Drive Enders" )} ;
   here_r11 : dynamic_string {( is_at "r11" ? "here" : "by the meager oath" )} ;
   here_r12 : dynamic_string {( is_at "r12" ? "here" : "by the Knowin' Juries" )} ;
   here_r13 : dynamic_string {( is_at "r13" ? "here" : "by Post, Easing" )} ;
   here_r14 : dynamic_string {( is_at "r14" ? "here" : "by the claw, throbbing" )} ;
   here_r15 : dynamic_string {( is_at "r15" ? "here" : "by {r15_header}" )} ;
   here_r20 : dynamic_string {( is_at "r20" ? "here" : "where you started" )} ;
   here_r21 : dynamic_string {( is_at "r21" ? "here" : "by the Dread Jailing" )} ;
   here_r22 : dynamic_string {( is_at "r22" ? "here" : "in the Field, Erring" )} ;
   here_r23 : dynamic_string {( is_at "r23" ? "here" : "by the Fray, Merging" )} ;
   here_r24 : dynamic_string {( is_at "r24" ? "here" : "by the War Makers" )} ;
   here_r25 : dynamic_string {( is_at "r25" ? "here" : "by The Groom-Thug Room" )} ;
   here_r26 : dynamic_string {( is_at "r26" ? "here" : "in {r26_header}" )} ;
   here_r27 : dynamic_string {( is_at "r27" ? "here" : "by {r27_header}" )} ;
   here_r30 : dynamic_string {( is_at "r30" ? "here" : "in the {r30_header}" )} ;
   here_r31 : dynamic_string {( is_at "r31" ? "here" : "in the Way-Bland Wabe Land" )} ;
   here_r32 : dynamic_string {( is_at "r32" ? "here" : "in Chess Training" )} ;
   here_r33 : dynamic_string {( is_at "r33" ? "here" : "by the sail owners" )} ;
   here_r34 : dynamic_string {( is_at "r34" ? "here" : "by The Soak-Thus Oak" )} ;
   here_r35 : dynamic_string {( is_at "r35" ? "here" : "by the Bro Class" )} ;
   here_r40 : dynamic_string {( is_at "r40" ? "here" : "by Chez Pup" )} ;
   here_r41 : dynamic_string {( is_at "r41" ? "here" : "by {r41_header}" )} ;
   here_r42 : dynamic_string {( is_at "r42" ? "here" : "in Gray Vile Grave Isle" )} ;
   here_r43 : dynamic_string {( is_at "r43" ? "here" : "in the Float, Rippling" )} ;
   here_r44 : dynamic_string {( is_at "r44" ? "here" : "by the ten sops" )} ;
   maybe_r00 : dynamic_string {( !think_herd_all_right_place ? "somewhere with lots to track" : here_r00 )} ; # ?? ugh! I'd like to say HERD if we know the half-text but this is fiddly
   maybe_r40 : dynamic_string {( !think_heard_all_right_place ? "somewhere with lots to track" : here_r40 )} ;

   # room(s)
   r00_loc : dynamic_string {( (point_warm_acres ? "The cat is no longer here. Maybe they found a forever home in the Warm Acres chaos." :
      point_catch_acing ? "There's a cat chasing here, mostly fallen leaves and stuff, but it's more coordinated now you helped it." :
      point_vine_eater ? "With the fly traps removed, there's a {puz_point_cat_chasing} here. It's not chasing stuff very well, though." :
      point_fly_traps ? "Long winding fly traps, densely packed together, twist around here. They probably won't swallow you up, but they might be blocking something, too. Perhaps you could cut through them somehow." :
      "{puz_point_flight_wraps_u} cover the area here. What are {puz_point_flight_wraps}? Well, they just prevent people, or their ideas, from taking flight.") + "\nYou can go back {dir_e_v}."
   )} ;
   r00_header : dynamic_string {( point_fly_traps ? "Fly Traps" : "Flight Wraps" )} ;

   r01_dir_e : dynamic_string {( has_visited "r02" ? dir_e_v : dir_e_y )} ;
   r01_dir_w : dynamic_string {( has_visited "r00" ? dir_w_v : dir_w_y )} ;
   r01_loc : dynamic_string {( (point_dumb_parable ? "You've gotten something out of the dump (arable,) and since there isn't much left, it's probably best just to find" : "This is, well, a {puz_point_dump_arable}. Is it really just a connecting passage, or is there more to it? At any rate, not much is here, yet, which is kind of nice, since nothing blocks") + " passage {dir_n_v}, {r01_dir_e}, or {r01_dir_w}." )} ;
   r01_header : string "Dump, Arable" ;

   r02_loc : dynamic_string {( point_pitch_earning ? "The pit still churns, but the titan is gone. You see nothing else to do here but go back west." : ((point_tightened_rousing ? "The titan is now awake. It's looking for something to do. Maybe you can help it." : "You see a {puz_point_titan_drowsing} here, in the less-churning part of the pit.") + "\nThe {puz_point_pit_churning} rises high in all directions except back {dir_w_v}." ) )} ;
   r02_header : string "Pit, Churning" ; # the spit-thus pit

   r03_dir_e : dynamic_string {( has_visited "r04" ? dir_e_v : dir_e_y )} ;
   r03_loc : dynamic_string {( "The trail runs {dir_n_v} to {r03_dir_e} here. " + (point_tufty_key ? "The tough tiki has disappeared." : point_sun_catching ? "\nThe sun caught a {puz_point_tough_tiki}." : "\nYou see a {puz_point_sunk_etching} or two scattered around here. Maybe they're hiding something." ) )} ;
   r03_header : string "Sunk Etching" ;

   r04_loc : dynamic_string {( "A {puz_point_meager_oath} reverberates through here in this open ground. Its words are not important. " + (point_me_growth ? "You've gotten its essence." : "Perhaps you can get what you need to from it." ) + "\nPassage leads back {dir_w_v}" + (point_fey_loops ? " and, as part of the fey loops, {dir_n_v}." : ".") )} ;
   r04_header : string "Meager Oath" ;

   r10_loc : dynamic_string {( point_say_four ? "Since you bought oars, nothing here is interesting." : (point_dry_vendors ? "Dry vendors have parked themselves here. A {puz_point_safe_oar} rests behind them." : "You haven't seen any cars or bikes or whatever around, so it's weird this small selection of dead ends should be called {puz_point_drive_enders}, but it is.") + "\nPassage leads back {dir_e_v}." )} ;
   r10_header : dynamic_string {( point_dry_vendors ? "Dry Vendors" : "Drive Enders" )} ;

   r11_dir_s : dynamic_string {( has_visited "r01" ? dir_s_v : dir_s_y )} ;
   r11_dir_e : dynamic_string {( has_visited "r12" ? dir_e_v : dir_e_y )} ;
   r11_dir_w : dynamic_string {( has_visited "r10" ? dir_w_v : dir_w_y )} ;
   r11_loc : dynamic_string {( point_duh_losing ? "Now the dull oozing has died down, you can explore {r11_dir_s}, {r11_dir_e}, and {r11_dir_w}. Or go back {dir_n_v} through the tower." : "Here {puz_point_dull_oozing}, physical and audible, surrounds you. \"Ehh, why bother?\" you think. It's dangerous out there to the {dir_w_n}, {dir_e_n}, and {dir_s_n}! Maybe as dangerous as sitting around in the tower back north until someone sees you tried to escape!" )} ;
   r11_header : string "Note 'Eres No Tears" ;

   r12_dir_e : dynamic_string {( has_visited "r13" ? dir_e_v : dir_e_y )} ;
   r12_loc : dynamic_string {( point_coin_ovations ? "The juries are done with you. They care not how many times you amble back west or east, nor for the purpose." :
      point_no_injuries ? "The juries continue their {puz_point_coy_novations}, no longer concerned if you might try to go {r12_dir_e}, or just go back {dir_w_v}." : "Here, {puz_point_knowin_juries} gaze intently at you, mumbling ... well, whatever it is, it seems impressive. It's an {dir_e_n}-{dir_w_v} passage here, but they seem to cock their heads to indicate you'd best go back {dir_w_v}, as-is." )}  ;
   r12_header : string "Knowin' Juries" ;

   r13_dir_e : dynamic_string {( gamestate_bros_blocking ? dir_e_n : has_visited "r14" ? dir_e_v : dir_e_y )} ;
   r13_dir_s : dynamic_string {( gamestate_bros_blocking ? dir_s_n : has_visited "r03" ? dir_s_v : dir_s_y )} ;
   r13_loc : dynamic_string {( (!point_pose_teasing ? "Here, {gbgr} chatter about any old thing, blocking the way forward for people with stuff to do. Yet they seem unimportant, compared to the place they're in." :
      !gamestate_bros_second_placed ? "The {gbgr} are gone, for now." :
      !point_whee_plucky ? "The {gbgr} are at it again, asking if you really need to show off the opportunities you've been given, right in front of their faces. They {puz_point_weep_lucky} a lot." :
      "The {gbgr} are gone for good.") + "\nThe way back is {dir_w_v}, but paths branch {r13_dir_e} and {r13_dir_s}, too."
   )} ;
   r13_header : string "{puz_point_post_easing}" ;

   r14_loc : dynamic_string {( (!point_cloth_robbing && think_cloth_robbing ? "The {puz_point_claw_throbbing} still protects the cloth you'd like to rob." :
   !point_cloth_robbing ? "A {puz_point_claw_throbbing} guards -- well, something under it. It moves back and forth quickly. How to be quick enough to grab whatever is under?" :
   "The claw, throbbing, continues to pulse, even though you got what you needed from it.") + "\nYou can go back {dir_w_v}." + (point_fey_loops ? " And there's a shortcut {dir_s_v} via the fey loops as well." : "")
   )} ;
   r14_header : string "Claw, Throbbing" ;

   r15_loc : string "Wow, so many books to read! You're interested, but sadly, you don't have the time to read that sort of text at the moment.\nIn this library you can only leave back to the {dir_n_v}. Two books are laid out here. One iscalled {puz_point_wry_tangles} and another called THE GAMES." ;
   r15_header : string "Lie-Bury Libe, Airy" ;

   r20_dir_e : dynamic_string {( has_visited "r21" ? dir_e_v : dir_e_y )} ;
   r20_loc : dynamic_string {( point_yell_open ? "The door to the {r20_dir_e} is open now, so you don't need to spend much longer in here." : ( "Here you have enough space to, well, wheeze and pace in worry about your predicament, and how the door to the {dir_e_n} blocks you. " + (!point_can_do ? "Currently, as you wheeze and pace, you find yourself repeating \"{puz_point_canned_ooh}.\" Kind of odd, since you haven't been fired, but you have lost your freedom." : !point_thief_lore ? "As you wheeze and pace, you find you're gazing a lot at {puz_point_the_floor}." : "Now that you have your {puz_point_yellow_pin}, you feel like you have something to use on the door. But how?" ) ) )} ;
   r20_header : string "Wheeze/Pace Wee Space" ;

   r21_n : dynamic_string {( has_visited "r31" ? "<NORTH<#0f0>>" : point_halt_error ? "<NORTH<#ff0>>" : "<NORTH<#f00>>" )} ;
   r21_s : dynamic_string {( has_visited "r11" ? "<SOUTH<#0f0>>" : point_halt_error ? "<SOUTH<#ff0>>" : "<SOUTH<#f00>>" )} ;
   r21_e : dynamic_string {( has_visited "r22" ? "<EAST<#0f0>>" : point_fell_asleep ? "<EAST<#ff0>>" : gamestate_r21_e ? "<EAST<#f00>>" : "<EAST<#f80>>" )} ;
   r21_loc : dynamic_string {( "The hall leads {r21_n} and {r21_s}, with a darker passage {r21_e}. " + (!point_halt_error ? "A {puz_point_hall_terror}, though, wraps itself around to cover those three exits." : (r22_secondary_block ? "You would go east, except you can't let those {puz_point_fellas_leap_l} on you." : point_fell_asleep ? "No fellas will leap you if you try to go east now." : "" )) + "\nYou could go back {dir_w_v} to your cell, too, but that's no fun." )} ;
   r21_header : string "Dredge-Ailing/Dread Jailing" ;

   r22_dir_e : dynamic_string {( !point_free_crusty ? dir_e_n : has_visited "r23" ? dir_e_v : dir_e_y )} ;
   r22_loc : dynamic_string {( "You " + (point_feel_daring ? "no longer feel uneasy in this field, erring." : "can't shake uneasy emotions in this {puz_point_field_erring}. So many ways to go wrong.") + (!point_free_crusty ? "\nA {puz_point_freak_rusty} watches you." : "") + "\nThe field runs {r22_dir_e}-{dir_w_v}." )} ;
   r22_header : string "Field, Erring" ;

   r23_dir_e : dynamic_string {( has_visited "r24" ? dir_e_v : dir_e_y )} ;
   r23_loc : dynamic_string {( point_frame_easily ? "The fray has died down, and you can just go {r23_dir_e}-{dir_w_v} here." : "A {puz_point_fray_measly} blocks the way to the {dir_e_n}. It's not very big, yet. But it won't stay that way forever. And it's not preventing you going back {dir_w_v}." )} ;
   r23_header : string "Fray, Measly" ;

   r24_dir_e : dynamic_string {( has_visited "r25" ? dir_e_v : dir_e_y )} ;
   r24_loc : dynamic_string {( point_warm_acres ? "The warm acres are just an {r24_dir_e}-{dir_w_v} passageway now." : "Here, {puz_point_war_makers} to the {dir_e_n} plot far worse things, but as with the fray to the {dir_w_v}, nothing's started yet. Nobody wants to be the same to start it. You sense words won't help here." )} ;
   r24_header : string "War Makers" ;

   r25_dir_n : dynamic_string {( !gamestate_thug_gone ? dir_n_n : has_visited "r35" ? dir_n_v : dir_n_y )} ;
   r25_dir_s : dynamic_string {( !gamestate_thug_gone ? dir_s_n : has_visited "r15" ? dir_s_v : dir_s_y )} ;
   r25_dir_e : dynamic_string {( !gamestate_thug_gone ? dir_e_n : has_visited "r26" ? dir_e_v : dir_e_y )} ;
   r25_loc : string "You can see passage {r25_dir_n}, {r25_dir_e}, and {r25_dir_s}. Back {dir_w_v}--well, you're not sure how much is left there." ;
   r25_header : string "The Groom-Thug Room" ;

   r26_dir_e : dynamic_string {( has_visited "r27" ? dir_e_v : dir_e_y )} ;
   r26_loc : dynamic_string {( !point_bah_slumping ? "Well this is pretty miserable. A {puz_point_boss_lumping} abuse on you, blocks the way to the {dir_e_n}.\nAnd with such sophistry! Such common sense! Did you come here so far for nothing?\nYou can go back {dir_w_v}, if you want." : !point_say_mentoring ? "A door labeled {puz_point_same_entering} is to the {dir_e_n}. There's always one more thing!" : "Well, you've achieved no great power. But you've figured the mystery of the Same-Entering door, so you can go {r26_dir_e} as well as {dir_w_v} now." )} ;
   r26_header : dynamic_string {( point_bah_slumping ? "\"Thaw, Tried Thought-Ride\"" : "\"Know Power? NOPE\" Hour" )} ;

   r27_loc : dynamic_string {( (point_blest_able ? "You feel good here. Yet there's still more. You hear and feel {puz_point_true_pleading}, not i-have-to-have, but interest in seeing and doing and offering more.\nSo you still feel restless. Perhaps you need to get the right phrase to say, one more time, to close the book." : "This stable here is pretty bleah. Is it really what the boss was guarding? At least it's well, stable. {puz_point_bleah_stable} ... do you deserve more in life? You guess you do, but you know you're biased.") + "\nWhile this feels like your journey's end, nothing's stopping you going back {dir_w_v}." )} ;
   r27_header : string "Bleah Stable" ;

   r30_dir_n : dynamic_string {( has_visited "r40" ? dir_n_v : dir_n_y )}
   r30_loc : dynamic_string {( ( point_door_cloud ? "You opened a door in a door-cloud leading {r30_dir_n}." : "A {puz_point_dork_loud} stands here, going on about how they'd LIKE to let people see great stuff to the {dir_n_n}, but people just AREN'T organized." ) + "\nYou can go back {dir_e_v}, too." )} ;
   r30_header : string "Way-Bland Wabe Land" ;

   r31_dir_n : dynamic_string {( has_visited "r41" ? dir_n_v : point_hate_rash ? dir_n_y : dir_n_n )} ;
   r31_dir_w : dynamic_string {( has_visited "r30" ? dir_w_v : point_hate_rash ? dir_w_y : dir_w_n )} ;
   r31_dir_e : dynamic_string {( has_visited "r32" ? dir_e_v : point_hate_rash ? dir_e_y : dir_e_n )} ;
   r31_loc : dynamic_string {( ( point_hate_rash ? "The yelling is gone now, but even if it came back, you're pretty sure you could zone it out." : "This place would be kind of unappetizing without the constant echo of {puz_point_hey_trash}.") + "\nPassages branch out {r31_dir_n}, {r31_dir_e}, {r31_dir_w} and back {dir_s_v}." )} ;
   r31_header : string "Way-Still Waste, Ill" ;

   r32_e_w : dynamic_string {( (has_visited "r33" ? dir_e_v : point_dump_liars ? dir_e_y : dir_e_n) + "-{dir_w_v}" )} ;
   r32_loc : dynamic_string {( (point_chest_reigning ? "A big majestic chest lies here in this {r32_e_w} thoroughfare." + (point_dump_liars ? " The chest is empty now." : " Also, some {puz_point_dumb_pliers} are in the chest. You were discouraged from taking them.") : "Here in this {r32_e_w} thoroughfare all sorts of weird entities train at chess. They have all sorts of opinions to {v_listen} to, if you want. Because what could possibly be more important or rewarding than chess? It's the game of royalty, you know!")  )} ;
   r32_header : string "Chess Training" ; # ?? the spit thus pit

   r33_dir_n : dynamic_string {( has_visited "r43" ? dir_n_v : dir_n_n )} ;
   r33_dir_e : dynamic_string {( has_visited "r34" ? dir_e_v : dir_e_y )} ;
   r33_loc : dynamic_string {( (point_say_loaners ? "Your Mo'-Tried Moat Ride can take you {r33_dir_n}." : "You'll need a craft to traverse Aw-Flake-Off Lake {dir_n_n}.") + " However, you can definitely go {r33_dir_e} or back {dir_w_v}." )} ;
   r33_header : string "Sail Owners" ;

   r34_dir_n : dynamic_string {( has_visited "r44" ? dir_n_v : dir_n_y )} ;
   r34_loc : dynamic_string {( ( point_ply_towels ? "THE SOAK-THUS OAK sits and pouts, its fun ruined. The owls have left, leaving passage {r34_dir_n}." : "Somehow, a tree is summoning rain down on owls hiding at the entry to a building to the {dir_n_n}. One look at it and you know it is THE SOAK-THUS OAK, and given how wet and unhappy the owls look, they must be {puz_point_plight_owls}." ) + "\nThere is also passage back {dir_w_v}." )} ;
   r34_header : string "The Soak-Thus Oak" ;

   r35_loc : string "Here, people are apparently learn stuff. What stuff, you're not sure. You can only go back {dir_s_v} here." ;
   r35_header : string "Bro Class" ;

   r40_loc : dynamic_string {( "This is a small hut that smells (pleasantly) of canines. " + (point_warm_acres ? "But since you transformed the warm acres, a lot of them found homes." : point_shape_up ? "An old dog that hasn't been a pup for a while pads around here, making you say {dgda}." : "But you don't see any. Perhaps you're giving off bad vibes. How to fix that?") + "\nThe exit is back {dir_s_v}." )} ;
   r40_header : string "Chez Pup" ;

   r41_loc : dynamic_string {( (!point_eh_sink ? "{puz_point_ace_inc} rises above you on all sides except to the {dir_s_v}. You've heard of it. It's one of those soulless corporations that may or may not have already hired all machines." :
      !point_cue_bland ? "This {puz_point_cube_land} gives off unnecessarily dazzling colors. Perhaps there's something among them, but where?" :
      "You've found your way through the cube land. Not much else can be here.") +
      "\nThe only way out is back {dir_s_v}."
   )} ;
   r41_header : dynamic_string {( point_eh_sink ? "Cube Land" : "Ace, Inc." )} ;

   r42_loc : dynamic_string {( (point_girl_only ? "The island seems cheerier now you found the girl behind the sea crest. Maybe that's just because you got some companionship. There can't be much else to do here." : point_seek_rest ? "Amidst the sea crest, you hear an odd voice saying {puz_point_grr_lonely}" : "There's a lot of {puz_point_seacrest} covering this otherwise drab and forbidding isle.") + "\nYou can sail back {dir_e_v} at any time." )} ;
   r42_header : string "Gray Vile Grave Isle" ;

   r43_dir_w : dynamic_string {( has_visited "r42" ? dir_w_v : point_flow_tripling ? dir_w_y : dir_w_n )} ;
   r43_loc : dynamic_string {( "Here on your {mtmr} you see land to the {r43_dir_w} and {dir_s_v}.\n" + (point_flow_tripling ? "The flow's picked up, and there are fewer boats around now, so passage west is viable." : "Here you just sort of {puz_point_float_rippling} with a bunch of other boats lined up so it'll be hard to row around them.") )} ;
   r43_header : string "Aww-Flake-Off Lake" ;

   r44_loc : dynamic_string {( "In this small building, " + (point_tense_ops ? "the {puz_point_ten_sops} have taken a break from planning for now." : "{puz_point_ten_sops} mill around here, discussing plans that don't have much chance of coming off as-is.") + "\nThe only way out of this small building is {dir_s_v}." )} ;
   r44_header : string "Ten Sops" ;

   hall_terror_blocks : string "Not with the {puz_point_hall_terror} in the way." ;

   # flavor text
   endgame_friends : dynamic_string {( point_broke_lass ? "Your two friends" : "The mage, urgent" )} ;
   endgame_plural : dynamic_string {( point_broke_lass ? "" : "s" )} ;

   # item(s)
   i_fspt : string "<Fey Stats Phase Tats<#ccc>>" ;

   # NPC(s)
   trtg : string "<Thug 'Round the Ground<#ccc>>" ;
   trtg_status : string "The thug is bigger than you but looks out of shape. Their endurance for running can't be that good." ;
   dgda : string "<D'aww! Gold Dog, Old<#ccc>>" ;

   # weird strings
   gbgr : string "<\"Gah, Bros, Gab\" Rows<#ccc>>" ;
   mtmr : string "<Mo' Tried Moat Ride<#ccc>>" ;
   iaad : string "<\"I'd Agree, Aye\" degree<#ccc>>" ;

   # think text and interpretive stuff
   already_got_check : dynamic_string {( already_got_command ? " Though you already got the full command, which you can revisit with {vd_think}." : "" )} ;
   noguess : string "<(unknown)<#888>>" ;
   noguess_c_1 : dynamic_string {( unneeded_half ? "<(unneeded)<#888>>" : "<(unknown)<#888>>" )} ;
   think_here_also : dynamic_string {( think_text_yet ? "Also, here" : "Here" )} ;
   number_as_word : dynamic_string {( collection_get { collection -> ("num_to_word") index -> ( commands_figured ) } )} ;
   plus_in_header : dynamic_string {( think_any ? "+{commands_figured}" : "" )} ;
   first_or_second : dynamic_string {( first_half ? "first" : "second" )} ;

   #auxiliary for options/GOTO
   tempopt : string "" ;
   txt_on_off : dynamic_string {( opt_on_off ? "<ON<#f0f>>" : "<OFF<#f0f>>" )} ;
   roomto : string "r20" ;

   tempstr  : string "" ;
   temproom : string "" ;
   lastroom : string "" ;

}

integers {
   score : integer "0" ;
   max_score : integer "50" ;
   bonus_score : integer "0" ;
   max_bonus_score : integer "0" ;

   herd_score : dynamic_integer {( (point_herd_all ? 1 : 0) + (point_heard_all ? 1 : 0) )} ;

   tats_bottom : dynamic_integer {(
      is_at "r00" ? r00_hintnum :
      is_at "r01" ? r01_hintnum :
      is_at "r02" ? r02_hintnum :
      is_at "r03" ? r03_hintnum :
      is_at "r04" ? r04_hintnum :
      is_at "r10" ? r10_hintnum :
      is_at "r11" ? r11_hintnum :
      is_at "r12" ? r12_hintnum :
      is_at "r13" ? r13_hintnum :
      is_at "r14" ? r14_hintnum :
      0
   )} ;
   tats_middle : dynamic_integer {(
      is_at "r20" ? r20_hintnum :
      is_at "r21" ? r21_hintnum :
      is_at "r22" ? r22_hintnum :
      is_at "r23" ? r23_hintnum :
      is_at "r24" ? r24_hintnum :
      0
   )} ;
   tats_top : dynamic_integer {(
      is_at "r30" ? r30_hintnum :
      is_at "r31" ? r31_hintnum :
      is_at "r32" ? r32_hintnum :
      is_at "r33" ? r33_hintnum :
      is_at "r34" ? r34_hintnum :
      is_at "r40" ? r40_hintnum :
      is_at "r41" ? r41_hintnum :
      is_at "r42" ? r42_hintnum :
      is_at "r43" ? r43_hintnum :
      is_at "r44" ? r44_hintnum :
      0
   )} ;
   tats_end : dynamic_integer {(
      is_at "r25" ? r25_hintnum :
      is_at "r26" ? r26_hintnum :
      is_at "r27" ? r27_hintnum :
      is_at "r15" ? r15_hintnum :
      is_at "r35" ? r35_hintnum :
      0 )} ;
   my_tats_num : integer "0" ;
   r00_hintnum : dynamic_integer {( !point_fly_traps ? 35 :
      !point_vine_eater ? (point_cue_bland ? 45 : -45 ) :
      !point_catch_acing ? 55 :
      !point_girl_only ? -1 :
      !point_herd_all ? 43 :
      0 )} ;
   r01_hintnum : dynamic_integer {( !point_dumb_parable ? 47 :
      0 )} ;
   r02_hintnum : dynamic_integer {( !point_tightened_rousing ? 97 :
      !point_pitch_earning ?
      (point_coin_ovations ? 57 : -57) :
      0 )} ;
   r03_hintnum : dynamic_integer {( !point_sun_catching ? 38 :
      !point_tufty_key ? 53 :
      0 )} ;
   r04_hintnum : dynamic_integer {( !point_me_growth ? 26 :
      0 )} ; #?? this is inaccurate but we dont want to spoil things, -1? # fey loops also a problem, can we say -1/swirl not there?
   r10_hintnum : dynamic_integer {( !point_dry_vendors ? 37 :
      !point_say_four ?
      (point_pitch_earning ? 34 : -34) :
      0 )} ;
   r11_hintnum : dynamic_integer {( !point_duh_losing ? 36 :
      0 )} ;
   r12_hintnum : dynamic_integer {( !point_no_injuries ? 28 :
      !point_coin_ovations ? 48 :
      0 )} ;
   r13_hintnum : dynamic_integer {( !point_pose_teasing ? 47 :
      !point_whee_plucky && gameflag_note_pals_stay_end ? 46 :
      0 )} ;
   r14_hintnum : dynamic_integer {( !point_dump_liars ? -57 :
      !point_cloth_robbing ? 57 :
      0 )} ;
   r20_hintnum : dynamic_integer {( !point_can_do ? 32 :
      !point_thief_lore ? 54 :
      !point_yell_open ? 44 :
      0 )} ;
   r21_hintnum : dynamic_integer {( !point_halt_error ? 45 : !point_fell_asleep ? (gamestate_r21_e ? 46 : -1) :
      0 )} ;
   r22_hintnum : dynamic_integer {( !point_feel_daring ? 46 :
      !point_free_crusty ? 46 :
      0 )} ;
   r23_hintnum : dynamic_integer {( !point_tense_ops ? -56 :
      !point_frame_easily ? 56:
      0 )} ;
   r24_hintnum : dynamic_integer {( point_warm_acres ? 0 :
      (point_heard_all && point_herd_all) ? 45 :
      -45 )} ;
   r30_hintnum : dynamic_integer {( !point_door_cloud ? (point_tufty_key ? 45 : -45) :
      0 )} ;
   r31_hintnum : dynamic_integer {( !point_hate_rash ? 44 :
      0 )} ;
   r32_hintnum : dynamic_integer {( !point_chest_reigning ? 58 :
      !point_dump_liars ? 45 :
      0 )} ;
   r33_hintnum : dynamic_integer {( !point_say_four ? -37 :
      !point_say_loaners ? 37 :
      0 )} ;
   r34_hintnum : dynamic_integer {( !point_cloth_robbing ? -36 :
      !point_ply_towels ? 36 :
      0 )} ;
   r40_hintnum : dynamic_integer {( !point_shape_up ? 52 :
      !point_girl_only ? -1 :
      !point_heard_all ? 53 :
      0 )} ;
   r41_hintnum : dynamic_integer {( !point_eh_sink ? 24 :
      !point_cue_bland ? 35 :
      0 )} ;
   r42_hintnum : dynamic_integer {( !point_seek_rest ? 35 :
      !point_girl_only ? 44 :
      0 )} ;
   r43_hintnum : dynamic_integer {( !point_flow_tripling ? 48 :
      0 )} ;
   r44_hintnum : dynamic_integer {( !point_me_growth ? -53 :
      !point_tense_ops ? 53 :
      0 )} ;

   # endgame stuff
   r25_hintnum : dynamic_integer {( !gamestate_tried_beyond_r25 ? -1 : (!point_tune_out ? 43 : 0) )} ;
   r26_hintnum : dynamic_integer {( !point_broke_lass ? -37 :
      !point_bah_slumping ? 37 :
      !point_say_mentoring ? 39 :
      0 )} ; #?? remember could be negative
   r27_hintnum : dynamic_integer {( !point_blest_able ? 54 :
      !point_troop_leading ? 37 :
      0 )} ;
   r15_hintnum : dynamic_integer {( !point_mage_urgent ? -56 :
      !point_right_angles ? 56 :
      0 )} ;
   r35_hintnum : dynamic_integer {( !point_mage_urgent ? 46 :
      !point_right_angles ? -54 :
      !point_broke_lass ? 54 :
      0 )} ;

# auxiliary
   tempint : integer "0" ;
   counter : integer "0" ;
   commands_figured : dynamic_integer {(
      ( think_bah_slumping ? 1 : 0) +
      ( think_broke_lass ? 1 : 0) +
      ( think_cloth_robbing ? 1 : 0) +
      ( think_coin_ovations ? 1 : 0) +
      ( think_door_cloud ? 1 : 0) +
      ( think_fey_loops ? 1 : 0) +
      ( think_frame_easily ? 1 : 0) +
      ( think_free_crusty ? 1 : 0) +
      ( think_heard_all ? 1 : 0) +
      ( think_herd_all ? 1 : 0) +
      ( think_pitch_earning ? 1 : 0) +
      ( think_ply_towels ? 1 : 0) +
      ( think_right_angles ? 1 : 0) +
      ( think_say_four ? 1 : 0) +
      ( think_say_loaners ? 1 : 0) +
      ( think_tense_ops ? 1 : 0) +
      ( think_vine_eater ? 1 : 0) +
      ( think_warm_acres ? 1 : 0)
      )} ;
   # for half THINK
   part_core_score : dynamic_integer {( ((collection_get{ collection -> ("got_first_core") index -> ( counter ) } == "true") ? 1 : 0) + ((collection_get{ collection -> ("got_second_core") index -> ( counter ) } == "true") ? 2 : 0) )} ; # this is a really bad hack, but I couldn't find a concise way to code things. Maybe I could use a dynamic boolean.
   part_bonus_score : dynamic_integer {( ((collection_get{ collection -> ("got_first_bonus") index -> ( counter ) } == "true") ? 1 : 0) + ((collection_get{ collection -> ("got_second_bonus") index -> ( counter ) } == "true") ? 2 : 0) )} ; # this is a really bad hack, but I couldn't find a concise way to code things. Maybe I could use a dynamic boolean.

}

