   r32 : location "{r32_loc}" header="{r32_header}" {
      on_command {
         : match "listen _;_ chess;_ training" {
            : print {( point_dump_liars ? "It's silent now with the chess training over." : "It's tough to know whether or not the training is effective, but it sure is loud. Everybody is yelling about stuff like the Carlsbad pond structure, or opening theory 15 lines down, or other things that just sort of make your head spin. Of course, there's always a person who yells you just have to sit there and make good moves, and they're shushed." )} ;
            : done ;
         }
         : if (point_chest_reigning && !point_dump_liars) {
            : match "_ dumb;_ pliers" {
               : print "The chess players all call out \"TOOL AIM-TOO-LAME!\" as you consider picking it up. You have no snappy comeback. You sense you don't need a detailed one." ;
               : done ;
            }
         }
         : match "chest reigning" {
            : if (point_chest_reigning) {
               : print "One chest is enough. Don't get greedy." ;
               : done ;
            }
            : print "If chess is the sport of kings and Queens, then it makes sense that anything around it must be pretty royal, too. Surprisingly, nobody really stops their analysis, but when you open the chest, you find a pair of {puz_point_dumb_pliers}. The trainers say, come on, {puz_point_dumb_pliers}? That's just dumb. Not as interesting as chess analysis! But hey, it's something. You probably wouldn't be able to carry vast riches anyways. But you still feel a bit embarrassed taking the pliers." ;
            : set_integer var="tempint" "13" ;
            : set_true "point_chest_reigning" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_chest_reigning) {
            : match "_ raining" {
               : print "You don't need to make everyone wet here. But you're on the right track." ;
            }
            : match "chest _;_ reigning" {
               : set_integer var="tempint" "13" ;
               : set_false "first_half" ;
               : match "chest _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_chest_reigning && !point_dump_liars) {
            : match "dump liars" {
               : if (point_dump_liars) {
                  : print "They're already dumped, and convincingly." ;
                  : done ;
               }
               : print "Of course, you can't call them liars, but in your mind, you dump them and say, well, I can take responsibility for my actions if somehow there is a big electric surge through these players that makes me dumber, and anyway, it would be less of a loss than if it made you dumber, am I right? They recognize this is the most blow off form of flattery, but what can they do? Instead of blocking you going east, they now seem as though they wish you really would go east as soon as possible. Small victories, yay!" ;
               : set_integer var="tempint" "14" ;
               : set_true "point_dump_liars" ;
               : gosub "add_point" ;
               : pocket "dumb_pliers" ;
               : done ;
            }
            : if (!point_dump_liars) {
               : match "dump _;_ liars" {
                  : set_integer var="tempint" "14" ;
                  : set_false "first_half" ;
                  : match "dump _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
