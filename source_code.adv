         : overlay "s13_right" x="188" y="2" ;
      }
   } : else_if (is_at "r14") { # background doesn't change. We just tack on passage north.
      : if (point_fey_loops) {
         : overlay "s14_fey" x="110" y="13" ;
      }
   } : else_if (is_at "r20") {
      : if (point_yell_open) {
         : overlay "s20_door_1" x="95" y="8" ;
         : if (!gamestate_thug_chase) {
            : overlay "s20_you_1" x="59" y="25" ;
         }
      } : else {
         : overlay "s20_door_0" x="94" y="8" ;
         : overlay "s20_you_0" x="59" y="25" ;
      }
   } : else_if (is_at "r21") {
      : if (!point_halt_error) {
         : overlay "s21_m" x="0" y="0" ;
      }
      : if (point_fell_asleep) {
         : overlay "s21_e" x="102" y="7" ;
      }
   } : else_if (is_at "r21") {
   } : else_if (is_at "r22") {
      : if (!point_free_crusty) {
         : overlay "s_freak_0" x="110" y="0" ;
      } : else {
         : overlay "s_freak_1" x="110" y="0" ;
      }
   } : else_if (is_at "r23") {
      : if (!point_frame_easily) {
         : overlay "s23_fray" x="0" y="0" ;
      }
   } : else_if (is_at "r24") {
      : if (point_warm_acres) {
         : overlay "s24_1" x="0" y="19" ;
      } : else {
         : overlay "s24_0" x="0" y="19" ;
      }
   } : else_if (is_at "r30") {
      : if (point_door_cloud) {
         : overlay "s30_1" x="110" y="10" ;
      } : else {
         : overlay "s30_0" x="130" y="0" ;
      }
   } : else_if (is_at "r31") {
      : if (!point_hate_rash) {
         : overlay "s31_1" x="10" y="2" ;
         : overlay "s31_1" x="199" y="2" ;
      }
   } : else_if (is_at "r32") {
      : if (point_chest_reigning) {
         : overlay "s32_chest" x="10" y= "12" ;
         : if (!point_dump_liars) {
            : overlay "s32_pliers" x="20" y= "20" ;
         }
      }
   } : else_if (is_at "r33") {
      : if (point_say_loaners) {
         : overlay "s33_sold" x="88" y="19" ;
      }
   } : else_if (is_at "r34") {
   } : else_if (is_at "r40") {
      : if (point_shape_up) {
         : if (random(10) < 4) { # this does not happen at the 1/2 rate it should, neither does random(1) < 1
            : overlay "s_dog_r" x="160" y="22" ;
         } : else {
            : overlay "s_dog_u" x="160" y="22" ;
         }
      }
   } : else_if (is_at "r41") {
   } : else_if (is_at "r42") {
      : overlay "s_boat" x="172" y="27" ;
   } : else_if (is_at "r43") {
      : overlay "s_boat" x="96" y="27" ;
      : overlay "s43_you" x="105" y="9" ;
   } : else_if (is_at "r44") {
      : if (!point_tense_ops) {
         : overlay "s44_0" x="0" y="0" ;
      } : else {
         : overlay "s44_1" x="0" y="0" ;
      }
   } : else_if (is_at "r15") {
   } : else_if (is_at "r25") {
   } : else_if (is_at "r26") {
      : if (!point_bah_slumping) {
         : overlay "s_boss" x="96" y="0" ;
      }
   } : else_if (is_at "r27") {
   } : else_if (is_at "r35") {
      : if (!point_mage_urgent) {
         : overlay "s_gent" x="187" y="10" ;
      }
   }
   # general NPC stuff here
   : if (gamestate_thug_chase) {
      : if (is_at "r20") {
         : overlay "s_thug" x="52" y="13" ;
      } : else_if (is_at "r22") {
         : overlay "s_thug" x="82" y="13" ;
      } : else {
         : overlay "s_thug" x="112" y="13" ;
      }
   }
   : if (is_at "end_zone") {
      : if (point_mage_urgent && !point_bah_slumping) {
         : overlay "s_mage" x="183" y="10" ;
      }
      : if (point_broke_lass && !point_bah_slumping) {
         : overlay "s_lass" x="42" y="10" ;
      }
   }
   : if (point_girl_only && !point_warm_acres) {
      : if (is_at "r34" || is_at "r22") {
         : overlay "s_girl" x="136" y="19" ;
      } : else_if (is_at "r43") {
         : overlay "s_girl_boat" x="122" y="17" ;
      } : else_if (is_at "r30") {
         : overlay "s_girl" x="110" y="19" ;
      } : else_if (is_at "r44") {
         : overlay "s_girl" x="123" y="19" ;
      } : else_if (is_at "r20") {
         : overlay "s_girl" x="35" y="31" ;
      } : else_if (need_double_pic) {
         : overlay "s_girl_2" x="238" y="38" ;
      } : else {
         : overlay "s_girl" x="119" y="19" ;
      }
   }
}

