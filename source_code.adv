   point_tune_out          : boolean "false" ; # 42
   point_vine_eater        : boolean "false" ; # 34
   point_warm_acres        : boolean "false" ; # 40
   point_whee_plucky       : boolean "false" ; # 39
   point_yell_open         : boolean "false" ; # 02

   # bonus point(s)
   bonus_point_ho_maps : boolean "true" ;
   bonus_point_thug_aims : boolean "true" ;

   # auxiliary variables
   opt_on_off  : boolean "false" ;
   drawing_map : boolean "false" ;
   inventory_intangibles : boolean "false" ;

   # general go-blocking
   backblock_00 : dynamic_boolean {( try_block && is_at "r01" && coreblock_00 )} ;
   backblock_01 : dynamic_boolean {( try_block && is_at "r11" && coreblock_01 )} ;
   backblock_02 : dynamic_boolean {( try_block && is_at "r01" && coreblock_02 )} ;
   backblock_03 : dynamic_boolean {( try_block && is_at "r13" && coreblock_03 )} ;
   backblock_04 : dynamic_boolean {( try_block && coreblock_04 )} ;
   backblock_10 : dynamic_boolean {( try_block && is_at "r11" && coreblock_10 )} ;
   backblock_11 : dynamic_boolean {( try_block && is_at "r21" && coreblock_11 )} ;
   backblock_12 : dynamic_boolean {( try_block && is_at "r11" && coreblock_12 )} ;
   backblock_13 : dynamic_boolean {( try_block && is_at "r12" && coreblock_13 )} ;
   backblock_14 : dynamic_boolean {( try_block && is_at "r13" && coreblock_14 )} ;
   backblock_20 : dynamic_boolean {( try_block && is_at "r21" && coreblock_20 )} ;
   backblock_21 : dynamic_boolean {( try_block && is_at "r22" && coreblock_21 )} ;
   backblock_22 : dynamic_boolean {( try_block && is_at "r23" && coreblock_22 )} ;
   backblock_23 : dynamic_boolean {( try_block && is_at "r24" && coreblock_23 )} ;
   backblock_24 : dynamic_boolean {( try_block && is_at "r25" && coreblock_24 )} ;
   backblock_30 : dynamic_boolean {( try_block && is_at "r31" && coreblock_30 )} ;
   backblock_31 : dynamic_boolean {( try_block && is_at "r21" && coreblock_31 )} ;
   backblock_32 : dynamic_boolean {( try_block && is_at "r31" && coreblock_32 )} ;
   backblock_33 : dynamic_boolean {( try_block && is_at "r32" && coreblock_33 )} ;
   backblock_34 : dynamic_boolean {( try_block && is_at "r33" && coreblock_34 )} ;
   backblock_40 : dynamic_boolean {( try_block && is_at "r30" && coreblock_40 )} ;
   backblock_41 : dynamic_boolean {( try_block && is_at "r31" && coreblock_41 )} ;
   backblock_42 : dynamic_boolean {( try_block && is_at "r43" && coreblock_42 )} ;
   backblock_43 : dynamic_boolean {( try_block && is_at "r33" && coreblock_43 )} ;
   backblock_44 : dynamic_boolean {( try_block && is_at "r34" && coreblock_44 )} ;

   backblock_15 : dynamic_boolean {( try_block && coreblock_24 )} ;
   backblock_25 : dynamic_boolean {( try_block && coreblock_25 )} ;
   backblock_26 : dynamic_boolean {( try_block && coreblock_26 )} ;
   backblock_35 : dynamic_boolean {( try_block && coreblock_35 )} ;

   #core points-done blockers
   try_block : dynamic_boolean {( opt_hone_aye && !has_visited "r25" && !gamestate_thug_gone )} ;

   roomdone_00 : dynamic_boolean {( point_herd_all )} ;
   roomdone_01 : dynamic_boolean {( point_dumb_parable )} ;
   roomdone_02 : dynamic_boolean {( point_pitch_earning )} ;
   roomdone_03 : dynamic_boolean {( point_tufty_key )} ;
   roomdone_04 : dynamic_boolean {( point_me_growth )} ;
   roomdone_10 : dynamic_boolean {( point_say_four )} ;
   roomdone_11 : dynamic_boolean {( point_duh_losing )} ;
   roomdone_12 : dynamic_boolean {( point_coin_ovations )} ;
   roomdone_13 : dynamic_boolean {( point_whee_plucky )} ;
   roomdone_14 : dynamic_boolean {( point_cloth_robbing )} ;
   roomdone_20 : dynamic_boolean {( point_yell_open )} ;
   roomdone_21 : dynamic_boolean {( point_halt_error && point_fell_asleep )} ;
   roomdone_22 : dynamic_boolean {( point_free_crusty )} ;
   roomdone_23 : dynamic_boolean {( point_frame_easily )} ;
   roomdone_24 : dynamic_boolean {( point_warm_acres )} ;
   roomdone_30 : dynamic_boolean {( point_door_cloud )} ;
   roomdone_31 : dynamic_boolean {( point_hate_rash )} ;
   roomdone_32 : dynamic_boolean {( point_dump_liars )} ;
   roomdone_33 : dynamic_boolean {( point_say_loaners )} ;
   roomdone_34 : dynamic_boolean {( point_ply_towels )} ;
   roomdone_40 : dynamic_boolean {( point_heard_all )} ;
   roomdone_41 : dynamic_boolean {( point_cue_bland )} ;
   roomdone_42 : dynamic_boolean {( point_girl_only )} ;
   roomdone_43 : dynamic_boolean {( point_flow_tripling )} ;
   roomdone_44 : dynamic_boolean {( point_tense_ops )} ;

   roomdone_15 : dynamic_boolean {( point_right_angles )} ;
   roomdone_25 : dynamic_boolean {( point_tune_out )} ;
   roomdone_26 : dynamic_boolean {( point_bah_slumping )} ;
   roomdone_35 : dynamic_boolean {( point_broke_lass )} ;

   coreblock_00 : dynamic_boolean {( roomdone_00 )} ;
   coreblock_01 : dynamic_boolean {( roomdone_00 && roomdone_01 && roomdone_02 )} ;
   coreblock_02 : dynamic_boolean {( roomdone_02 )} ;
   coreblock_03 : dynamic_boolean {( roomdone_03 && roomdone_04 )} ;
   coreblock_04 : dynamic_boolean {( roomdone_04 )} ;
   coreblock_10 : dynamic_boolean {( roomdone_10 )} ;
   coreblock_11 : dynamic_boolean {( coreblock_01 && coreblock_21 )} ;
   coreblock_12 : dynamic_boolean {( roomdone_12 && coreblock_13 )} ;
   coreblock_13 : dynamic_boolean {( roomdone_13 && coreblock_14 && coreblock_03 )} ;
   coreblock_14 : dynamic_boolean {( roomdone_14 )} ;
   coreblock_20 : dynamic_boolean {( roomdone_20 )} ;
   coreblock_21 : dynamic_boolean {( roomdone_21 && coreblock_11 && coreblock_31 )} ;
   coreblock_22 : dynamic_boolean {( roomdone_22 && coreblock_21 )} ;
   coreblock_23 : dynamic_boolean {( roomdone_23 && coreblock_22 )} ;
   coreblock_24 : dynamic_boolean {( roomdone_24 && coreblock_23 )} ;
   coreblock_30 : dynamic_boolean {( roomdone_30 && coreblock_40 )} ;
   coreblock_31 : dynamic_boolean {( roomdone_31 && coreblock_30 && coreblock_41 && coreblock_32 )} ;
   coreblock_32 : dynamic_boolean {( roomdone_32 && coreblock_33 )} ;
   coreblock_33 : dynamic_boolean {( roomdone_33 && coreblock_43 && coreblock_34 )} ;
   coreblock_34 : dynamic_boolean {( roomdone_34 && coreblock_44 )} ;
   coreblock_40 : dynamic_boolean {( roomdone_40 )} ;
   coreblock_41 : dynamic_boolean {( roomdone_41 )} ;
   coreblock_42 : dynamic_boolean {( roomdone_42 )} ;
   coreblock_43 : dynamic_boolean {( roomdone_43 && coreblock_42 )} ;
   coreblock_44 : dynamic_boolean {( roomdone_44 )} ;

   coreblock_15 : dynamic_boolean {( roomdone_15 )} ;
   coreblock_25 : dynamic_boolean {( roomdone_25 && coreblock_15 && coreblock_35 )} ;
   coreblock_26 : dynamic_boolean {( roomdone_26 )} ;
   coreblock_35 : dynamic_boolean {( roomdone_35 )} ;

   #bonus points-done blockers
   bonusblock_20 : dynamic_boolean {( opt_hone_aye && point_yell_open )} ;


   # think variables
   already_got_command : boolean "false" ;
   first_half : boolean "false" ;
   half_bonus : boolean "false" ;
   bonus_obfuscated_note_yet : boolean "false" ;
   bonus_half_note : boolean "false" ;
   think_core_yet : boolean "false" ;
   think_bonus_yet : boolean "false" ;
   think_text_yet : boolean "false" ;
   print_bonus_nag_after : boolean "false" scope="survivor" ;
   print_core_nag_after : boolean "false" ;
   solved_both_parts_core_nag : boolean "false" ;
   solved_both_parts_bonus_nag : boolean "false" ;

   in_bonus_half : boolean "false" ;
   unneeded_half : dynamic_boolean {( tempint == 0 && !in_bonus_half )} ;

   # think specific puzzles variables
   think_bah_slumping  : boolean "false" ;
   think_broke_lass    : boolean "false" ;
   think_cloth_robbing : boolean "false" ;
   think_coin_ovations : boolean "false" ;
   think_door_cloud    : boolean "false" ;
   think_fey_loops     : boolean "false" ;
   think_frame_easily  : boolean "false" ;
   think_free_crusty   : boolean "false" ;
   think_heard_all     : boolean "false" ;
   think_herd_all      : boolean "false" ;
   think_pitch_earning : boolean "false" ;
   think_ply_towels    : boolean "false" ;
   think_right_angles  : boolean "false" ;
   think_say_four      : boolean "false" ;
   think_say_loaners   : boolean "false" ;
   think_tense_ops     : boolean "false" ;
   think_vine_eater    : boolean "false" ;
   think_warm_acres    : boolean "false" ;

   think_herd_all_right_place  : boolean "false" ;
   think_heard_all_right_place : boolean "false" ;

   think_any : dynamic_boolean {( commands_figured > 0 )} ;

   # auxiliary
   tats_blurry  : boolean "false" ;
   show_overlay : boolean "true" ;

   # testing
   tats_each_move : boolean "false" ;
   inventory_each_move : boolean "false" ;
   listen_each_move : boolean "false" ;
}

vocabulary {

   # actual game stuff

   # irregular plurals!
   : noun / aliases = [jury, juries] ;
   : noun / aliases = [injury, injuries] ;

   # we are not the spelling police!
   : noun / aliases = [vendors, venders] ;
   : verb / aliases = [troop, troup, troupe] ;

   # test stuff

   : verb / aliases = [tj, testjump] ;
   : verb / aliases = [gt, goto] ;

}

locations {
   r00 : location "{r00_loc}" header="{r00_header}" {
      on_command {
         : if (!point_fly_traps) {
            : match "_ flight;_ wraps" {
               : print "The flight wraps are pretty nondescript, like bubble wrap but impossible to pop. They prevent flying, walking and even seeing what's behind them, or how much is behind them. How to get rid of them?" ;
               : done ;
            }
         }
         : if (point_fly_traps && !point_vine_eater) {
            : match "_ fly;_ traps" {
               : print "The fly traps won't mess with someone as big as you, but they're dense enough to hide stuff. How to get by them?" ;
               : done ;
            }
         }
         : if (point_vine_eater && !point_warm_acres) {
            : match "_ cat;_ chasing" {
               : print {( "You watch the cat a bit. It's having fun chasing, " + ( point_catch_acing ? "even more now you've helped it get better." : "though it might have more fun if it were better." ) )} ;
               : done ;
            }
         }
         : match "fly traps" {
            : if (point_fly_traps) {
               : print "You already unwrapped the fly traps, for better or worse." ;
               : done ;
            }
            : print "The flight wraps uncurl, with loud poppings, which you haven't heard since you got ahold of a ton of bubble wrap as a kid. Whether or not it was protecting the flight of the plants, or animals the plants prey on, you're not sure. But now the fly traps are out there, and they may need to be tamed." ;
            : set_integer var="tempint" "33" ;
            : set_true "point_fly_traps" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_fly_traps) {
            : match "fly _;_ traps" {
               : set_integer var="tempint" "33" ;
               : set_false "first_half" ;
               : match "fly _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_herd_all) {
            : match "_ herd" {
               : print "The herd is out of sight. But they trusted you. They'll be along when you need them." ;
               : done ;
            }
         }
         : if (point_vine_eater) {
            : match "_ cat;_ chasing" {
               : print {( point_herd_all ? "The cat romps around here happily. You can assume your friends you herded are doing so as well, out of sight." : point_catch_acing ? "Thanks to you, the cat is chasing stuff successfully. What, you can't tell. But the cat can. Cats!" : "The cat is trying to do cat romping around stuff but failing. Maybe you can help it." )} ;
               : done ;
            }
            : match "catch acing" {
               : if (point_catch_acing) {
                  : print "The cat's instincts are already back where they should be." ;
                  : done ;
               }
               : print "You try and show the cat a better way of chasing, perhaps something it should know, but you're patient with it, and it's kind of fun. Eventually, it does get better, and it rubs against your feet, being able to trust you now. Maybe its friends will, too, if it has any." ;
               : set_integer var="tempint" "35" ;
               : set_true "point_catch_acing" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_catch_acing) {
               : match "catch _;_ acing" {
                  : set_integer var="tempint" "35" ;
                  : set_false "first_half" ;
                  : match "catch _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r01 : location "{r01_loc}" header="{r01_header}" {
      on_command {
         : match "_ dump;_ arable" {
            : print {( "Could be better, could be worse.\n" + (point_dumb_parable ? "You've already reflected on the matter, and you don't have to do more." : "Perhaps it has a lesson or story, however shallow it may be. Worst case, you could fob said story off on someone to pretend to be wise.") )} ;
            : done ;
         }
         : match "dumb parable" {
            : if (point_dumb_parable) {
               : print "You already discovered one dumb parable. Two might fry your brain for the rest of the adventure!" ;
               : done ;
            }
            : print "Inspired, perhaps ironically, to construct a dumb parable, you built one out of simple honesty and a new simplicity and some we-are-all-one back to nature stuff and the sort of details that make rich people feel they really really do connect with poor people, at least, poor people willing to do anything not to be poor any more. It's actually kinda somewhat convincing, if you don't think too hard. It's not something that stands up under serious rigor, but it might be nice to pass off to people who don't know better." ;
            : set_integer var="tempint" "8" ;
            : set_true "point_dumb_parable" ;
            : gosub "add_point" ;
            : pocket "dumb_parable" ;
            : done ;
         }
         : if (!point_dumb_parable) {
            : match "dumb _;_ parable" {
               : set_integer var="tempint" "8" ;
               : set_false "first_half" ;
               : match "dumb _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r02 : location "{r02_loc}" header="{r02_header}" graphic="r02_0" {
      on_command {
         : if (!point_pitch_earning) {
            : match "_ titan;_ drowsing" {
               : print {( point_tightened_rousing ? "It's alert and listening to what you have to say." : "It will take quite an effort to wake the titan up." )} ;
               : done ;
            }
         }
         : match "_ pit;_ churning" {
            : print {( "Exploring the pit seems foolhardy. Too many ways to fall.\n" + (point_pitch_earning ? "Besides, there are other places to look around, now you got some riches from the titan." : "The titan, though, well ... perhaps they could help you?" ) )} ;
            : done ;
         }
         : if (!point_pitch_earning) {
            : match "_ titan;_ drowsing" {
               : print {( point_tightened_rousing ? "The titan looks at you expectantly, but not angrily." : "The titan is asleep. Do you dare to wake it? And if so, how?" )}
               : done ;
            }
         }
         : match "tightened rousing" {
            : if (point_tightened_rousing) {
               : print "The giant is already awake. Any more of that might be fatally irritating. Well, for you." ;
               : done ;
            }
            : print "You're not sure how precisely to wake up a giant, but you realize you don't want to be all over the place. You also don't want to be too loud, you stand a safe distance away, and you start yelling stuff, like how you have something interesting for them or whatever. Eventually the giant turns over and blinks and stares at you. So, now, what did you wake them for?" ;
            : set_integer var="tempint" "11" ;
            : set_true "point_tightened_rousing" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_tightened_rousing) {
            : match "tightened _;_ rousing" {
               : set_integer var="tempint" "11" ;
               : set_false "first_half" ;
               : match "tightened _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (!point_tightened_rousing) {
            : match "_ yearning" {
               : print "A bit simpler and a bit more productive. But close." ; # no DONE because PITCH YEARNING is possible
            }
         }

         : match "pitch earning" {
            : if (!point_tightened_rousing) {
               : print "Good idea. Even better idea with the titan not drowsing!" ;
               : set_true "think_pitch_earning" ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (!point_coin_ovations) {
               : print "Unfortunately, you have no money to prove that you've earned something, so your pitch would fall flat!" ;
               : set_true "think_pitch_earning" ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (point_pitch_earning) {
               : print "There is nobody left to pitch to. Anyway, you got more riches than expected here." ;
               : done ;
            }
            : print "You aren't quite sure how you're going to explain what's so great about one coin at first, especially since the giant has riches lying around. Then you find an angle. If someone as small as you can make this coin, with your strategies or whatever, think of what the giant could make with their height and strength and so forth. You put more of the dumb parable to use, and surprisingly, the giant buys it. They walk away. You are confronted with riches. There are \"higher itches, hi\" riches and \"power itches, POW\" riches. You decide on the first, though it's a smaller pile.\nAn unheard voice booms YOU HAVE CHOSEN WELL. PERHAPS IT WASN'T TOO HARD TO IN CASES LIKE THIS, BUT GOOD JOB, ANYWAY. SURPRISINGLY MANY DON'T." ;
            : set_integer var="tempint" "12" ;
            : set_false "think_pitch_earning" ;
            : set_true "point_pitch_earning" ;
            : destroy "coin" ;
            : pocket "riches" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_pitch_earning) {
            : match "pitch _;_ earning" {
               : set_integer var="tempint" "12" ;
               : set_boolean var="already_got_command" {( think_pitch_earning && !point_pitch_earning )} ; # this is optional. Delete if point does not rely on any other variables.
               : set_false "first_half" ;
               : match "pitch _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r03 : location "{r03_loc}" header="{r03_header}" graphic="r03_0" {
      on_command {
         : match "_ trail" {
            : print "It hides no secret passages. It's what's along the trail that's worth looking at." ;
            : done ;
         }
         : match "_ sunk;_ etching" {
            : print {( point_sun_catching ? "You are able to see more of it now." : "It feels like you should be able to see more of it, but you're not looking at it right, or with the right resources." )} ;
            : done ;
         }
         : match "_ tough;_ tiki" {
            : print {( point_tufty_key ? "You'd feel bad about asking it for anything else. But you doubt it has anything else you need." : "It looks tough but not impossible to please. You can't go asking it for any old thing. You think of what you need: a mix of a bit odd and yet pedestrian, like the rather crudely designed tiki itself." )} ;
            : done ;
         }
         : if (point_sun_catching) {
            : match "_ tough;_ tiki" {
               : print {( point_tufty_key ? "It still looks forbidding, even though it coughed up the key for you. Probably don't want to double-dip." : "Not VERY friendly. Almost expectant, though. It's probably not just there for decoration." )} ;
               : done ;
            }
         }
         : match "sun catching" {
            : if (point_sun_catching) {
               : print {( "The tiki doesn't have a hidden friend or relative or whatever. In fact, it might be insulted if you looked for better. Guess you " + (point_tufty_key ? "did well with what you had." : "should deal with what you've got." ) )} ;
               : done ;
            }
            : print "You angle your head various ways, noting that it is still day out, and perhaps if the sun hits things just right, you will see something you didn't. Sure enough, you catch a glean, and you dig into some soil, and you find a {puz_point_tough_tiki} staring back up at you. It's not a very big one, but it still doesn't look like it gives in to other people's wishes very easily." ;
            : set_integer var="tempint" "20" ;
            : set_true "point_sun_catching" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_sun_catching) {
            : match "sun _;_ catching" {
               : set_integer var="tempint" "20" ;
               : set_false "first_half" ;
               : match "sun _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_sun_catching) {
            : match "tufty key" {
               : if (point_tufty_key) {
                  : print "You already got what you needed from the tough tiki. It might not take kindly to asking for more." ;
                  : done ;
               }
               : print "The tiki nods slightly and then opens its mouth. A key falls out. It looks pretty dry, so you pick it up without washing your hands. You nod to the tiki, which closes its eyes." ;
               : set_integer var="tempint" "21" ;
               : set_true "point_tufty_key" ;
               : pocket "tufty_key" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_tufty_key) {
               : match "tufty _;_ key" {
                  : set_integer var="tempint" "21" ;
                  : set_false "first_half" ;
                  : match "tufty _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r04 : location "{r04_loc}" header="{r04_header}" graphic="r04_0" {
      on_command {
         : gosub "fey_loops_check" ;
         : match "_ meager;_ oath" {
            : print {( point_me_growth ? "You've already grokked the oath. It's not much, but it's a small boost." : "You wonder how the meager oath applies to you. You hope it could be applied positively." )} ;
            : done ;
         }
         : match "me growth" {
            : if (point_me_growth) {
               : print "Too much of this self-improvement will leave you completely unsuited for what really matters in life, like weird text adventures. So watch it, sport!" ;
               : done ;
            }
            : print "Oh good, there was a bit of humble bragging in the meager oath, but you try and take the best bits and apply it to your own experiences. It actually works pretty well. You can say, well, if it helps someone less in perspective than me, it can help me, too, and I don't want to be too good for decent advice I've passed out for awhile. You feel more able to deal with people and groups and so forth." ;
            : set_integer var="tempint" "24" ;
            : set_true "point_me_growth" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_me_growth) {
            : match "me _;_ growth" {
               : set_integer var="tempint" "24" ;
               : set_false "first_half" ;
               : match "me _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r10 : location "{r10_loc}" header="{r10_header}" {
      on_command {
         : if (!point_dry_vendors) {
            : match "_ drive;_ enders" {
               : print "They're just dead ends, which isn't very exciting or useful. How to make them more so?" ;
               : done ;
            }
         } : else {
            : match "_ dry;_ vendors" {
               : print {( "Being dry and all, they pay little or no attention to you, not trying to make small talk. " + (point_say_four ? "But you can't imagine you need to buy anything else." : "But if you had something to buy and money to buy it with, they probably would." ) )} ;
               : done ;
            }
            : match "_ safe;_ oars" {
               : print {( point_say_loaners ? "No better oars are on sale than what you have." : point_say_four ? "Well, you have oars now, so you don't need another." : "It's a pretty flimsy oar. You doubt just one would do for water travel." )} ;
               : done ;
            }
         }
         : match "dry vendors" {
            : if (point_dry_vendors) {
               : print "There are quite enough vendors here now." ;
               : done ;
            }
            : print "You look into some nooks, and you find some vendors, indeed. Perhaps what they have for sale isn't for everyone, and they make enough of a profit they don't need to advertise. The main thing that catches your eye is a {puz_point_safe_oar}." ;
            : set_integer var="tempint" "7" ;
            : set_true "point_dry_vendors" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_dry_vendors) {
            : match "dry _;_ vendors" {
               : set_integer var="tempint" "7" ;
               : set_false "first_half" ;
               : match "dry _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_dry_vendors && !point_say_four) {
            : match "say four" {
               : if (!point_pitch_earning) {
                  : print "Four oars? But you can't afford one!" ;
                  : set_true "think_say_four" ;
                  : gosub "note_thinks" ;
                  : done ;
               }
               : if (point_say_four) {
                  : print "You probably got more oars than you need." ;
                  : done ;
               }
               : print "Four seems about right for your needs. Too many, and you couldn't carry them all, but too few, and you might lose a spare. Some of the riches are leftover for later. Perhaps you'll have to buy transport." ;
               : print "Now you're the owner of the oars, you realize it'd be awkward to carry them. But the vendors assure you they'll hold them until you find a craft. Thoughtful!" ;
               : set_integer var="tempint" "17" ;
               : set_false "think_say_four" ;
               : set_true "point_say_four" ;
               : destroy "riches" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_say_four) {
               : match "say _;_ four" {
                  : set_integer var="tempint" "17" ;
                  : set_boolean var="already_got_command" {( think_say_four && !point_say_four )} ; # this is optional. Delete if point does not rely on any other variables.
                  : set_false "first_half" ;
                  : match "say _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r11 : location "{r11_loc}" header="{r11_header}" graphic="r11_0" {
      on_command {
         : if (point_duh_losing) {
            : match "_ ooze" {
               : print "It's not just ooze, it's oozing! For whatever reason, this nags at you." ;
               : done ;
            }
         }
         : match "_ dull;_ oozing" {
            : print {( point_duh_losing ? "You don't want to focus on the oozing. It took effort not to." : "You stare at, and listen to, the dull oozing for a while. You get the feeling you really should be grateful for your freedom, yet at the same time, exercising it would be unfair to other prisoners. If they exist, of course. Can't be too considerate these days! Besides, you admit you have no interesting plans...\n...wait, no, you can do better than that." )} ;
         }
         : match "duh losing" {
            : if (point_duh_losing) {
               : print "No need to reiterate things." ;
               : done ;
            }
            : print "You recognize the dull oozing for what it is: blather that just prevents other people from trying for what they want. You're simply not going to put up with that sort of thing any more. Well, not in that form, at least." ;
            : set_integer var="tempint" "6" ;
            : set_true "point_duh_losing" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_duh_losing) {
            : match "duh _;_ losing" {
               : set_integer var="tempint" "6" ;
               : set_false "first_half" ;
               : match "duh _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r12 : location "{r12_loc}" header="{r12_header}" {
      on_command {
         : match "_ knowin;_ juries" {
            : print {( "You look at the juries, about to speak, but they cut you off with a sharp glare." + ( point_no_injuries ? "Surely you're not foolish enough to risk going east? You have no clue..." : point_coin_ovations ? "With your little story complete, they've found other people to judge. Their work is never done!" : "They seem almost interested in you back, for the moment." ) )} ;
            : done ;
         }
         : if (!point_coin_ovations) {
            : match "co _;_ innovations;_inovations" {
               : print "Right idea, but \"co\" wouldn't quite work. Look for something more concrete." ;
            }
         }
         : if (point_no_injuries && !point_coin_ovations) {
            : match "_ coy;_ novations" {
               : print "The coy novations are beyond you, full of legalese, with occasional demands to keep it simpler and others to use one's brain a bit to try and actually deal with a semi-complex thought some of the time." ;
               : done ;
            }
         }
         : match "no injuries" {
            : if (point_no_injuries) {
               : print "Strange. The juries have already forgotten about their little problems. It's as if some people just like to sit around and tell other people what they can't do, and then feel as though they've done something if they succeed." ;
               : done ;
            }
            : print "You assure the juries that you are of perfectly sound body, if not mine, and you also mentioned that if something does happen, you can take liability for it. They say OK we guess.\nWith this done, they begin some {puz_point_coy_novations}." ;
            : set_integer var="tempint" "9" ;
            : set_true "point_no_injuries" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_no_injuries) {
            : match "no _;_ injuries" {
               : set_integer var="tempint" "9" ;
               : set_false "first_half" ;
               : match "no _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_no_injuries) {
            : match "coin ovations" {
               : if (point_coin_ovations) {
                  : print "You really don't want to repeat the dumb parable inspired story, and you also don't want the juries to potentially see through it the second time through." ;
                  : done ;
               }
               : if (!point_dumb_parable) {
                  : print "You do the best you can, but the jury is not impressed by your story. You gain neither coin nor ovations. Its core feels solid, but you need to spice it up somehow." ;
                  : set_true "think_coin_ovations" ;
                  : gosub "note_thinks" ;
                  : done ;
               }
               : print "Surprisingly, the dumb parable works on the juries, who maybe just needed something some sort of new simplicity to ooh and ahh at.\nEach discusses with their argue-ee why the simple parable backs THEIR point up, and there are a few minor scuffles, before they go back to complex reasons why people they're smarter than and don't like shouldn't get to do more than they do.\nThey give you both coin AND innovations, though unsurprisingly, there's a lot more ovations than coin." ;
               : print "{cnco}, you remark, maybe overdoing it. They applaud your originality in politeness further." ;
               : print "You almost have a headache by the time the applause stops, but at least you're not broke now.\nThe juries appear to have resolved their differences for the moment, and they just ignore you now. You've, uh, passed, I guess." ;
               : set_integer var="tempint" "10" ;
               : set_false "think_coin_ovations" ;
               : set_true "point_coin_ovations" ;
               : destroy "dumb_parable" ;
               : pocket "coin" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_coin_ovations) {
               : match "coin _;_ ovations" {
                  : set_integer var="tempint" "10" ;
                  : set_false "first_half" ;
                  : match "coin _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r13 : location "{r13_loc}" header="{r13_header}" {
      on_command {
         : if (gamestate_bros_blocking) {
            : match "_ gah;_ bros;_ bag;_ rows" {
               : print "They sort of stand between the south and east passages, ready to step in one if you want to go forward.\nYou probably can't deal with the bros by logic. While you doubt they'll turn violent, but you've met people like this, who wear you down from doing simple things you want, making you feel bad you have some purpose, however unclear, and they don't. (Or vice versa.)" ;
               : done ;
            }
         }
         : match "pose teasing" {
            : if (point_pose_teasing) {
               : print "You already exposed things." ;
               : done ;
            }
            : print "You seem to sort of pattern before, when you wanted to like read a book or do something interesting on your own that other people didn't like. They would tell you to take it easy or whatever, then of course when they describe stuff, that they like to do, they would say why aren't you appreciating how much fun I have? The Bros look a bit upset that you've seen through this, but what can they really do? They say, well, you're lost, there's really not all that much beyond, at least not for interesting people." ;
            : set_integer var="tempint" "19" ;
            : set_true "point_pose_teasing" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_pose_teasing) {
            : match "pose _;_ teasing" {
               : set_integer var="tempint" "19" ;
               : set_false "first_half" ;
               : match "pose _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (gamestate_bros_second_placed) {
            : match "whee plucky" {
               : if (point_whee_plucky) {
                  : print "You don't need to Show Them any more. Wherever They went. Better to Do Stuff, with them watching or not." ;
                  : done ;
               }
               : print "You flip the script on the Bros. You say, well, maybe I've made my own luck and all that sort of thing, and maybe you haven't, by sitting around and complaining about how other people have all the luck. They start fighting with each other. Who complaints the most? Who complaints the least? There's a big argument. It's almost entertaining, but you don't want to get too caught up in it. It dies down eventually. The Bros go off to sulk somewhere else." ;
               : set_integer var="tempint" "39" ;
               : set_true "point_whee_plucky" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_whee_plucky) {
               : match "we _;wee _" {
                  : print "That feels right and doesn't. You could be more cheery. I mean, you always could, but even faking it around the bros might make them give up on you." ;
               }
               : match "whee _;_ plucky" {
                  : set_integer var="tempint" "39" ;
                  : set_false "first_half" ;
                  : match "whee _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
      on_describe {
         : if (gamestate_bros_second_trigger && !gamestate_bros_second_placed) {
            : set_false "gamestate_bros_second_trigger" ;
            : set_true "gamestate_bros_second_placed" ;
            : print "The Bros are back at it again. They ask how you've been. You mention you've been doing stuff since last you chatted. They all {puz_point_weep_lucky} ... what a stupid guilt trip. But for whatever reason, it works, and you're going to have to change your mindset to get out of this one." ;
         }
      }
   }
   r14 : location "{r14_loc}" header="{r14_header}" graphic="r14_0" {
      on_command {
         : gosub "fey_loops_check" ;
         : match "_ claw;_ throbbing" {
            : print {( point_cloth_robbing ? "The claw continues to throb around in an attempt to at least somewhat guard the cloth you got." : "The claw throbs around, predictably but thoroughly. You'll need purpose and means to get what you want and need." )} ;
            : done ;
         }
         : match "cloth robbing" {
            : if (!point_dump_liars) {
               : print "But you don't have any sort of tool that could grab what you need from the {puz_point_claw_throbbing} and get out of the way quickly!" ;
               : if (point_say_four) {
                  : print "(Lugging the oars here would not work. They couldn't get a handle on what's underneath in time. And you won't win a fight with it.)" ;
               }
               : set_true "think_cloth_robbing" ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (point_cloth_robbing) {
               : print "You doubt you need any more cloth." ;
               : done ;
            }
            : print "As the cloth throbs around, you use the pliers, which suddenly seem pretty smart, or at least you are smart enough to take them, to pull cloth away. The claw doesn't really seem to notice, or it just goes in its general circuit, oblivious to what has changed. Congratulations! You're now a possessor of several towels!" ;
            : set_integer var="tempint" "25" ;
            : set_false "think_cloth_robbing" ;
            : set_true "point_cloth_robbing" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_cloth_robbing) {
            : match "cloth _;_ robbing" {
               : set_integer var="tempint" "25" ;
               : set_boolean var="already_got_command" {( think_cloth_robbing && !point_cloth_robbing )} ; # this is optional. Delete if point does not rely on any other variables.
               : set_false "first_half" ;
               : match "cloth _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r15 : location "{r15_loc}" header="{r15_header}" {
      on_command {
         : match "_ libe;_ airy" {
            : print "It's a big library. You could get lost here. But there are two books that seem to stand out. Well, one in particular." ;
            : done ;
         }
         : match "_ lie;_ bury" {
            : print "Perhaps there are books full of lies here, but, well, they'd be buried." ;
            : done ;
         }
         : match "_ tangles" {
            : print "Interesting and clever, but not really directed at you." ;
            : done ;
         }
         : match "_ games" {
            : print "Wowzers, this book is uncool. It's full of \"clever\" manipulation tactics you don't want to know more of. But you feel engrossed through twenty pages before feeling disgusted. You remember people using them on you and trying to give you this sort of \"wisdom\" back in high school. They called you weird for looking confused. These would work if you believed in yourself and applied yourself!" ;
            : done ;
         }
         : match "thug aims" {
            : if (bonus_point_thug_aims) {
               : print "You already deconstructed that book." ;
               : done ;
            }
            : print "You convince yourself the book is total rubbish, seeing old experiences in a new light. You can't exactly lecture this to the masses, but it feels good to, uh, bury some lies people foisted on you when they were Just Being Honest or Telling You What Your Problem Is or Showing Common Sense. You will be able to reject that sort of thing a bit more quickly going forward." ;
            : set_true "bonus_point_thug_aims" ;
            : done ;
         }
         : match "right angles" {
            : if (!point_mage_urgent) {
               : print "It's amusing and insightful and all, but you get no really big leaps from it. Perhaps it's more appropriate for someone who needs to make those big leaps and doesn't want to feel forced to. You can't take the book out of the library, but maybe you could bring someone here." ;
               : set_true "think_right_angles" ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (point_right_angles) {
               : print "You look through the book some more, but really, you've digested about all you can process for the next bit. You're at the point where you're saying, yeah, that's pretty clever, but it will go in one ear and out the other. It did what it needed to, for the person who needed it." ;
               : done ;
            }
            : print "You encourage the mage to look at this new book, refraining from saying, thinking about things right is its own sort of magic. You mentioned that they've probably worked hard to get their beliefs, and maybe the right thing or two could give them a huge jump they just haven't seen before, but they weren't ready for it yet. And they pretty much agree. Their sense of urgency has changed, from desperation down to, well, let's do what we need to and get through with it, and we may actually not have to do anything too crazy. You like to change, even if it's temporary. Perhaps if you go get stuff done, that will encourage it to stay permanent." ;
            : set_integer var="tempint" "43" ;
            : set_false "think_right_angles" ;
            : set_true "point_right_angles" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_right_angles) {
            : match "right _;_ angles" {
               : set_integer var="tempint" "43" ;
               : set_false "first_half" ;
               : match "right _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r20 : location "{r20_loc}" header="{r20_header}" graphic="r20_0" {
      on_command {
         : match "_ wheeze;_ pace;_ wee;_ space" {
            : print {( point_yell_open ? "You're glad there's a way out." : "You may want to focus on specific parts of the space, or your reactions to it, to find a way out." )} ;
            : done ;
         }
         : match "_ floor" {
            : print {( point_thief_lore ? "Nothing else is hidden there." : point_can_do ? "Do you dare to dream something hidden in {puz_point_the_floor} might help you get out the door? What sort of reasoning could you use to find it without driving yourself more quickly?" : "You find nothing. You didn't think you would, anyway. Perhaps if you were more optimistic, you might." )} ;
            : done ;
         }
         : if (point_can_do && !won_yet) {
            : match "_ canned;_ ooh" {
               : print "It's weird. You shouldn't be reciting that since you got canned, but you are. Perhaps the answer to what it really means is simpler than you might thing." ;
               : done ;
            }
         }
         : if (point_thief_lore && !point_yell_open) {
