   point_ply_towels        : boolean "false" ; # 28
   point_pose_teasing      : boolean "false" ; # 19
   point_right_angles      : boolean "false" ; # 43
   point_say_four          : boolean "false" ; # 17
   point_say_loaners       : boolean "false" ; # 18
   point_say_mentoring     : boolean "false" ; # 47
   point_seek_rest         : boolean "false" ; # 31
   point_shape_up          : boolean "false" ; # 37
