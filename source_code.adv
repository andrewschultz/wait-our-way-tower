   r24 : location "{r24_loc}" header="{r24_header}" {
      on_command {
         : match "_ war;_ makers" {
            : print {( point_warm_acres ? "No sign of them now." : "Very intimidating. You doubt reasoning or charisma will work with them. They look tougher to defuse than the fray, measly, from just back west. You might need serious help." )} ;
            : done ;
         }
         : if (!point_warm_acres) {
