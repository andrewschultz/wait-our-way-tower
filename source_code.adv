               : done ;
            }
         }
         : if (point_halt_error && !point_fell_asleep) {
            : match "e _" {
               : cycle key = "r21_e_block" predictable_order = "true" skip_interval = "0" max_loops = "1" {
                  : print "The way seems a bit dark, but before you get too far, you hear a loud voice shout \"{puz_point_fellas_leap}!\" Nope, bad idea to go there as-is." ;
                  : print "Still the voice yelling \"{puz_point_fellas_leap}!\"" ;
               }
               : set_true "gamestate_r21_e" ;
            }
         }
         : match "halt error" {
            : if (point_halt_error) {
               : print "There's no need to prevent things coming back." ;
