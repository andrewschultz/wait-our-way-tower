   }
   r22 : location "{r22_loc}" header="{r22_header}" {
      on_command {
         : match "_ freak;_rusty" {
            : print {( point_free_crusty ? "They seem happier now you've helped them reframe their life." : "They don't need to be reminded of their weaknesses. They maybe need to restate how things are. It's not their fault. (Small voice: it's mine, actually. But I hope I--and you--make things turn out okay for them in the end.)" )} ;
            : done ;
         }
         : match "_ field;_ erring" {
            : print {( point_feel_daring ? "You feel more confident navigating the field and other personal relationships." : "It's not a very big field, but you are worried about putting your feet wrong." )} ;
            : done ;
         }
         : match "feel daring" {
            : if (point_feel_daring) {
               : print "You don't want to engage in daring for the sake of daring. Sometimes, if you do too much of that, it burns you out for later. And you sense you have a good chunk of adventure to go." ;
               : done ;
            }
            : print "It's not exactly flipping a switch count but it is important to feel as though you can try stuff, and to do so, you remember other times you were unexpectedly brave, and big or small things. It seems to work, for now. A nagging voice tells you you really don't want to waste that daring feeling. You're actually glad to have it around." ;
            : set_integer var="tempint" "15" ;
            : set_true "point_feel_daring" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_feel_daring) {
            : match "feel _;_ daring" {
               : set_integer var="tempint" "15" ;
               : set_false "first_half" ;
               : match "feel _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (!point_free_crusty) {
            : match "free crusty" {
               : if (!point_feel_daring) {
                  : print "You don't have the courage to talk to the freak yet, sadly!" ;
                  : set_true "think_free_crusty" ;
                  : gosub "note_thinks" ;
                  : done ;
               }
               : if (point_free_crusty) {
                  : print "You already helped the ex-freak see their individuality more productively." ;
                  : done ;
               }
               : print "You tell the freak, nonsense, you don't have to be a freak, and they say other people have said that and they call them even more of a freak for not finding a way. But you say, well, why not frame it as nonconformism? So you're suspicious of it all, and maybe you are, well, a bit free of it, and feeling a bit crusty that more people haven't seen it, the sort of people who swear they have more common sense than you do. Brilliant, they say, I'll give that a try. I'd like to cut off your jib. They walk off, presumably to educate other people, and definitely to not block your way east any more." ;
               : set_integer var="tempint" "16" ;
               : set_false "think_free_crusty" ;
               : set_true "point_free_crusty" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_free_crusty) {
               : match "free _;_ crusty" {
                  : set_integer var="tempint" "16" ;
                  : set_boolean var="already_got_command" {( think_free_crusty && !point_free_crusty )} ; # this is optional. Delete if point does not rely on any other variables.
                  : set_false "first_half" ;
                  : match "free _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
