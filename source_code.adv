   r26 : location "{r26_loc}" header="{r26_header}" {
      on_command {
         : if (point_bah_slumping && !point_say_mentoring) {
               : match "say mentoring" {
                  : print "You give up and ask for help. The people who shut you in the tower appear. Good, you made it, they say. They discuss how they overheard you saying you feel unlucky and nothing happens to you. Well, now it did. And perhaps you might feel lucky now some of your actions and thoughts worked as they did. And not the sort of guilty-lucky, but the sort where you know you're relatively fortunate and want to take advantage of that when you can and not be jealous if others do. They apologize for the ... inconvenience. You figure it's okay. It was something to do, and then some." ;
               : set_integer var="tempint" "47" ;
               : set_true "point_say_mentoring" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_say_mentoring) {
               : match "say _;_ mentoring" {
                  : set_integer var="tempint" "47" ;
                  : set_false "first_half" ;
                  : match "say _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
         : match "_ know;_ power;_ nope;_ hour" {
            : print {( "You think about power and its accumulation. You remember people accusing you of wanting it when you just wanted to feel less helpless around them.\n" + ( point_bah_slumping ? "They fooled you, but the boss did not." : "The {puz_point_boss_lumping} is another of them. Perhaps you can deflect them creatively? It doesn't have to be PERFECTLY logical." ) )} ;
            : done ;
         }
         : if (point_bah_slumping && !point_say_mentoring) {
            : match "e _" {
               : cycle key="mentor_door" predictable_order = "true" skip_interval = "0" max_loops = "1" {
                  : print "You walk through the door into a room exactly like the one you left. Actually, it is, because you look behind to the west, and there is {r25_header}. Which is sort of a relief. Maybe trying again will help. Maybe it won't." ;
                  : print "Once again, back where you came through the {puz_point_same_entering} door. You remember the cliche of how the definition of insanity is doing the same thing and expecting different results. Except, well, here, you're getting different results for the moment." ;
                  : print "Perhaps someone else has been through that door before you and gotten somewhere else." ;
                  : print "You try crawling, walking backwards, and somersaulting through the door. Always to the same place. What is the solution here?" ;
                  on_exhausted {
                     : print "Same action, same results. You're out of new ideas. You need some outside help to get by the door. How to ask for it." ;
                  }
               }
            }
         }
         : if (!point_bah_slumping) {
            : match "_ boss;_ lumping" {
               : print "They don't show any signs of letting up, but they don't show any signs of saying something new or original after their firs barrage." ;
               : done ;
            }
         }
         : match "bah slumping" {
            : if (!point_broke_lass) {
               : print {( "You lack conviction and support. " + (point_mage_urgent ? "Well, the mage gives some support, but not enough." : "Once you have it, you could send the boss slumping, though.") )} ;
               : set_true "think_bah_slumping" ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (point_bah_slumping) {
               : print "Don't rub it in. The boss is long gone, anyway." ;
               : done ;
            }
            : print "Even though the boss doesn't seem to let up, you actually pretend that they are, and you have the backup to prove it. The gal and the mage can believably pretend they don't know each other that well, or you, so it doesn't come off as a coordinated effort. You play off this a lot, and the boss, trying to lump in your problems or alleged problems, gives up. You're just not going to listen, are you? They run away. The mage and the lass talk to you for a bit. They have other things to do, too, and they go their separate ways, and the mage realizes he has a lot to learn beyond just spells and stuff.\nBehind the boss, you see a door with text {puz_point_same_entering} on it." ;
            : set_integer var="tempint" "46" ;
            : set_false "think_bah_slumping" ;
            : set_true "point_bah_slumping" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_bah_slumping) {
            : match "bah _;_ slumping" {
               : set_integer var="tempint" "46" ;
               : set_boolean var="already_got_command" {( think_bah_slumping && !point_bah_slumping )} ;
               : set_false "first_half" ;
               : match "bah _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r27 : location "{r27_loc}" header="{r27_header}" {
      on_command {
         : if (point_blest_able) {
            : match "listen _;_ true;_ pleading" {
               : print "The {puz_point_true_pleading} sounds like concerns you have, or had. Even the ones different, you can relate to, or you don't find them stupid. Perhaps you could share things with other seekers. But to do that you might have to show confidence in doing things beyond, well, just shuffling word sounds around. What could it be? Could you dare to take the jump?" ;
               : done ;
            }
         }
         : match "_ bleah;_ stable" {
            : print "Things aren't going to come crashing down here, but you hope for better than that bare minimum, and you wonder if others do, too." ;
            : done ;
         }
         : match "blest able" {
            : if (point_blest_able) {
               : print "At some point, there are diminishing or even negative returns for counting and re-counting your blessings. What will you do with them, around the true pleading?" ;
               : done ;
            }
            : print "Instead of feeling statement, you feel as though there are possibilities, possibilities that would not have opened up in a more chaotic environment. You sit back and think of your own thoughts and listen to what there is to listen to. There is now a lot of {puz_point_true_pleading}, a lot of thoughts you had and forgot you did, or you dismissed as not really important or worldly enough." ;
            : set_integer var="tempint" "48" ;
            : set_true "point_blest_able" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_blest_able) {
            : match "blest _;_ able" {
               : set_integer var="tempint" "48" ;
               : set_false "first_half" ;
               : match "blest _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_blest_able) {
            : match "troop leading" {
               : print "You win! (fill in text here about inspiring people, maybe nobody terribly much that they can rave, but you do these small things)" ;
               : set_true "won_yet" ;
               : set_integer var="tempint" "49" ;
