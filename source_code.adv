   # testing
   tats_each_move : boolean "false" ;
   inventory_each_move : boolean "false" ;
   listen_each_move : boolean "false" ;
}

vocabulary {

   # actual game stuff

   # irregular plurals!
   : noun / aliases = [jury, juries] ;
   : noun / aliases = [injury, injuries] ;

   # we are not the spelling police!
   : noun / aliases = [vendors, venders] ;
   : verb / aliases = [troop, troup, troupe] ;

   # test stuff

   : verb / aliases = [tj, testjump] ;
   : verb / aliases = [gt, goto] ;

}

locations {
   r00 : location "{r00_loc}" header="{r00_header}" {
      on_command {
         : if (!point_fly_traps) {
            : match "_ flight;_ wraps" {
               : print "The flight wraps are pretty nondescript, like bubble wrap but impossible to pop. They prevent flying, walking and even seeing what's behind them, or how much is behind them. How to get rid of them?" ;
               : done ;
            }
         }
         : if (point_fly_traps && !point_vine_eater) {
            : match "_ fly;_ traps" {
               : print "The fly traps won't mess with someone as big as you, but they're dense enough to hide stuff. How to get by them?" ;
               : done ;
            }
         }
         : if (point_vine_eater && !point_warm_acres) {
            : match "_ cat;_ chasing" {
               : print {( "You watch the cat a bit. It's having fun chasing, " + ( point_catch_acing ? "even more now you've helped it get better." : "though it might have more fun if it were better." ) )} ;
               : done ;
            }
         }
         : match "fly traps" {
            : if (point_fly_traps) {
               : print "You already unwrapped the fly traps, for better or worse." ;
               : done ;
            }
            : print "The flight wraps uncurl, with loud poppings, which you haven't heard since you got ahold of a ton of bubble wrap as a kid. You remember popping the stuff too quickly, then, as you grew older and wiser, leaving it for later, much later, until the bubbles popped by themselves. Whether or not it was protecting the flight of the plants, or animals the plants prey on, you're not sure. But now the fly traps are out there, and they probably need to be tamed." ;
            : set_integer var="tempint" "33" ;
            : set_true "point_fly_traps" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_fly_traps) {
            : match "fly _;_ traps" {
               : set_integer var="tempint" "33" ;
               : set_false "first_half" ;
               : match "fly _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_herd_all) {
            : match "_ herd" {
               : print "The herd is out of sight. But they trusted you. They'll be along when you need them." ;
               : done ;
            }
         }
         : if (point_vine_eater) {
            : match "_ cat;_ chasing" {
               : print {( point_herd_all ? "The cat romps around here happily. You can assume your friends you herded are doing so as well, out of sight." : point_catch_acing ? "Thanks to you, the cat is chasing stuff successfully. What, you can't tell. But the cat can. Cats!" : "The cat is trying to do cat romping around stuff but failing. Maybe you can help it." )} ;
               : done ;
            }
            : match "catch acing" {
               : if (point_catch_acing) {
                  : print "The cat's instincts are already back where they should be." ;
                  : done ;
               }
               : print "You try and show the cat a better way of chasing, perhaps something it should know, but you're patient with it, and it's kind of fun. Eventually, it does get better, and it rubs against your ankles, able to trust you now. Maybe its friends will, too, if it has any. Cats do seem to have none, or many." ;
               : set_integer var="tempint" "35" ;
               : set_true "point_catch_acing" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_catch_acing) {
               : match "catch _;_ acing" {
                  : set_integer var="tempint" "35" ;
                  : set_false "first_half" ;
                  : match "catch _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r01 : location "{r01_loc}" header="{r01_header}" graphic="r01_0" {
      on_command {
         : match "_ dump;_ arable" {
            : print {( "Could be better, could be worse.\n" + (point_dumb_parable ? "You've already reflected on the matter, and you don't have to do more." : "Perhaps it has a lesson or story, however shallow it may be. Worst case, you could fob said story off on someone to pretend to be wise.") )} ;
            : done ;
         }
         : match "dumb parable" {
            : if (point_dumb_parable) {
               : print "You already discovered one dumb parable. Two might fry your brain for the rest of the adventure!" ;
               : done ;
            }
            : print "Inspired, perhaps ironically, to construct a dumb parable, you build one out of simple honesty and a new simplicity and some we-are-all-one back to nature stuff and the sort of details that make rich people feel they really really do connect with poor people. Well, at least, poor people willing to do anything not to be poor any more." ;
            : print "It's actually kinda somewhat convincing, if you don't think too hard. It's not something that stands up under serious rigor, but it might be nice to pass off to people who don't know better." ;
            : print "You're generally morally opposed to that sort of thing, but on the other hand, a little small talk goes a long way. You've had people do it to you. You remember stories that were inspiring as a kid but they weren't when you got older, or vice versa. The story will work. You won't be signing a contract or speaking under oath in a courtroom, after all." ;
            : set_integer var="tempint" "8" ;
            : set_true "point_dumb_parable" ;
            : gosub "add_point" ;
            : pocket "dumb_parable" ;
            : done ;
         }
         : if (!point_dumb_parable) {
            : match "dumb _;_ parable" {
               : set_integer var="tempint" "8" ;
               : set_false "first_half" ;
               : match "dumb _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r02 : location "{r02_loc}" header="{r02_header}" graphic="r02_0" {
      on_command {
         : if (!point_pitch_earning) {
            : match "_ titan;_ drowsing" {
               : print {( point_tightened_rousing ? "It's alert and listening to what you have to say." : "It will take quite an effort to wake the titan up." )} ;
               : done ;
            }
         }
         : match "_ pit;_ churning" {
            : print {( "Exploring the pit seems foolhardy. Too many ways to fall.\n" + (point_pitch_earning ? "Besides, there are other places to look around, now you got some riches from the titan." : "The titan, though, well ... perhaps they could help you?" ) )} ;
            : done ;
         }
         : if (!point_pitch_earning) {
            : match "_ titan;_ drowsing" {
               : print {( point_tightened_rousing ? "The titan looks at you expectantly, but not angrily." : "The titan is asleep. Do you dare to wake it? And if so, how?" )}
               : done ;
            }
         }
         : match "tightened rousing" {
            : if (point_tightened_rousing) {
               : print "The titan is already awake. Any more of that might be fatally irritating. Well, for you." ;
               : done ;
            }
            : print "You're not sure how precisely to wake up a titan, but you realize you don't want to be all over the place. You also don't want to be too loud, you stand a safe distance away, and you start yelling stuff, like how you have something interesting for them or whatever. It's light on details, but fortunately the titan doesn't seem angry enough to press for them, as it turns over and blinks and stares at you. So, now, what did you wake them for?" ;
            : set_integer var="tempint" "11" ;
            : set_true "point_tightened_rousing" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_tightened_rousing) {
            : match "tightened _;_ rousing" {
               : set_integer var="tempint" "11" ;
               : set_false "first_half" ;
               : match "tightened _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (!point_tightened_rousing) {
            : match "_ yearning" {
               : print "A bit simpler and a bit more productive. But close." ; # no DONE because PITCH YEARNING is possible
            }
         }

         : match "pitch earning" {
            : if (!point_tightened_rousing) {
               : print "Good idea. Even better idea with the titan not drowsing!" ;
               : set_true "think_pitch_earning" ;
               : collection_modify { collection = "tried_combo_core" index -> (12) content -> ("true") } ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (!point_coin_ovations) {
               : print "Unfortunately, you have no money to prove that you've earned something, so your pitch would fall flat!" ;
               : set_true "think_pitch_earning" ;
               : collection_modify { collection = "tried_combo_core" index -> (12) content -> ("true") } ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (point_pitch_earning) {
               : print "There is nobody left to pitch to. Anyway, you got more riches than expected here." ;
               : done ;
            }
            : print "You aren't quite sure how you're going to explain what's so great about one coin at first, especially since the titan has riches lying around. Then you find an angle. If someone as small as you can make this coin, with your strategies or whatever, think of what the titan could make with their height and strength and so forth. You put more of the dumb parable to use, and surprisingly, the titan buys it. They walk away. You are confronted with riches. There are \"higher itches, hi\" riches and \"power itches, POW\" riches. You decide on the first, though it's a smaller pile.\nAn unheard voice booms YOU HAVE CHOSEN WELL. PERHAPS IT WASN'T TOO HARD TO IN CASES LIKE THIS, BUT GOOD JOB, ANYWAY. SURPRISINGLY MANY DON'T." ;
            : set_integer var="tempint" "12" ;
            : set_false "think_pitch_earning" ;
            : set_true "point_pitch_earning" ;
            : destroy "coin" ;
            : pocket "riches" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_pitch_earning) {
            : match "pitch _;_ earning" {
               : set_integer var="tempint" "12" ;
               : set_boolean var="already_got_command" {( think_pitch_earning && !point_pitch_earning )} ; # this is optional. Delete if point does not rely on any other variables.
               : set_false "first_half" ;
               : match "pitch _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r03 : location "{r03_loc}" header="{r03_header}" graphic="r03_0" {
      on_command {
         : match "_ trail" {
            : print "It hides no secret passages. It's what's along the trail that's worth looking at." ;
            : done ;
         }
         : match "_ sunk;_ etching" {
            : print {( point_sun_catching ? "You are able to see more of it now." : "It feels like you should be able to see more of it, but you're not looking at it right, or with the right resources." )} ;
            : done ;
         }
         : if (point_sun_catching) {
            : match "_ tough;_ tiki" {
               : print {( point_tufty_key ? "You'd feel bad about summoning it back to ask it for anything else. But you doubt it has anything else you need." : "It looks tough but not impossible to please. You can't go asking it for any old thing. You think of what you need: a mix of a bit odd and yet pedestrian, like the rather crudely designed tiki itself." )} ;
               : done ;
            }
         }
         : match "sun catching" {
            : if (point_sun_catching) {
               : print {( "The tiki doesn't have a hidden friend or relative or whatever. In fact, it might be insulted if you looked for better. Guess you " + (point_tufty_key ? "did well with what you had." : "should deal with what you've got." ) )} ;
               : done ;
            }
            : print "You angle your head various ways, noting that it is still day out, and perhaps if the sun hits things just right, you will see something you didn't. Sure enough, you catch a gleam, and you dig into some soil, and you find a {puz_point_tough_tiki} staring back up at you. It's not a very big one, but it still doesn't look like it gives in to other people's wishes very easily. Perhaps the Bros tried to get something from it, which left it suspicious." ;
            : set_integer var="tempint" "20" ;
            : set_true "point_sun_catching" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_sun_catching) {
            : match "sun _;_ catching" {
               : set_integer var="tempint" "20" ;
               : set_false "first_half" ;
               : match "sun _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_sun_catching) {
            : if (!point_tufty_key) {
               : match "tuft _;_ icky" {
                  : print "Wrong texture for what the tiki is hiding." ;
               }
            }
            : match "tufty key" {
               : if (point_tufty_key) {
                  : print "You already got what you needed from the tough tiki. It might not take kindly to asking for more." ;
                  : done ;
               }
               : print "The tiki nods slightly and then opens its mouth. A key falls out. It looks pretty dry, so you pick it up without washing your hands. You nod to the tiki, which closes its eyes and sinks into the ground." ;
               : set_integer var="tempint" "21" ;
               : set_true "point_tufty_key" ;
               : pocket "tufty_key" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_tufty_key) {
               : match "tufty _;_ key" {
                  : set_integer var="tempint" "21" ;
                  : set_false "first_half" ;
                  : match "tufty _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r04 : location "{r04_loc}" header="{r04_header}" graphic="r04_0" {
      on_command {
         : gosub "fey_loops_check" ;
         : match "_ meager;_ oath" {
            : print {( point_me_growth ? "You've already grokked the oath. It's not much, but it's a small boost." : "You wonder how the meager oath applies to you. You hope it could be applied positively." )} ;
            : done ;
         }
         : match "me growth" {
            : if (point_me_growth) {
               : print "Too much of this self-improvement will leave you completely unsuited for what really matters in life, like weird text adventures. So watch it, sport!" ;
               : done ;
            }
            : print "You read through the meager oath again. Some parts make you cringe, but some actually hlelp you. You try to take the best bits and apply it to your own experiences." ;
            : print "Some of the advice would have failed miserably, some is over-general, some reminds you of unsolicited advice, and some tipped off actual useful advice from someone who wasn't overbearing." ;
            : print "You can't say your life's changed, but you think as follows: if it's meant to help everyone, I'd be a fool to pass up the parts that actually work and worry whether I'm too smart or too dumb for it." ;
            : print "Perhaps you can pass this feeling on to others later." ;
            : set_integer var="tempint" "24" ;
            : set_true "point_me_growth" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_me_growth) {
            : match "me _;_ growth" {
               : set_integer var="tempint" "24" ;
               : set_false "first_half" ;
               : match "me _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r10 : location "{r10_loc}" header="{r10_header}" {
      on_command {
         : if (!point_dry_vendors) {
            : match "_ drive;_ enders" {
               : print "They're just dead ends, which isn't very exciting or useful. How to make them more so?" ;
               : done ;
            }
         } : else {
            : match "_ dry;_ vendors" {
               : print {( "Being dry and all, they pay little or no attention to you, not trying to make small talk. " + (point_say_four ? "But you can't imagine you need to buy anything else." : "But if you had something to buy and money to buy it with, they probably would." ) )} ;
               : done ;
            }
            : match "_ safe;_ oars" {
               : print {( point_say_loaners ? "No better oars are on sale than what you have." : point_say_four ? "Well, you have oars now, so you don't need another." : "It's a pretty flimsy oar. You doubt just one would do for water travel." )} ;
               : done ;
            }
         }
         : match "dry vendors" {
            : if (point_dry_vendors) {
               : print "There are quite enough vendors here now." ;
               : done ;
            }
            : print "Everything seems to lead nowhere at first. But then you are able to say, well, these trails DEFINITELY lead nowhere, and others don't. Process of elimination stuff, really. You eventually find a path to, well, some dry vendors, and once you do, you realize there's an easier path back." ;
            : print "You take five seconds to feel dumb about your logic not being perfect the first time through. It seems about right. The vendors seem relaxed and crack jokes about the oar vending business. They ask if you do a lot of rowing, and you say no. They point you to a {puz_point_safe_oar}, suggesting you may get a bulk discount depending on how many you need." ;
            : set_integer var="tempint" "7" ;
            : set_true "point_dry_vendors" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_dry_vendors) {
            : match "dry _;_ vendors" {
               : set_integer var="tempint" "7" ;
               : set_false "first_half" ;
               : match "dry _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_dry_vendors && !point_say_four) {
            : match "say four" {
               : if (!point_pitch_earning) {
                  : print "Four oars? But you can't afford one! Yet." ;
                  : set_true "think_say_four" ;
                  : collection_modify { collection = "tried_combo_core" index -> (17) content -> ("true") } ;
                  : gosub "note_thinks" ;
                  : done ;
               }
               : if (point_say_four) {
                  : print "You probably got more oars than you need." ;
                  : done ;
               }
               : print "Four seems about right for your needs. Some of the riches are leftover for later. Perhaps you'll have to buy transport." ;
               : print "But now you're the owner of the oars, you realize it'd be awkward to carry them. However, the vendors, thrilled with your bulk purchase, assure you they'll hold them until you find a craft. Thoughtful!" ;
               : set_integer var="tempint" "17" ;
               : set_false "think_say_four" ;
               : set_true "point_say_four" ;
               : destroy "riches" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_say_four) {
               : match "_ fore" {
                  : print "Hmm, golf clubs are like oars, but ... there's no golf course in this game." ;
               }
               : match "say _;_ four" {
                  : set_integer var="tempint" "17" ;
                  : set_boolean var="already_got_command" {( think_say_four && !point_say_four )} ; # this is optional. Delete if point does not rely on any other variables.
                  : set_false "first_half" ;
                  : match "say _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r11 : location "{r11_loc}" header="{r11_header}" graphic="r11_0" {
      on_command {
         : if (point_duh_losing) {
            : match "_ ooze" {
               : print "It's not just ooze, it's oozing! For whatever reason, this nags at you." ;
               : done ;
            }
         }
         : match "_ dull;_ oozing" {
            : print {( point_duh_losing ? "You don't want to focus on the oozing. It took effort not to." : "You stare at, and listen to, the dull oozing for a while. You get the feeling you really should be grateful for your freedom, yet at the same time, exercising it would be unfair to other prisoners. If they exist, of course. Can't be too considerate these days! Besides, you admit you have no interesting plans...\n...wait, no, you can do better than that." )} ;
         }
         : match "duh losing" {
            : if (point_duh_losing) {
               : print "No need to reiterate things." ;
               : done ;
            }
            : print "You recognize the dull oozing for what it is: blather that just prevents other people from trying a bit harder for what they want. You're simply not going to put up with that sort of thing any more. Well, not in that form, at least." ;
            : print "Perhaps there is no pain here, but you remember those awful NO PAIN NO GAIN t-shirts you'd have looked foolish in. People who wore them generally wondered why you had the patience for boring learning, too. So, yeah, the right sort of frustration motivates you. You still can't describe it, but you know it when you see it. And you need to trust yourself. Not being willing to lose at all is its own sort of losing, or something, after all." ;
            : set_integer var="tempint" "6" ;
            : set_true "point_duh_losing" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_duh_losing) {
            : match "_ loosing" {
               : print "Loosing? There's a better way to remove the oozing's grip for good." ;
            }
            : match "duh _;_ losing" {
               : set_integer var="tempint" "6" ;
               : set_false "first_half" ;
               : match "duh _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r12 : location "{r12_loc}" header="{r12_header}" graphic="r12_0" {
      on_command {
         : match "_ knowin;_ juries" {
            : print {( "You look at the juries, about to speak, but they cut you off with a sharp glare." + ( point_no_injuries ? "Surely you're not foolish enough to risk going east? You have no clue..." : point_coin_ovations ? "With your little story complete, they've found other people to judge. Their work is never done!" : "They seem almost interested in you back, for the moment." ) )} ;
            : done ;
         }
         : if (!point_coin_ovations) {
            : match "co _;_ innovations;_ inovations" {
               : print "Right idea, but \"co\" wouldn't quite work. Look for something more concrete." ;
            }
         }
         : if (point_no_injuries && !point_coin_ovations) {
            : match "_ coy;_ novations" {
               : print "The coy novations are beyond you, full of legalese, with occasional demands to keep it simpler and others to use one's brain a bit to try and actually deal with a semi-complex thought some of the time." ;
               : done ;
            }
         }
         : match "no injuries" {
            : if (point_no_injuries) {
               : print "Strange. The juries have already forgotten about their little problems. It's as if some people just like to sit around and tell other people what they can't do, and then feel as though they've done something if they succeed." ;
               : done ;
            }
            : print "You assure the juries that you are of perfectly sound body, if not mine, and you also mentioned that if something does happen, you can take liability for it. Surprisingly, they don't question you much, even though they outnumber you.\nWith this done, they begin some {puz_point_coy_novations}." ;
            : set_integer var="tempint" "9" ;
            : set_true "point_no_injuries" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_no_injuries) {
            : match "no _;_ injuries" {
               : set_integer var="tempint" "9" ;
               : set_false "first_half" ;
               : match "no _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_no_injuries) {
            : match "coin ovations" {
               : if (point_coin_ovations) {
                  : print "You really don't want to repeat the dumb parable inspired story, and you also don't want the juries to potentially see through it the second time through." ;
                  : done ;
               }
               : if (!point_dumb_parable) {
                  : print "You do the best you can, but the jury is not impressed by your story. You gain neither coin nor ovations. Its core feels solid, but you need to spice it up somehow." ;
                  : set_true "think_coin_ovations" ;
                  : collection_modify { collection = "tried_combo_core" index -> (10) content -> ("true") } ;
                  : gosub "note_thinks" ;
                  : done ;
               }
               : print "You've rehearsed the dumb parable in your mind a few times. Now, the moment of truth. You're sure the juries will find something senseless in too much and too little detail .. and yet, you hear them oohing and aahing at a new simplicity you've discovered.\nEach discusses with a fellow argue-ee why the simple parable backs THEIR point up, and there are a few minor scuffles, before they go back to complex reasons why people they're smarter than and don't like shouldn't get to do more than they do.\nThey give you both coin AND innovations, though unsurprisingly, there's a lot more ovations than coin." ;
               : print "{cnco}, you remark, maybe overdoing it. They applaud your originality in politeness further." ;
               : print "You almost have a headache by the time the applause stops, but at least you're not broke now.\nThe juries even stopped arguing, too, and they just ignore you now. But the coin is yours to keep!" ;
               : set_integer var="tempint" "10" ;
               : set_false "think_coin_ovations" ;
               : set_true "point_coin_ovations" ;
               : destroy "dumb_parable" ;
               : pocket "coin" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_coin_ovations) {
               : match "coin _;_ ovations" {
                  : set_integer var="tempint" "10" ;
                  : set_false "first_half" ;
                  : match "coin _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r13 : location "{r13_loc}" header="{r13_header}" graphic="r13_0" {
      on_command {
         : match "listen _" {
            : print {( gamestate_bros_blocking ? "The bros' chat is depressing really even if you can refute it." : "Nice and quiet with the bros gone." )} ;
            : done ;
         }
         : if (gamestate_bros_blocking) {
            : match "_ gah;_ bros;_ bag;_ rows" {
               : print "They sort of stand between the south and east passages, ready to step in one if you want to go forward.\nYou probably can't deal with the bros by logic. While you doubt they'll turn violent, but you've met people like this, who wear you down from doing simple things you want, making you feel bad you have some purpose, however unclear, and they don't. (Or vice versa.)" ;
               : done ;
            }
         }
         : match "pose teasing" {
            : if (point_pose_teasing) {
               : print "You already exposed things." ;
               : done ;
            }
            : print "The bros are not going to listen to reason. You stretch to think of whom they remind you of. You remember wanting to read a book or do something interesting on your own that they didn't like. They would tell you to take it easy or whatever, but of course when they described stuff, they would say why aren't you appreciating how much fun I have? (Or if you did, they'd remind you THEY actually got to experience things." ;
            : print "So you simply ask them if they're worried a bore (alleged bore) like you has found ways to make your life more exciting than theirs, even though they had the advantage of not being boring." ;
            : print "They say \"Well, okay, go on ahead, but don't blame us if you find it boring there.\" And, it's implied, if you find it interesting, how lame must your life have been until this point?" ;
            : print "You remember people hurting you getting the final word in this way, whether or not they won an argument. You don't have to, now." ;
            : set_integer var="tempint" "19" ;
            : set_true "point_pose_teasing" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_pose_teasing) {
            : match "pose _;_ teasing" {
               : set_integer var="tempint" "19" ;
               : set_false "first_half" ;
               : match "pose _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (gamestate_bros_second_placed) {
            : match "we _" {
               : print "You've never felt comfortable using the royal we with other people. You really hate it when others do. But perhaps a different informal approach would work." ;
            }
            : match "whee plucky" {
               : if (point_whee_plucky) {
                  : print "You don't need to Show Them any more. Wherever They went. Better to Do Stuff, with them watching or not." ;
                  : done ;
               }
               : print "You flip the script on the Bros. You say, well, maybe I've made my own luck and all that sort of thing, and maybe you haven't, by sitting around and complaining about how other people have all the luck. They start fighting with each other. Who complains the most? Who complains the least? There's a big argument. It's almost entertaining, but you don't want to get too caught up in it. It dies down eventually. The Bros go off to sulk somewhere else." ;
               : print "Once they're gone, you realize you didn't even have the time to play the \"You don't realize how lame it is to pick on little ol' me not once but twice\" card. But it's still fun to imagine. Perhaps you can play that card once you've left here." ;
               : set_integer var="tempint" "39" ;
               : set_true "point_whee_plucky" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_whee_plucky) {
               : match "we _;wee _" {
                  : print "That feels right and doesn't. You could be more cheery. I mean, you always could, but even faking it around the bros might make them give up on you." ;
               }
               : match "whee _;_ plucky" {
                  : set_integer var="tempint" "39" ;
                  : set_false "first_half" ;
                  : match "whee _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
      on_describe {
         : if (gamestate_bros_second_trigger && !gamestate_bros_second_placed) {
            : set_false "gamestate_bros_second_trigger" ;
            : set_true "gamestate_bros_second_placed" ;
            : print "The Bros are back at it again. They ask how you've been. You mention you've been doing stuff since last you chatted. They all {puz_point_weep_lucky} ... what a stupid guilt trip. But for whatever reason, it works, and you're going to have to change your mindset to get out of this one." ;
         }
      }
   }
   r14 : location "{r14_loc}" header="{r14_header}" graphic="r14_0" {
      on_command {
         : gosub "fey_loops_check" ;
         : match "_ claw;_ throbbing" {
            : print {( point_cloth_robbing ? "The claw continues to throb around in an attempt to at least somewhat guard the cloth you got." : "The claw throbs around, predictably but thoroughly. You'll need purpose and means to get what you want and need." )} ;
            : done ;
         }
         : match "cloth robbing" {
            : if (!point_dump_liars) {
               : print "But you don't have any sort of tool that could grab what you need from the {puz_point_claw_throbbing} and get out of the way quickly!" ;
               : if (point_say_four) {
                  : print "(Lugging the oars here would not work. They couldn't get a handle on what's underneath in time. And you won't win a fight with it.)" ;
               }
               : set_true "think_cloth_robbing" ;
               : collection_modify { collection = "tried_combo_core" index -> (25) content -> ("true") } ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (point_cloth_robbing) {
               : print "You doubt you need any more cloth." ;
               : done ;
            }
            : print "As the claw throbs around, you use the pliers, which suddenly seem pretty smart (or maybe the DUMB means you don't have to be brilliant to use them) to pull cloth away. The claw doesn't really seem to notice, or it just goes in its general circuit, oblivious to what has changed." ;
            : print "You can't grab too much. You look to see what sort of cloth you've got. Congratulations! You're now a possessor of several towels! And you can pick up more if you need!" ;
            : set_integer var="tempint" "25" ;
            : set_false "think_cloth_robbing" ;
            : set_true "point_cloth_robbing" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_cloth_robbing) {
            : match "cloth _;_ robbing" {
               : set_integer var="tempint" "25" ;
               : set_boolean var="already_got_command" {( think_cloth_robbing && !point_cloth_robbing )} ; # this is optional. Delete if point does not rely on any other variables.
               : set_false "first_half" ;
               : match "cloth _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r15 : location "{r15_loc}" header="{r15_header}" graphic="r15_0" {
      on_command {
         : match "_ libe;_ airy" {
            : print "It's a big library. You could get lost here. But there are two books that seem to stand out. Well, one in particular." ;
            : done ;
         }
         : match "_ lie;_ bury" {
            : print "Perhaps there are books full of lies here, but, well, they'd be buried." ;
            : done ;
         }
         : match "_ tangles" {
            : print "Interesting and clever, but not really directed at you." ;
            : done ;
         }
         : match "_ games" {
            : print "Wowzers, this book is uncool. It's full of \"clever\" manipulation tactics you don't want to know more of. But you feel engrossed through twenty pages before feeling disgusted. You remember people using them on you and trying to give you this sort of \"wisdom\" back in high school. They called you weird for looking confused. These would work if you believed in yourself and applied yourself!" ;
            : done ;
         }
         : match "thug aims" {
            : if (bonus_point_thug_aims) {
               : print "You already deconstructed that book." ;
               : done ;
            }
            : print "When much younger you'd have been impressed that the author was brave in ways you never could be. But now you see it's total rubbish, based on finding someone receptive and trusting and overwhelming them with cheap tricks. You realize you were that someone. But you see why and how it's kind of awful." ;
            : print "You can't exactly lecture this to the masses, but it feels good to, uh, bury some lies people foisted on you when they were Just Being Honest or Telling You What Your Problem Is or Showing Common Sense. You will be able to reject that sort of thing a bit more quickly going forward." ;
            : set_true "bonus_point_thug_aims" ;
            : gosub "add_bonus_point" ;
            : done ;
         }
         : match "right angles" {
            : if (!point_mage_urgent) {
               : print "It's amusing and insightful and all, but you get no really big leaps from it. Perhaps it's more appropriate for someone who needs to make those big leaps and doesn't want to feel forced to. You can't take the book out of the library, but maybe you could bring someone here." ;
               : collection_modify { collection = "tried_combo_core" index -> (43) content -> ("true") } ;
               : set_true "think_right_angles" ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (point_right_angles) {
               : print "You look through the book some more, but really, you've digested about all you can process for the next bit. You're at the point where you're saying, yeah, that's pretty clever, but it will go in one ear and out the other. It did what it needed to, for the person who needed it." ;
               : done ;
            }
            : print "You encourage the mage to look at this new book, refraining from saying, thinking about things right is its own sort of magic." ;
            : print "The mage snaps \"Are you one of those people saying I'm too emotional to lead?\"" ;
            : print "You mentioned that they've probably worked hard to get their beliefs, and maybe the right thing or two could give them a huge jump they just haven't seen before, but they weren't ready for it yet. But they've experienced more now, and it's time to revisit things. They humor you. And, within half an hour, they admit they must have reeked of desperation more than a bit. They'd like to do what's needed to get through with things, and maybe we won't have to do anything too crazy." ;
            : print "You like the change, even if it's temporary. It's worth cashing in on, for you and him." ;
            : set_integer var="tempint" "43" ;
            : set_false "think_right_angles" ;
            : set_true "point_right_angles" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_right_angles) {
            : match "right _;_ angles" {
               : set_integer var="tempint" "43" ;
               : set_false "first_half" ;
               : match "right _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r20 : location "{r20_loc}" header="{r20_header}" graphic="r20_0" {
      on_command {
         : match "thud or;thud oar;thud ore" {
            : print {( point_yell_open ? "You wonder if summoning something that can make the door go THUD would open it. It's worth a try, but nothing heavy like an oar or ore would be stuck inside the cell. You try running into the door with a THUD. Nothing, but hey, it was worth a try. Maybe you need something less violent." : ("You wonder if you could've opened the door another way." + (point_say_four ? "\nYou take time to fetch an oar you bought and give it a whack just in case. Nothing. Still, hooray, exercise." : "") ) )} ;
            : set_true "bonus_point_thud_or" ;
            : gosub "add_bonus_point" ;
         }
         : match "_ wheeze;_ pace;_ wee;_ space" {
            : print {( point_yell_open ? "You're glad there's a way out." : "You may want to focus on specific parts of the space, or your reactions to it, to find a way out." )} ;
            : done ;
         }
         : match "_ floor" {
            : print {( point_thief_lore ? "Nothing else is hidden there." : point_can_do ? "Do you dare to dream something hidden in {puz_point_the_floor} might help you get out the door? What sort of reasoning could you use to find it without driving yourself more quickly?" : "You find nothing. You didn't think you would, anyway. Perhaps if you were more optimistic, you might." )} ;
            : done ;
         }
         : if (point_can_do && !won_yet) {
            : match "_ canned;_ ooh" {
               : print "It's weird. You shouldn't be reciting that since you got canned, but you are. Perhaps the answer to what it really means is simpler than you might thing." ;
               : done ;
            }
         }
         : if (point_thief_lore && !point_yell_open) {
            : match "_ yellow;_ pin" {
               : print "The yellow pin isn't much, but it's something. Perhaps you need a corresponding action to help it open the door." ;
               : done ;
            }
         }
         : match "_ door" {
            : print {( point_yell_open ? "It's open now." : "It's sturdy. It has a small hole where a big keyhole would normally be." )} ;
            : done ;
         }
         : if (!point_yell_open) {
            : match "_ hole;_ keyhole" {
               : print {( point_thief_lore ? "Just sticking the yellow pin in didn't quite do the trick. Perhaps you need to do something as well." : "Very small and round. Maybe you could find a key or key substitute to put in there. Or maybe you need to do something." )} ;
            }
         }
         : match "can do" {
            : if (point_can_do) {
               : print "You already showed you could, and you did. Time to move on." ;
               : done ;
            }
            : print "You shake off your feelings of dread. Momentarily, you laugh at your fears your employers will fire you once behavioral test and motion cameras detect your work ethic is about to fall off a cliff--perhaps they already have, and you're due in three to six months, and they're just waiting." ;
            : print "You recall, too, those people who always told you to put your head down and do things. They were TECHNICALLY correct, even if they weren't interested in things you did for yourself.";
            : print "So you put your head down. You must have done so particularly well, because suddenly, {puz_point_the_floor} seems very interesting." ;
            : set_integer var="tempint" "0" ;
            : set_true "point_can_do" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_can_do) {
            : match "can _;_ do" {
               : set_integer var="tempint" "0" ;
               : set_false "first_half" ;
               : match "can _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_can_do) {
            : match "thief lore" {
               : if (point_thief_lore) {
                  : print "You don't find anything else hidden in the floor." ;
                  : done ;
               }
               : print "You think back to what thief lore you might know. It's pretty superficial stuff. You managed to jimmy your own back door and also open a padlock combination you forgot, thanks to YouTube. Then, for weeks after, you were worried about your home or locker getting broken into, because it was so easy." ;
               : print "And yet this place seems lived in before. Scratchings on the floor mention that. Messy writing, but clues emerge. But nah, that stuff only happens on TV, and this is just a text adventure with low-res graphics!" ;
               : print "Yet, perhaps such a low budget environment is conducive to low-budget resolutions. And what do you know? You find something! A {puz_point_yellow_pin}! All right!" ;
               : print "The euphoria wears off after you find the pin, though. There's no lock to put it into, and it's too flimsy. But it's something." ;
               : set_true "point_thief_lore" ;
               : set_integer var="tempint" "1" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_thief_lore) {
               : match "thief _;_ lore" {
                  : set_integer var="tempint" "1" ;
                  : set_false "first_half" ;
                  : match "thief _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
         : if (point_thief_lore) {
            : match "yell open" {
               : if (point_yell_open) {
                  : print "No need to yell open again!" ;
                  : done ;
               }
               : print "The yellow pin glows and burns in your hand. You throw it at the door, reflexively. The pin sticks in the door! With a loud SSS, you watch a small hole expand. You see the lock mechanism. It's not hard to tinker now and open it from the inside and go {dir_e_y} now." ;
               : print "You're not complaining, but ... yell open, just like that? Where is the security here at this prison anyway? Do they WANT you to escape? You wonder if you should inform the management, but then again, if you did, you'd probably be the first person they threw back into the new improved cell. Best to keep quiet, then." ;
               : print "You remember with guilt keeping quiet and letting a jerk at school walk into a trap teachers had prepared. Until you remembered the things they said to push you away from the books you wanted to read, shows you wanted to watch, and so forth. Take what you can get." ;
               : print "The door open, you place the pin back under the floor where you found it, in case anyone else drops by, or is dropped by." ;
               : set_integer var="tempint" "2" ;
               : set_true "point_yell_open" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_yell_open) {
               : match "* pin" {
                  : print "You fumble with the pin a bit. Whatever you need to do with it doesn't require dexterity..." ;
                  : done ;
               }
               : match "yell _;_ open" {
                  : set_integer var="tempint" "2" ;
                  : set_false "first_half" ;
                  : match "yell _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r21 : location "{r21_loc}" header="{r21_header}" graphic= "r21_0" {
      on_command {
         : if (!point_fell_asleep && gamestate_r21_e) {
            : match "_ fellas;_ leap" {
               : print "You're not going to find anything about the fellas. It's too dark to the east. But maybe you can out-think them, or their leader, somehow." ;
               : done ;
            }
         }
         : if (!point_halt_error) {
            : match "_ hall;_ terror" {
               : print "It looks like something from horrible dreams you described to friends, who then told you to stop being boring and weird. You don't see any physical weakness. Maybe you can get inside the hall terror's mind. Or its controllers'." ;
               : done ;
            }
         }
         : if (point_halt_error && !point_fell_asleep) {
            : match "e _" {
               : cycle key = "r21_e_block" predictable_order = "true" skip_interval = "0" max_loops = "1" {
                  : print "The way seems a bit dark, but before you get too far {dir_e_n}, you hear a loud voice shout \"{puz_point_fellas_leap}!\" Nope, bad idea to go there as-is." ;
                  : print "Again, the voice {dir_e_n} yelling \"{puz_point_fellas_leap}!\"" ;
                  on_exhausted {
                     : print "Still, that voice yelling \"{puz_point_fellas_leap}!\"" ;
                  }
               }
               : set_true "gamestate_r21_e" ;
            }
         }
         : match "halt error" {
            : if (point_halt_error) {
               : print "There's no need to prevent things coming back." ;
               : done ;
            }
            : print "What good can such words do against a terror? But they're worth a try. Surprisingly, the terror lets up a bit. It seems to do some calculations then mentioned, you are not the optimal person to be terrorizing at the time, if you said something like that. It goes in search of other prey. You hear voices after this." ;
            : print "You're reminded of dreams you described to friends, things like the terror and how you couldn't stop it, and some time after your friends said stop being inane, you gained control. Here you got to do it in real life. You think." ;
            : set_integer var="tempint" "3" ;
            : set_true "point_halt_error" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_halt_error) {
            : match "halt _;_ error" {
               : set_integer var="tempint" "3" ;
               : set_false "first_half" ;
               : match "halt _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (gamestate_r21_e) {
            : match "fell asleep" {
               : if (point_fell_asleep) {
                  : print "You don't want to oversell this." ;
                  : done ;
               }
               : print "You consider shouting FELL ASLEEP first, but you quickly realize that's a spectacularly bad idea. Slowly, you start all questioning, then make your voice drowsier and drowsier, saying fell asleep, fall asleep, fall asleep. You can go {dir_e_y} now!" ;
               : set_integer var="tempint" "4" ;
               : set_true "point_fell_asleep" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_fell_asleep) {
               : match "fell _;_ asleep" {
                  : set_integer var="tempint" "4" ;
                  : set_false "first_half" ;
                  : match "fell _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
      on_describe {
         : if (point_pose_teasing && !gamestate_bros_second_placed) {
            : set_true "gamestate_bros_second_trigger" ;
         }
      }
   }
   r22 : location "{r22_loc}" header="{r22_header}" graphic="r22_0" {
      on_command {
         : if (point_free_crusty) {
            : match "_ free;_ crusty" {
               : gosub "r22_npc" ;
            }
         }
         : match "_ freak;_ rusty" {
            : gosub "r22_npc" ;
         }
         : match "_ field;_ erring" {
            : print {( point_feel_daring ? "You feel more confident navigating the field and other personal relationships." : "It's not a very big field, but you are worried about putting your feet wrong." )} ;
            : done ;
         }
         : match "feel daring" {
            : if (point_feel_daring) {
               : print "You don't want to engage in daring for the sake of daring. Sometimes, if you do too much of that, it burns you out for later. And you sense you have a good chunk of adventure to go." ;
               : done ;
            }
            : print "You can't exactly flip a switch to feel daring. Well, not super daring. But it is important to feel as though you can try stuff. To do so, you remember other times you were unexpectedly brave, in big or small things. Most of the time that involved not thinking too much, and you think about how you can avoid thinking too much until your head hurts. Still, you promise yourself that in the near future you'll try some small stuff you might not otherwise try." ;
            : set_integer var="tempint" "15" ;
            : set_true "point_feel_daring" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_feel_daring) {
            : match "feel _;_ daring" {
               : set_integer var="tempint" "15" ;
               : set_false "first_half" ;
               : match "feel _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (!point_free_crusty) {
            : match "free crusty" {
               : if (!point_feel_daring) {
                  : print "You don't have the courage to talk to the freak yet, sadly! You feel bad thinking of them that way." ;
                  : set_true "think_free_crusty" ;
               : collection_modify { collection = "tried_combo_core" index -> (16) content -> ("true") } ;
                  : gosub "note_thinks" ;
                  : done ;
               }
               : if (point_free_crusty) {
                  : print "You already helped the ex-freak see their individuality more productively." ;
                  : done ;
               }
               : print "You tell the freak, nonsense, you don't have to be a freak, and they say other people have said that and they call them even more of a freak for not finding a way. You've heard it from other people as well. But you say, well, why not frame it as nonconformism?" ;
               : print "You've had people say that to you, and you never quite believed it, so it feels weird. But then you realize certain names long since lost their sting, and you haven't let certain people distract you since, well, forever. You hate getting into turn-that-frown-upside-down \"philosophy,\" but it's worth it to remember certain people are, in fact, full of it, even if you can't prove that yet." ;
               : print "The (non-)freak nods. They go off for thought for a few minutes and come back happier." ;
               : set_integer var="tempint" "16" ;
               : set_false "think_free_crusty" ;
               : set_true "point_free_crusty" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_free_crusty) {
               : match "free _;_ crusty" {
                  : set_integer var="tempint" "16" ;
                  : set_boolean var="already_got_command" {( think_free_crusty && !point_free_crusty )} ; # this is optional. Delete if point does not rely on any other variables.
                  : set_false "first_half" ;
                  : match "free _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r23 : location "{r23_loc}" header="{r23_header}" graphic="r23_0" {
      on_command {
         : match "_ fray;_ measly" {
            : print {( point_frame_easily ? "You reflect on how you managed to stop the fray from growing." : "The fray is measly for now. That may give you some time to figure how to defuse it and, maybe, what outside boosts you might need." )} ;
            : done ;
         }
         : match "frame easily" {
            : if (!point_tense_ops) {
               : print "That feels right, but you're worried any simplified advice will just sound over-general." ;
               : print "Perhaps you might need to navigate even more minor conflicts or plans to ramp up before navigating this fray, even if it is measly!" ;
               : set_true "think_frame_easily" ;
               : collection_modify { collection = "tried_combo_core" index -> (30) content -> ("true") } ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (point_frame_easily) {
               : print "But you already dispersed the fray!" ;
               : done ;
            }
            : print "The fray, measly regards you suspiciously at first. You seem to talk a good game, but do you have any credentials? You show them the {iaad}. They're somewhat impressed. Then you describe how you worked with the sops and sorted things out together. \"The SOPS?\" both sides ask. \"They're hopeless! You got them to...?\"" ;
            : print "And just like that, the two opposing sides have something they can agree on! Talks go much more smoothly after that. You wonder why the heck they started arguing in the first place. The initial beefs seemed so trivial. But then again, you remember beefing with friends, or people who should've been friends, over much smaller things." ;
            : print "Both sides of the fray go off to start a new commune They say you're nice and all, but you just don't have the shared experience to really be one of them. You don't mind. You're not entirely sure how long the peace will last, to be honest." ;
            : set_integer var="tempint" "30" ;
            : set_false "think_frame_easily" ;
            : set_true "point_frame_easily" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_frame_easily) {
            : match "frame _;_ easily" {
               : set_integer var="tempint" "30" ;
               : set_boolean var="already_got_command" {( think_frame_easily && !point_frame_easily )} ; # this is optional. Delete if point does not rely on any other variables.
               : set_false "first_half" ;
               : match "frame _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r24 : location "{r24_loc}" header="{r24_header}" graphic="r24_0" {
      on_command {
         : match "_ war;_ makers" {
            : print {( point_warm_acres ? "No sign of them now." : "Very intimidating. You doubt reasoning or charisma will work with them. They look tougher to defuse than the fray, measly, from just back west. You might need serious help." )} ;
            : done ;
         }
         : if (!point_warm_acres) {
            : match "_ achers" {
               : print "They are already aching for war. More pain would just make them even more hostile." ;
               : done ;
            }
         }
         : match "warm acres" {
            : if (herd_score != 2) {
               : print {( "You don't have " + (herd_score == 1 ? "enough" : "anything") + " to try to warm the hearts of the war makers!" )} ;
               : set_true "think_warm_acres" ;
               : collection_modify { collection = "tried_combo_core" index -> (40) content -> ("true") } ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (point_warm_acres) {
               : print "It's already warmer and cozier here. We don't need to burn things up." ;
               : done ;
            }
            : print "What good can a bit of warmth do? Even if it is emotional warmth? Well, you try it, and somehow, the dogs and cats sense you're ready. They swarm over the area. Some of the makers absolutely loathe pets, and they flee right away. Other makers, mostly the recently initiated, actually are receptive to the dogs and cats." ;
            : print "Playing with pets is much more interesting than planning the war or whatever, even if it doesn't make folks feel as important. Among said folks are the girl's old parents, whom she points out to you." ;
            : print "They just look at her and shrug and run by. Harsh! But two others near say, wait, you're that kid they talked about, we feel bad about this, why don't you come with us at least temporarily. A dog and cat each follow as she goes. She waves goodbye to you, still holding her doll. You feel relieved--you weren't up to parenting, and you own't be even if you get out of here--but you'll still miss her. Everyone else disperses." ;
            : print "Now everyone's gone, you can see what's {dir_e_y}. Not much left {dir_w_v}." ;
            : destroy "only_girl" ;
            : set_integer var="tempint" "40" ;
            : set_false "think_warm_acres" ;
            : set_true "point_warm_acres" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_warm_acres) {
            : match "warm _;_ acres" {
               : set_integer var="tempint" "40" ;
               : set_boolean var="already_got_command" {( think_warm_acres && !point_warm_acres )} ; # this is optional. Delete if point does not rely on any other variables.
               : set_false "first_half" ;
               : match "warm _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r25 : location "{r25_loc}" header="{r25_header}" graphic="r25_0" {
      on_command {
         : if (gamestate_tried_beyond_r25) {
            : match "tune out" {
               : if (point_tune_out) {
                  : print "Your doubts are well and truly tuned out. Time to move on!" ;
                  : done ;
               }
               : print "You tune out your doubts yet again. There's some Don't Think of a Bear logic here. You can't meet them head-on, but you realize the doubts and fear of TO NOWT are a lot like other things you've seen, the HEY TRASH and the dull oozing and so forth, and even the fear of conflicts you helped settle. This is trivial by comparison. Perhaps you will be able to tune out this sort of thing subconsciously, with more practice." ;
               : set_integer var="tempint" "42" ;
               : set_true "point_tune_out" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_tune_out) {
               : match "_ ought;_ aught" {
                  : print "But it's to nowt, not to naught. An important pedantic difference! But one that may actually be simpler for you." ;
               }
               : match "tune _;_ out" {
                  : set_integer var="tempint" "42" ;
                  : set_false "first_half" ;
                  : match "tune _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
         : match "_ groom;_ thug;_ room" {
            : print {( gamestate_thug_gone ? "A lot less oppressive with the thug gone." : "The thug really takes up the room. So you can't see what's beyond. But this can't be the end, here." )} ;
            : done ;
         }
         : if (gamestate_tried_beyond_r25 && !point_tune_out) {
            : match "listen _" {
               : print "A voice from nowhere: {puz_point_to_nowt}." ;
               : done ;
            }
         }
         : if (gamestate_thug_gone && !point_tune_out) {
            : match "n _;s _;e _" {
               : if (verb_is "east") {
                  : print "East" ;
               }
               : if (noun1_is "east") {
                  : print "East" ;
               }
               : set_string var="tempstr" {( verb_is "east" ? "east" : verb_is "south" ? "south" : "north" )}
               : print {( !gamestate_tried_beyond_r25 ? ("As you approach the {tempstr} passage, the words {puz_point_to_nowt} light up beneath your feet. You don't see them down the other two passages. Ugh! Then you hear a voice kick in.") : "The words {puz_point_to_nowt} again light up under the {tempstr} passage. The voice continues." )} ; #?? THAT is not very descriptive. We can do better.
               : set_true "gamestate_tried_beyond_r25" ;
            }
         }
      }
      on_describe {
         : if (!gamestate_thug_gone && !gamestate_thug_chase) {
            : if (!gamestate_thug_activated) {
               : print "Oh no! An intimidating type glares down on you! Based on how it paces around, and indications not seen in the  graphic above, you know it must be a {trtg}." ;
               : set_true "gamestate_thug_activated" ;
            }
            : set_true "gamestate_thug_chase" ;
            : set_string var="lastroom" text="null" ;
            : set_false "gamestate_thug_pass" ;
            : update_graphic ;
         }
      }
   }
   r26 : location "{r26_loc}" header="{r26_header}" graphic="r26_0" {
      on_command {
         : if (point_bah_slumping && !point_say_mentoring) {
            : match "say mentoring" {
               : print "You give up and ask for help. The people who shut you in the tower appear. Good, you made it, they say. They discuss how they overheard you saying you feel unlucky and nothing happens to you. Well, now it did. And perhaps you might feel lucky now some of your actions and thoughts worked as they did. And not the sort of guilty-lucky, but the sort where you know you're relatively fortunate and want to take advantage of that when you can and not be jealous if others do. They apologize for the ... inconvenience. You figure it's okay. It was something to do, and then some." ;
               : print "You find it odd it's the third time you had to <SAY<#f80>> something, but was it really? You never did quite speak up enough, and you actually had to ask for what you wanted. There's a lesson here, one you probably should've learned years ago." ;
               : set_integer var="tempint" "47" ;
               : set_integer var="tempint" "47" ;
               : set_true "point_say_mentoring" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_say_mentoring) {
               : match "say _;_ mentoring" {
                  : set_integer var="tempint" "47" ;
                  : set_false "first_half" ;
                  : match "say _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
         : match "_ know;_ power;_ nope;_ hour" {
            : print {( "You think about power and its accumulation. You remember people accusing you of wanting it when you just wanted to feel less helpless around them.\n" + ( point_bah_slumping ? "They fooled you, but the boss did not." : "The {puz_point_boss_lumping} is another of them. Perhaps you can deflect them creatively? It doesn't have to be PERFECTLY logical." ) )} ;
            : done ;
         }
         : if (point_bah_slumping && !point_say_mentoring) {
            : match "e _" {
               : cycle key="mentor_door" predictable_order = "true" skip_interval = "0" max_loops = "1" {
                  : print "You walk through the door into a room exactly like the one you left. Actually, it is, because you look behind to the west, and there is {r25_header}. Which is sort of a relief. Maybe trying again will help. Maybe it won't." ;
                  : print "Once again, back where you came through the {puz_point_same_entering} door. You remember the cliche of how the definition of insanity is doing the same thing and expecting different results. Except, well, here, you're getting different results for the moment." ;
                  : print "Perhaps someone else has been through that door before you and gotten somewhere else." ;
                  : print "You try crawling, walking backwards, and somersaulting through the door. Always to the same place. What is the solution here?" ;
                  on_exhausted {
                     : print "Same action, same results. You're out of new ideas. You need some outside help to get by the door. How to ask for it." ;
                  }
               }
            }
         }
         : if (!point_bah_slumping) {
            : match "_ boss;_ lumping" {
               : print "They don't show any signs of letting up, but they don't show any signs of saying something new or original after their firs barrage." ;
               : done ;
            }
         }
         : if (!point_bah_slumping) {
            : match "baa _;baaa _;ba _" {
               : print "The {puz_point_boss_lumping} is irritated at you pretending to be one of the sheeple, but it's not enough." ;
            }
         }
         : match "bah slumping" {
            : if (!point_broke_lass) {
               : print {( "You lack conviction and support. " + (point_mage_urgent ? "Well, the mage gives some support, but not enough." : "Once you have it, you could send the boss slumping, though.") )} ;
               : set_true "think_bah_slumping" ;
               : collection_modify { collection = "tried_combo_core" index -> (46) content -> ("true") } ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (point_bah_slumping) {
               : print "Don't rub it in. The boss is long gone, anyway." ;
               : done ;
            }
            : print "Even though the boss doesn't seem to let up, you actually pretend that they are, and you have the backup to prove it. The gal and the mage can believably pretend they don't know each other, or you, that well, so it doesn't come off as a coordinated effort." ;
            : print "Of course, you all have been subjected to this game for much more nefarious reasons. The boss keeps letting you know what your problem is, and what else your problem is, and so forth. Sometimes two of the three of you are caught out, but someone always has a response." ;
            : print "\"Since OBVIOUSLY none of you want to even TRY to listen to honest criticism, I am so THROUGH here,\" yells the boss, who stomps off, mentioning nobody who needs to listen ever does." ;
            : print "There's not much else to say. You and the lass and mage vaguely promise to keep in touch, but after some discussion, you realize what different people you are. The mage has a lot to learn beyond spells and stuff. The lass has places to explore she put off. You? Well, you've had enough journeying. Almost." ;
            : print "Behind where the boss was, you see a door with text {puz_point_same_entering} on it." ;
            : set_integer var="tempint" "46" ;
            : set_false "think_bah_slumping" ;
            : set_true "point_bah_slumping" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_bah_slumping) {
            : match "bah _;_ slumping" {
               : set_integer var="tempint" "46" ;
               : set_boolean var="already_got_command" {( think_bah_slumping && !point_bah_slumping )} ;
               : set_false "first_half" ;
               : match "bah _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r27 : location "{r27_loc}" header="{r27_header}" graphic="r27_0" {
      on_command {
         : if (point_blest_able) {
            : match "listen _;_ true;_ pleading" {
               : print "The {puz_point_true_pleading} sounds like concerns you have, or had. Even the ones different, you can relate to, or you don't find them stupid. Perhaps you could share things with other seekers. But to do that you might have to show confidence in doing things beyond, well, just shuffling word sounds around. What could it be? Could you dare to take the jump?" ;
               : done ;
            }
         }
         : match "_ bleah;_ stable" {
            : print "Things aren't going to come crashing down here, but you hope for better than that bare minimum, and you wonder if others do, too." ;
            : done ;
         }
         : match "blest able" {
            : if (point_blest_able) {
               : print "At some point, there are diminishing or even negative returns for counting and re-counting your blessings. What will you do with them, around the true pleading?" ;
               : done ;
            }
            : print "Instead of feeling stagnant, you feel glad you have a chance to catch up on your own thought. You've had enough chaos and weirdness. You sit back and listen to your own thoughts. What mental blocks have you accepted too long? What small victories did you work hard to earn and then take for granted? What did you put off because it seemed too big, or too small, for the moment?" ;
            : print "A while of this, and you realize you're not just listening to your own thoughts. There is now a lot of {puz_point_true_pleading}, whispers coming from others you can't quite see, but they're there." ;
            : set_integer var="tempint" "48" ;
            : set_true "point_blest_able" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_blest_able) {
            : match "blest _;_ able" {
               : set_integer var="tempint" "48" ;
               : set_false "first_half" ;
               : match "blest _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_blest_able) {
            : match "troop leading" {
               : print "Well, it's certainly a big step to take. You've never thought of yourself as much of a leader. You're not going to be making big speeches in auditoriums that encourage people to change their lives. But perhaps you have more in common with people worth improving, people who want to improve, than you thought. The silly little victories along the way added up." ;
               : set_true "won_yet" ;
               : set_integer var="tempint" "49" ;
               : set_true "point_troop_leading" ;
               : gosub "add_point" ;
			   : print "Oh, hey. There's no real point in playing all the way through again. Well, you won't learn much if you REDO, and there are other IFComp games but you can find out about how I thought to make this game if ... well, you do something a little different." ;
               : win_game ;
               : done ;
            }
            : if (!point_troop_leading) {
               : match "troop _;_ leading" {
                  : set_integer var="tempint" "49" ;
                  : set_false "first_half" ;
                  : match "troop _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r30 : location "{r30_loc}" header="{r30_header}" graphic="r30_0" {
      on_command {
         : match "_ way;_ bland;_ wabe;_ land" {
            : print {( point_door_cloud ? "You found the door to unlock in the door cloud. There's not much else." : "The land itself is pretty tedious. Maybe focus on the {puz_point_dork_loud} to see if they can help you, however unwillingly or belligerently." )} ;
            : done ;
         }
         : if (!point_door_cloud) {
            : match "_ dork;_ loud" {
               : print "Just trying to get the {puz_point_dork_loud}'s attention won't work. You might have to ask them for what you want and make sure you can use or get to it." ;
               : done ;
            }
         }
         : match "door cloud" {
            : if (!point_tufty_key) {
               : print "The dork huffs, upset, \"If I don't know what sort of door you want, I can't search through the whole dork cloud on my own. I'm smart, but not that smart. Or maybe I am, but I'm smart enough to know that's not how best to use my brain. And to tell others when to smarten up. Geez!\"" ;
               : set_true "think_door_cloud" ;
               : collection_modify { collection = "tried_combo_core" index -> (22) content -> ("true") } ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (point_door_cloud) {
               : print "The tufty key won't fit any other doors." ;
               : done ;
            }
            : print "The dork yells at you to make sure that you have some way to get through a door, and when you show them the key, they just specifically say, oh, that one. Nobody's ever been through that one before. I don't know where it leads, but I guess if it's the only key you have, you might as well go see it. The earth shakes as the dork turns the key, and when you look around, the cloud is gone, having consumed the key, and there is only the door left, leading north." ;
            : destroy "tufty_key" ;
            : set_integer var="tempint" "22" ;
            : set_false "think_door_cloud" ;
            : set_true "point_door_cloud" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_door_cloud) {
            : match "door _;_ cloud" {
               : set_integer var="tempint" "22" ;
               : set_false "first_half" ;
               : match "door _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r31 : location "{r31_loc}" header="{r31_header}" graphic="r31_0" {
      on_command {
         : match "_ way;_ still;_ waste;_ ill" {
            : print {( point_hate_rash ? "You look around for anything, anything at all, but not much is here. This location feels liminal." : "The area is nondescript, but you keep hearing {puz_point_hey_trash}." )} ;
            : done ;
         }
         : if (!point_hate_rash) {
            : match "_ hey;_ trash" {
               : print "You aren't going to win a war of words so directly." ;
               : done ;
            }
         }
         : match "hate rash" {
            : if (point_hate_rash) {
               : print "The thing about heat, is once you've labeled it and such, and risen above it, you don't need to look back and maybe get stuck in it again." ;
               : done ;
            }
            : print "You see what's going on here, and while you hear some crying about how people don't want to be called trash, you set them straight saying, that sort of thing is trash, not the people, and you can do better if you'd be bothered." ;
            : print "There's an awkward pause. You worry whoever spoke will spew even more hateful speech to the next person, who's even less able to take it than you, and you should feel very very guilty about it. But then you think of times you actually stood up for yourself without lashing out and feared worse later -- and it never happened, or if it did, someone else stood up to it, and it got beaten back." ;
            : print "And more practically, you can now go all four directions." ;
            : set_integer var="tempint" "5" ;
            : set_true "point_hate_rash" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_hate_rash) {
            : match "hate _;_ rash" {
               : set_integer var="tempint" "5" ;
               : set_false "first_half" ;
               : match "hate _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r32 : location "{r32_loc}" header="{r32_header}" graphic="r32_0" {
      on_command {
         : match "listen _;_ chess;_ training" {
            : print {( point_dump_liars ? "It's silent now with the chess training over." : "It's tough to know whether or not the training is effective, but it sure is loud. Everybody is yelling about stuff like the Carlsbad pawn structure, or opening theory 15 lines down, or other things that just sort of make your head spin. Of course, there's always a person who yells you just have to sit there and make good moves, and they're shushed.\nYou remember some guy who was on the high school baseball team who said if you don't throw pieces away, you can get kind of good, and he was shocked." )} ;
            : done ;
         }
         : if (point_chest_reigning && !point_dump_liars) {
            : match "_ dumb;_ pliers" {
               : print "The chess players all call out \"TOOL AIM-TOO-LAME!\" as you consider picking it up. You have no snappy comeback. You sense you don't need a detailed one." ;
               : done ;
            }
         }
         : match "chest reigning" {
            : if (point_chest_reigning) {
               : print "One chest is enough. Don't get greedy." ;
               : done ;
            }
            : print "If chess is the sport of kings and Queens, then it makes sense that anything around it must be pretty royal, too. Surprisingly, nobody really stops their analysis, but when you open the chest, you find a pair of {puz_point_dumb_pliers}. The trainers say, come on, {puz_point_dumb_pliers}? That's just dumb. Not as interesting or fulfilling as chess analysis! But hey, it's something. You probably wouldn't be able to carry vast riches anyways. But you still feel a bit embarrassed taking the pliers." ;
            : set_integer var="tempint" "13" ;
            : set_true "point_chest_reigning" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_chest_reigning) {
            : match "_ raining" {
               : print "You don't need to make everyone wet here. But you're on the right track." ;
            }
            : match "chest _;_ reigning" {
               : set_integer var="tempint" "13" ;
               : set_false "first_half" ;
               : match "chest _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_chest_reigning && !point_dump_liars) {
            : match "dump liars" {
               : if (point_dump_liars) {
                  : print "They're already dumped, and convincingly." ;
                  : done ;
               }
               : print "Of course, you can't call them liars, but in your mind, you dump them and say, well, I can take responsibility for my actions if somehow there is a big electric surge through these pliers that makes me dumber, and anyway, it would be less of a loss than if it made you dumber, am I right?" ;
               : print "They recognize this is the most blow-off form of flattery, but what can they do? Instead of blocking you going east, they now seem as though they wish you really would go east as soon as possible. You are ruining their analysis just with your uncultured presence. Whatever you can do with the dumb pliers, it won't soar the intellectual heights they are achieving." ;
               : print "Small victories, yay!" ;
               : set_integer var="tempint" "14" ;
               : set_true "point_dump_liars" ;
               : gosub "add_point" ;
               : pocket "dumb_pliers" ;
               : done ;
            }
            : if (!point_dump_liars) {
               : match "dump _;_ liars" {
                  : set_integer var="tempint" "14" ;
                  : set_false "first_half" ;
                  : match "dump _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r33 : location "{r33_loc}" header="{r33_header}" graphic="r33_0" {
      on_command {
         : match "_ loners;loners _" {
            : print {( "On the contrary, the owners seem quite social. But " + (point_say_loaners ? "you don't need each other for anything, cold as it sounds." : "that sounds right...") )} ;
            : done ;
         }
         : match "_ sail;_ owners;sail _" {
            : print {( (point_say_loaners ? "You already have transport." : "It would be nice to buy transport, but how?") )} ;
            : done ;
         }
         : match "say loaners" {
            : if (!point_pitch_earning) {
               : print "But you have no money to even borrow a craft! Well, yet." ;
               : set_true "think_say_loaners" ;
               : collection_modify { collection = "tried_combo_core" index -> (18) content -> ("true") } ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (!point_say_four) {
               : print "But you have nothing to steer a craft!" ;
               : set_true "think_say_loaners" ;
               : collection_modify { collection = "tried_combo_core" index -> (18) content -> ("true") } ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (point_say_loaners) {
               : print "You used up the last ogf your money. You have the transportation you need." ; #//got/had/needed?
               : done ;
            }
            : print "You don't have MUCH. You almost feel awkward asking for anything. You get, not a great sailboat, but a more modest Mo'-Tried-Moat-Ride. And thus, your riches disappear. But you can go north onto the water! You still wonder if you really belong with the bigger fancier boats, but if you were somehow gifted a bigger fancier boat, you'd probably feel you didn't belong, too." ;
            : set_integer var="tempint" "18" ;
            : set_false "think_say_loaners" ;
            : set_true "point_say_loaners" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_say_loaners) {
            : match "say _;_ loaners" {
               : set_integer var="tempint" "18" ;
               : set_boolean var="already_got_command" {( think_say_loaners && !point_say_loaners )} ; # this is optional. Delete if point does not rely on any other variables.
               : set_false "first_half" ;
               : match "say _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r34 : location "{r34_loc}" header="{r34_header}" {
      on_command {
         : if (!point_ply_towels) {
            : match "_ plight;_ owls" {
               : print "They look cold and wet, too waterlogged to fly away. They're guarding a nook to the north, one you could walk through if they weren't there. How could you dry them?" ;
               : done ;
            }
         }
         : match "_ soak;_ thus;_ oak" {
            : print {( point_ply_towels ? "You showed the oak what's what, and you really don't want to attract any negative attention." : "You're not sure what the owls did to make the oak soak them, but the oak looks really upset at them. Anything you say or do will leave it unmoved. And not just physically!" )} ;
            : done ;
         }
         : match "ply towels" {
            : if (point_ply_towels) {
               : print "The owls are nice and dry now and don't need any more towels." ;
               : done ;
            }
            : if (!point_cloth_robbing) {
               : print "That seems right. But you have no towels, or things that could be passed off as towels, to ply. Yet." ;
               : set_true "think_ply_towels" ;
               : collection_modify { collection = "tried_combo_core" index -> (28) content -> ("true") } ;
               : gosub "note_thinks" ;
               : done ;
            }
            : print "You don't have enough towels to dry off all the owls at once. The oak laughs about this as you head back to the claw, to get a few more. Drying the owls alone doesn't work. You need to provide a weird lean-to of towels, but fortunately, there's enough debris around. Eventually the drier owls can fly, and the oak realizes the game is up. It -- well, trees can't skulk off, but it sure looks hurt." ;
            : print "The owls hoot their appreciation. Since they don't have to huddle flightless to the north, they start flapping in the air. You call them over to hand them the pliers in case this happens again. The pliers are surprisingly lightweight, and two owls can work it with one foot each, which strikes you as not dumb at all." ;
            : set_integer var="tempint" "28" ;
            : set_false "think_ply_towels" ;
            : set_true "point_ply_towels" ;
            : destroy "dumb_pliers" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_ply_towels) {
            : match "ply _;_ towels" {
               : set_integer var="tempint" "28" ;
               : set_boolean var="already_got_command" {( think_ply_towels && !point_ply_towels )} ; # this is optional. Delete if point does not rely on any other variables.
               : set_false "first_half" ;
               : match "ply _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r35 : location "{r35_loc}" header="{r35_header}" graphic="r35_0" {
      on_command {
         : if (is_present "major_gent" ) {
            : match "_ major;_ gent" {
               : print "A bit of a nonentity. You cringe at his politeness, and you cringe wondering if he notices you cringed." ;
               : done ;
            }
         }
         : match "mage urgent" {
            : if (point_mage_urgent) {
               : print "The mage/gent already got a sense of urgency. It's a sense you have no wish to turbo-charge." ;
               : done ;
            }
            : print "The major gent slowly starts talking louder and faster, and it gets to the point where you can't interrupt him. He starts mentioning times he felt ripped off, and how he needs to take things back and Show Them, whoever they are. He finally gets around to asking you what you're doing, and you mention you're not sure, you just wound up here. He says, well, obviously you haven't finished it yet so maybe you need some help." ;
            : print "From being too passive to utterly lacking subtlety! It might be a step up -- if people's faults are visible, they're easier to correct -- but all the same, he still needs adjustment. Where to find it?" ;
            : set_integer var="tempint" "44" ;
            : set_true "point_mage_urgent" ;
            : destroy "major_gent" ;
            : create "mage_urgent" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_mage_urgent) {
            : match "mage _;_ urgent" {
               : set_integer var="tempint" "44" ;
               : set_false "first_half" ;
               : match "mage _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : match "broke lass" {
            : if (point_broke_lass) {
               : print "She's already been summoned. You're done here." ;
               : done ;
            }
            : print {( think_broke_lass ? "You summon the broke lass again." : "There is, in fact, a broke lass hiding around. She asks if the thug is gone. You say yes." )} ;
            : if (!point_mage_urgent) {
               : print "But she sees the major gent and whispers to you that she just doesn't want to put up with his drenching self-pity  right now. You have to admit, he's almost too much for you. He needs change, somehow." ;
               : set_true "think_broke_lass" ;
               : collection_modify { collection = "tried_combo_core" index -> (45) content -> ("true") } ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (!point_right_angles) {
               : print "But the mage, urgent, is a bit too bombastic. The Broke Lass doesn't think much of him. He's not as bad as the thug, but ... she can wait.\nYou'll need to change him, again, or perhaps affect his own change from within, before you can gain a new companion." ;
               : set_true "think_broke_lass" ;
               : collection_modify { collection = "tried_combo_core" index -> (45) content -> ("true") } ;
               : gosub "note_thinks" ;
               : done ;
            }
            : print "The broke lass peers around. She takes a deep breath and rolls her eyes on seeing the mage." ;
            : print "The mage says \"Let's get things done so we can get on with our lives.\" It's not poetry, but it's about what the broke lass needs to hear. She mentions she's probably stayed too long. She could've snuck out earlier if she'd really planned. And yet she wants to know who stuck her here, and why. So does he. So do you." ;
            : print {( "After some consultation, the three of you agree you're ready to deal with " + (has_visited "r26" ? "whatever's to the east." : "the {point_puz_boss_lumping} to the east, who seems the most likely candidate." ) )} ;
            : set_integer var="tempint" "45" ;
            : set_false "think_broke_lass" ;
            : set_true "point_broke_lass" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_broke_lass) {
            : match "broke _;_ lass" {
               : set_integer var="tempint" "45" ;
               : set_boolean var="already_got_command" {( think_broke_lass && !point_broke_lass )} ;
               : set_false "first_half" ;
               : match "broke _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
      on_describe {
         : if (is_present "major_gent") {
            : if (!gamestate_gent_intro) {
               : print "A {puz_point_major_gent} stands up and greets you, perhaps a bit too politely. You've dealt with folks like this, not doing any harm but not ready to do any good." ;
               : set_true "gamestate_gent_intro" ;
            } : else {
               : print "The {puz_point_major_gent} continues to move around nervously." ;
            }
         }
      }
   }
   r40 : location "{r40_loc}" header="{r40_header}" graphic="r40_0" {
      on_command {
         : if (!point_shape_up) {
            : match "_ pup" {
               : print "There should be dogs here, but apparently you aren't in a condition for them to be friendly. What can you do? Probably nothing too off the wall or complex." ;
               : done ;
            }
         } : else {
            : match "_ daww;_ daw;_ gold;_ dog;_ old" {
               : print {( point_warm_acres ? "You reflect on the brief happy times with your dog friend." : point_heard_all ? "The dog lopes around happily. Its friends must be doing so too out of sight, waiting for when you need them." : "The dog lopes around, unconcerned." )} ;
               : done ;
            }
         }
         : match "shape up" {
            : if (point_shape_up) {
               : print "You already shaped up." ;
               : done ;
            }
            : print "You take some time to get your head on straight. Yes, it's a bit weird here, but you recognize you want to help people, and maybe there are people or entities who want to help you. The dog feels a bit more relaxed around you now. Perhaps it could show you more later." ;
            : set_integer var="tempint" "37" ;
            : set_true "point_shape_up" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_shape_up) {
            : match "shape _;_ up" {
               : set_integer var="tempint" "37" ;
               : set_false "first_half" ;
               : match "shape _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r41 : location "{r41_loc}" header="{r41_header}" {
      on_command {
         : if (!point_eh_sink) {
            : match "_ ace;_ inc" {
               : print "Ugh! It's so dreary to look at. It's a monolith of automation. You doubt any technology can stop it. What could?" ;
               : done ;
            }
            : match "* sync;sync _" {
               : print "You might want to get {puz_point_ace_inc} out of sync. Sounds right, though." ;
               : done ;
            }
         } : else_if (!point_cue_bland) {
            : match "_ cube;_ land" {
               : print "The cubes are all so garish. You wonder why they need to be, what is inside or behind them, where and how to look for it." ;
               : done ;
            }
         }
         : match "eh sink" {
            : if (point_eh_sink) {
               : print "{puz_point_ace_inc} already sank!" ;
               : done ;
            }
            : print "Ace, Inc. slowly sinks. You hope the message about no humans being there is true. You hear no screams or confusions, just robots whirring and glitching." ;
            : print "What is revealed is a garish {puz_point_cube_land}." ;
            : set_integer var="tempint" "26" ;
            : set_true "point_eh_sink" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_eh_sink) {
            : match "a sink;sink _" {
               : print "Right idea, but a giant sink might be impassable. Or it might drown you. And {puz_point_ace_inc} couldn't be changed to a SMALL sink." ;
               : done ;
            }
            : match "eh _;_ sink" {
               : set_integer var="tempint" "26" ;
               : set_false "first_half" ;
               : match "eh _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_eh_sink) {
            : match "cue bland" {
               : if (point_cue_bland) {
                  : print "You already worked your way through this place." ;
                  : done ;
               }
               : print "It only makes sense, doesn't it? With all the garish stuff, the dull stuff will in its way stand out, often is something that's not trying to impress you but maybe valuable, or that only people who are dazzled by silliness would be able to find and use. At the end, you find a simple coupon saying, {puz_point_vie_neater}. It doesn't specify how to buy, or how to be neater, but perhaps the people you summon with it will know all that. Well, it's something at any rate." ;
               : pocket "vie_neater" ;
               : set_integer var="tempint" "27" ;
               : set_true "point_cue_bland" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_cue_bland) {
               : match "queue _" {
                  : print "Hmm. It's unlikely you'll find people or entities queueing up for where to find something. But there might be a similar indicator. Or similar sounding indicator." ;
               }
               : match "cue _;_ bland" {
                  : set_integer var="tempint" "27" ;
                  : set_false "first_half" ;
                  : match "cue _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r42 : location "{r42_loc}" header="{r42_header}" graphic="r42_0" {
      on_command {
         : match "_ seacrest;_ sea;_ crest" {
            : print {( point_seek_rest ? "It's kind of relaxing to look at. Perhaps it leads to bigger things, if observed correctly." : "You're glad it helped you find a less gloomy part of the island." )} ;
            : done ;
         }
         : if (point_seek_rest && !point_girl_only) {
            : match "_ grr;_ grrr;_ lonely ;listen _" {
               : print "The GRR seems artificial. You can't put your finger on it." ;
               : done ;
            }
         }
         : match "_ gray;_ vile;_ grave;_ isle" {
            : print {( "It's quite expansive. You'd probably be in danger exploring too much. " + ( point_girl_only ? "You've gotten a companion. You both should probably leave." : "There should be something worthwhile here -- find it and get out, you reckon." ) )} ;
            : done ;
         }
         : match "seek rest" {
            : if (point_seek_rest) {
               : print "You already sought and found." ;
               : done ;
            }
            : print "You find it, but just as you're really starting to rest, you hear a {puz_point_grr_lonely}. You can't sleep with that around!" ;
            : set_integer var="tempint" "31" ;
            : set_true "point_seek_rest" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_seek_rest) {
            : match "seek _;_ rest" {
               : set_integer var="tempint" "31" ;
               : set_false "first_half" ;
               : match "seek _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_seek_rest) {
            : match "girl only" {
               : if (point_girl_only) {
                  : print "It would be belittling to repeat this reasoning in front of her." ;
                  : done ;
               }
               : print "You look for the source of the girl, and it does sound a bit put on, and you wonder if it is somebody just trying to intimidate people. Sure enough, you find a small girl towering off to the side, holding {puz_point_her_doll}. She says, did my parents bring me to pick me up? You say no, you don't know who her parents are. She said, well, my parents had me stay here to avoid the really scary bits, but it was scary enough here, but they wouldn't mislead me, right? You don't know what to say to this, but you can only suggest that you should help her find them. She doesn't sound too enthusiastic about this car but she's sick of the island, and you will be glad for the company of her. And, of course, {puz_point_her_doll}." ;
               : set_integer var="tempint" "32" ;
               : set_true "point_girl_only" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_girl_only) {
               : match "girl _;_ only" {
                  : set_integer var="tempint" "32" ;
                  : set_false "first_half" ;
                  : match "girl _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r43 : location "{r43_loc}" header="{r43_header}" graphic="r43_0" {
      on_command {
         : match "_ float;_ rippling" {
            : print {( point_flow_tripling ? "Fast enough to use as transport." : "It barely makes your craft move at all. You need it to pick up a bit." )} ;
            : done ;
         }
         : if (point_flow_tripling) {
            : match "_ flow;_ tripling" {
               : print "It kind of circles around without making a big vortex in the center, so you can go where you need to, {r43_dir_w} or back {dir_s_v}." ;
               : done ;
            }
         }
         : match "flow tripling" {
            : if (point_flow_tripling) {
               : print "Tripling the flow again would probably capsize your craft. It's like compound interest, only it gets places quicker. The wrong places." ;
               : done ;
            }
            : print "Finally, the waters are less calm, and fortunately, they're not rough enough to drag you places, but you see where the currents are, and there's one that flows pretty reliably to the {dir_w_y}. You can take it now, if you want." ;
            : set_integer var="tempint" "23" ;
            : set_true "point_flow_tripling" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_flow_tripling) {
            : match "flow _;_ tripling" {
               : set_integer var="tempint" "23" ;
               : set_false "first_half" ;
               : match "flow _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r44 : location "{r44_loc}" header="{r44_header}" graphic="r44_0" {
      on_command {
         : match "_ ten;_ sops" {
            : print {( "The sops crowding inside this building " + (!point_tense_ops ? "look very unsure of themselves but also suspicious of outside help." :  "seem happy now, not really pressing for whatever their plan is. They don't need any more outside help." ) )} ;
            : done ;
         }
         : match "tense ops" {
            : if (!point_me_growth) {
               : print "You just don't have the wherewithal to deal with tension yet! Still, good idea for later." ;
               : set_true "think_tense_ops" ;
               : collection_modify { collection = "tried_combo_core" index -> (29) content -> ("true") } ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (point_tense_ops) {
               : print "You already acknowledged and defused the tension." ;
               : done ;
            }
            : print "You get their eternal thanks for sorting things out. Which isn't fungible, but it is a confidence booster." ;
            : set_integer var="tempint" "29" ;
            : set_false "think_tense_ops" ;
            : set_true "point_tense_ops" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_tense_ops) {
            : match "tense _;_ ops" {
               : set_integer var="tempint" "29" ;
               : set_boolean var="already_got_command" {( think_tense_ops && !point_tense_ops )} ; # this is optional. Delete if point does not rely on any other variables.
               : set_false "first_half" ;
               : match "tense _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
}

# Defines things in the world (scenery cannot be carried)
objects {
   # on you at all times
   phase_tats : object "{i_fspt}" ;

   # objects that come and go
   coin : object "Not much, but it's something." conspicuous = "false" ;
   dumb_pliers : object "Sturdy. Pliers don't have to be smart." conspicuous = "false" ;
   dumb_parable : object "Man. It's pretty dumb." conspicuous = "false" ;
   four_oars : object "You got those four oars from {here_r10}." conspicuous = "false" ;
   only_girl : object "She is holding {puz_point_her_doll}." conspicuous = "false" ;
   riches : object "The lesser of the titan's riches." conspicuous = "false" ;
   towels : object "The towels from under the claw." conspicuous = "false" ;
   tufty_key : object "The tufty key from the tough tiki" conspicuous = "false" ;
   vie_neater : object "The VIE NEATER voucher you got from the Cue, Bland" ;

   # fixed items
   wry_tangles : object "Very interesting, but not quite for you." at = "r15" conspicuous="false" ;

   # npc who follow you, friendly or unfriendly
   major_gent : object "A bit too nice here." at = "r35" conspicuous = "false" ;
   mage_urgent : object "The former major gent has now swung a bit too much the other way." conspicuous = "false" ;
   broke_lass : object "The broke lass doesn't seem that broke, or broken, now." conspicuous = "false" ;
   thug : object "{trtg_status}." at = "r25" conspicuous = "false" ;
}

zones {
   top_zone : zone {
      locations = [ r30, r31, r32, r33, r34, r40, r41, r42, r43, r44 ]
   }
   middle_zone : zone {
      locations = [ r20, r21, r22, r23, r24 ]
   }
   bottom_zone : zone {
      locations = [ r00, r01, r02, r03, r04, r10, r11, r12, r13, r14 ]
   }
   end_zone : zone {
      locations = [ r25, r26, r27, r15, r35 ]
   }
}

connections {

   from, direction, to = [
      r20, east, r21,
      r21, north, r31,
      r21, south, r11,
      r21, east, r22,
      r22, east, r23,
      r23, east, r24,
      r24, east, r25,
      r25, east, r26,
      r25, north, r35,
      r25, south, r15,
      r26, east, r27,
      r31, north, r41,
      r31, west, r30,
      r31, east, r32,
      r30, north, r40,
      r32, east, r33,
      r33, east, r34,
      r33, north, r43,
      r34, north, r44,
      r43, west, r42,
      r11, west, r10,
      r11, east, r12,
      r11, south, r01,
      r01, west, r00,
      r01, east, r02,
      r12, east, r13,
      r13, east, r14,
      r13, south, r03,
      r03, east, r04,
      r14, south, r04
      ## this is one that is not revealed until late
   ]

}

barriers {

   # general block going

   # r00 free movement from r01

   block_go_r01 : block {
      location = r01
      block_when_not = point_duh_losing
      message = {block_dull_oozing}
   }

   # r02 free movement from r01

   block_go_r03 : block {
      location = r03
      block_when_not = point_pose_teasing
      message = {block_pose_teasing}
   }

   block_go_r03_p2 : block {
      location = r03
      block_when = r13_secondary_block
      message = {block_weep_lucky}
   }

   # r04 free movement from r01, sort of

   block_secret_r04 : block {
      location = r04
      block_when = gamestate_no_oops_yet
      message = {block_04_14}
   }

   block_go_r10 : block {
      location = r10
      block_when_not = point_duh_losing
      message = {block_dull_oozing}
   }

   block_go_r11 : block {
      location = r11
      block_when_not = point_halt_error
      message = {hall_terror_blocks}
   }

   block_go_r12 : block {
      location = r12
      block_when_not = point_duh_losing
      message = {block_dull_oozing}
   }

   block_go_r13 : block {
      location = r13
      block_when_not = point_no_injuries
      message = The {puz_point_knowin_juries} scold you. "It might not be safe. You never know. What if you have, like, pre-existing conditions?" They outnumber you. How to convince them you're willing to take that risk, that you'd be safe? Or, at the very least, not worth bugging?"
   }

   block_go_r14 : block {
      location = r14
      block_when_not = point_pose_teasing
      message = {block_pose_teasing}
   }

   block_secret_r14 : block {
      location = r14
      block_when = gamestate_no_oops_yet
      message = {block_04_14}
   }

   block_go_r14_p2 : block {
      location = r14
      block_when = r13_secondary_block
      message = {block_weep_lucky}
   }

   block_go_r15 : block {
      location = r15
      block_when_not = gamestate_thug_gone
      message = {block_trrg}
   }

   block_go_r21 : block {
      location = r21
      block_when_not = point_yell_open
      message = THE DOOR blocks you.
   }

   block_go_r22 : block {
      location = r22
      block_when_not = point_halt_error
      message = {hall_terror_blocks}
   }

   block_go_r22_fellas : block {
      location = r22
      block_when = r22_secondary_block
      message = You need to make sure the {puz_point_fellas_leap} order is neutralized.
   }

   block_go_r23 : block {
      location = r23
      block_when_not = point_free_crusty
      message = The {puz_point_freak_rusty} to the east regales you with tales of potentially horrible things east. I mean, they're not dangerous, but you feel like you could help them first.
   }

   block_go_r24 : block {
      location = r24
      block_when_not = point_frame_easily
      message = Not with the fray going on.
   }

   block_go_r25 : block {
      location = r25
      block_when_not = point_warm_acres
      message = The war hasn't started yet, but perhaps it's a good idea to prevent it. You let these people plan long enough, they seem harmless, but they aren't.
   }

   block_go_r26 : block {
      location = r26
      block_when_not = gamestate_thug_gone
      message = {block_trrg}
   }

   block_go_r27 : block {
      location = r27
      block_when_not = point_bah_slumping
      message = The {puz_point_boss_lumping} insults at you won't let you buy.
   }

   block_go_r30 : block {
      location = r30
      block_when_not = point_hate_rash
      message = {block_hey_trash}
   }

   block_go_r31 : block {
      location = r31
      block_when_not = point_halt_error
      message = {hall_terror_blocks}
   }

   block_go_r32 : block {
      location = r32
      block_when_not = point_hate_rash
      message = {block_hey_trash}
   }

   block_go_r33 : block {
      location = r33
      block_when_not = point_dump_liars
      message = \"You don't know what's that way! You need to calculate all the possibilities before you move!\" They're probably wrong, but what if they're not?
   }

   # r34 free movement from r33

   block_go_r35 : block {
      location = r35
      block_when_not = gamestate_thug_gone
      message = {block_trrg}
   }

   block_go_r40 : block {
      location = r40
      block_when_not = point_door_cloud
      message = \"Uggggh, let me tell you, kid-o,\" says the {puz_point_dork_loud}. \"Ain't a DANG THING to the north here. Not that you deserve to see anywhere interesting. Just, I'm saving you from your own worst urges. Why does it always fall to me?\" The {puz_point_dork_loud} then proceeds to disparage people who have too-slick social skills.
   }

   block_go_r41 : block {
      location = r41
      block_when_not = point_hate_rash
      message = {block_hey_trash}
   }

   block_go_r42 : block {
      location = r42
      block_when_not = point_flow_tripling
      message = The lake is too calm to sail to the west at the moment.
   }

   block_go_r43 : block {
      location = r43
      block_when_not = point_say_loaners
      message = You'll need a boat to get on the water.
   }

   block_go_r44 : block {
      location = r44
      block_when_not = point_ply_towels
      message = The plight owls outnumber you, and they want you to understand or alleviate their plight before making way to the north. They're just barely hiding out as-is.
   }

   # block going with HONE/bonus
   block_core_r00 : block {
      location = r00
      block_when = backblock_00
      message = You got the cats together. They'll be available when needed.
   }
   block_core_r01 : block {
      location = r01
      block_when = backblock_01
      message = You have done everything you needed to the south.
   }
   block_core_r02 : block {
      location = r02
      block_when = backblock_02
      message = You got the riches from the titan in the pit.
   }
   block_core_r03 : block {
      location = r03
      block_when = backblock_03
      message = You found the key and interpreted the message beyond it.
   }
   block_core_r04 : block {
      location = r04
      block_when = backblock_04
      message = You interpreted the message.
   }

   block_core_r10 : block {
      location = r10
      block_when = backblock_10
      message = You got the oars. They'll be available when needed.
   }
   block_core_r11 : block {
      location = r11
      block_when = backblock_11
      message = You have done everything you needed to the south.
   }
   block_core_r12 : block {
      location = r12
      block_when = backblock_12
      message = You have done all you needed to past the judges.
   }
   block_core_r13 : block {
      location = r13
      block_when = backblock_13
      message = You have done all you needed to past the bros.
   }
   block_core_r14 : block {
      location = r14
      block_when = backblock_14
      message = You got the cloth from under the claw.
   }

   block_core_r20 : block {
      location = r20
      block_when = backblock_20
      message = You have nothing left to do back where you started.
   }
   block_core_r21 : block {
      location = r21
      block_when = backblock_21
      message = {blockstr_go_fwd}
   }
   block_core_r22 : block {
      location = r22
      block_when = backblock_22
      message = You're done in the back areas. Time to go forward.
   }
   block_core_r23 : block {
      location = r23
      block_when = backblock_23
      message = You're done in the back areas. Time to go forward.
   }
   block_core_r24 : block {
      location = r24
      block_when = backblock_24
      message = You're done in the back areas. Time to go forward.
   }

   block_core_r30 : block {
      location = r30
      block_when = backblock_30
      message = You have done everything you needed behind the door.
   }
   block_core_r31 : block {
      location = r31
      block_when = backblock_31
      message = You have done everything you needed to the north.
   }
   block_core_r32 : block {
      location = r32
      block_when = backblock_32
      message = You got what you needed from the isle and the (ex-)sops.
   }
   block_core_r33 : block {
      location = r33
      block_when = backblock_33
      message = You got what you needed from the isle and the (ex-)sops.
   }
   block_core_r34 : block {
      location = r34
      block_when = backblock_34
      message = You helped the ten sops. They don't need any more.
   }

   block_core_r40 : block {
      location = r40
      block_when = backblock_40
      message = You acquired canine friends and won't need to go back to poke around for them.
   }
   block_core_r41 : block {
      location = r41
      block_when = backblock_41
      message = You took care of Ace, Inc.
   }
   block_core_r42 : block {
      location = r42
      block_when = backblock_42
      message = You got a companion on the isle.
   }
   block_core_r43 : block {
      location = r43
      block_when = backblock_43
      message = You got a companion on the isle.
   }
   block_core_r44 : block {
      location = r44
      block_when = backblock_44
      message = You helped the ten sops. They don't need any more.
   }

   block_core_r26 : block {
      location = r26
      block_when = backblock_26
      message = This is the end of your journey.
   }
   block_core_r25 : block {
      location = r25
      block_when = backblock_25
      message = {blockstr_endgame_npcs}.
   }
   block_core_r15 : block {
      location = r15
      block_when = backblock_15
      message = {blockstr_endgame_npcs}.
   }
   block_core_r35 : block {
      location = r35
      block_when = backblock_35
      message = You showed the mage the book, and that's enough.
   }

}

subroutines {
# first standard verbs
# second auxiliary
# third options
# fourth game specific GOTO
# fifth noun keywords
# sixth TESTJUMP

   take_inventory : subroutine {
      : if (score < 2) {
         : print "Nothing in your hands." ;
         : return ;
      }
      : if (score == 2) {
         : print "Well, you now have a yellow pin, which is something." ;
         : return ;
      }
      : if (score > 40) {
         : if (!point_bah_slumping && point_mage_urgent) {
            : print {( "You have " + (point_broke_lass ? "two allies in the mage, urgent and the (formerly) broke lass." : "an ally in the mage, urgent." ) )} ;
         }
         : print "You're carrying nothing, but surely all you need is your keen wit and insight to finish things off. You hope." ;
         : return ;
      }
      : set_false "inventory_intangibles" ;
      : if (is_carried "dumb_parable") {
         : print "You have a dumb parable stuck in your head. Perhaps it would help to fob it off on someone else." ;
      }
      : if (is_carried "coin") {
         : print "You have that {cnco} from the juries. Where to spend or increase it?" ;
      }
      : if (is_carried "riches") {
         : print {( "You've acquired riches from the pit. " + (point_say_four ? "You bought four oars with it, but you have a good chunk left over." : "They might buy a couple things you need.") )} ;
      }
      : if (is_carried "dumb_pliers") {
         : print {( "The dumb pliers you got from the chest " + (point_cloth_robbing ? "got some fluffy square cloths you're also carrying." : "could be useful to grab something later.") )} ;
      }
      : if (is_carried "tufty_key") {
         : print "The tough tiki left you a tufty key." ;
      }
      : if (is_carried "vie_neater") {
         : print "You have that coupon promising to {puz_point_vie_neater} you got from the cube land." ;
      }
      : if (point_say_four && !point_say_loaners) {
         : print "The four oars you bought are waiting {here_r10} until you buy a suitable craft." ;
         : set_true "inventory_intangibles" ;
      }
      : if (is_carried "riches") {
         : print {( point_say_four ? "You still have some riches left over from the titan and the pit." : "You have some riches the titan left in the pit." )} ;
      }
      : if (point_me_growth && !point_tense_ops) {
         : print "You felt some growth from the meager oath but didn't find anywhere to share or use it meaningfully yet." ;
         : set_true "inventory_intangibles" ;
      }
      : if (point_say_loaners && !point_girl_only) {
         : print "You bought a {mtmr} which can dock {here_r33}." ;
         : set_true "inventory_intangibles" ;
      }
      : if (point_tense_ops && !point_frame_easily) {
         : set_true "inventory_intangibles" ;
         : print "You have an {iaad} the ten sops gave you. It reminds you to have more confidence in yourself after helping them. Maybe you can tackle bigger things!" ;
      }
      : if (!point_warm_acres && point_girl_only) {
         : print {( "You have a loyal follower in the girl from the island. She's carrying {puz_point_her_doll} around." + (carried() == 0 && !inventory_intangibles ? " And companionship's more important than silly old possessions!" : "" ) )} ;
         : set_true "inventory_intangibles" ;
      }
      : if (!point_warm_acres && herd_score > 0) {
         : print {( "You've gained support from " + ((herd_score == 2) ? "cats and dogs in the western corners of the map" : point_herd_all ? "cats {here_r00}" : "dogs {here_r40}") )} ;
         : set_true "inventory_intangibles" ;
      }
      : if (carried() == 0 && !inventory_intangibles) {
         : print "You're not carrying anything at the moment, tangible or intangible." ;
         : return ;
      }
   }
   listen_stub : subroutine {
      : if (is_present "thug") {
         : set_true "gamestate_thug_pass" ;
         : print "You hear the thug hyperventilating. It's bulky but not fast." ;
      }
      : if (is_at "r00") {
         : if (point_fly_traps) {
            : print "Rustling from the cat as it hunts." ;
         }
      } : else_if (is_at "r02") {
         : print {( !point_tightened_rousing ? "The titan is snoring, but it's very bearable." : "Quiet with the titan awake." )} ;
      } : else_if (is_at "r11") {
         : print {( point_duh_losing ? "You enjoy the silence and lack of dull oozing words. You can't resist refuting what you remember of them, though." : "The {puz_point_dull_oozing} makes you wonder why bother. The world beyond the tower must be even riskier than the tower! And so forth." )} ;
      } : else_if (is_at "r12") {
         : print "The judges hem and haw most judgefully. Not quite judgingly or judgementally. They're mostly remarking that's how the world is these days, and that sort of thing." ;
      } : else_if (is_at "r13") {
         : if (gamestate_bros_blocking) {
            : print "The {bros} won't stop talking. And, more important, blocking the way forward." ;
         }
      } : else_if (is_at "r20") {
         : print {( point_yell_open ? "A small voice whispers \"Adventure on!\"\nFor some reason, you expected one praising you with \"In form.\"" : "You hear nothing but occasionally mutter to yourself <rue my room, aye<#888>>." )} ;
      } : else_if (is_at "r21") {
         : print {( point_fell_asleep ? "It's quiet now." : point_halt_error ? (r22_secondary_block ? "The \"{puz_point_fellas_leap}\" order echoes in your head." : "Quiet, for the moment.") : "The hall terror is making all kinds of noise." )} ;
      } : else_if (is_at "r22") {
         : print "Mumbling from the field's long-term occupant." ;
      } : else_if (is_at "r23") {
         : if (!point_frame_easily) {
            : print "Grumblings on either side." ;
         }
      } : else_if (is_at "r24") {
         : if (!point_warm_acres) {
            : print "Alternating orders and eerie silence." ;
         }
      } : else_if (is_at "r30") {
         : if (!point_door_cloud) {
            : print "The dork loud-mumbles passive-aggressively about having to wait around to help people who don't have a clue what they want or how to get it." ;
         }
      } : else_if (is_at "r32") {
         : if (!point_dump_liars) {
            : cycle key="chesstalk" predictable_order="false" {
               : print "You absorb knowledge about Carlsbad pawn structures." ;
               : print "A big argument breaks out over whether it's morally wrong to play the London System." ;
               : print "A squabble breaks out between two people of roughly equal rating." ;
               : print "There's a brief three-way argument among people who believe the endgame or middlegame or opening is most important to study." ;
               : print "Someone is berated for earnestly stating how educational Paul Morphy's famous Opera game can be. Someone else is berated for not having memorized it." ;
               : print "A brief sectarian verbal skirmish between king-pawn and queen-pawn players. They eventually settle for mocking those flank opening playing types." ;
               : print "Loud aggressive types condemn wimps who play the Exchange variation of the French, Caro-Kann or Queen's Gambit Declined." ;
               : print "People who can checkmate with bishop and knight begin taunting those who can't, who reply they actually use their brains for more useful stuff." ;
            }
         }
      } : else_if (is_at "r40") {
         : if (point_shape_up) {
            : print "The dog makes happy dog noises." ;
         }
      } : else_if (is_at "r42") {
         : print {( point_girl_only ? " Feels peaceful now you found the girl." : point_seek_rest ? "The {puz_point_grr_lonely} fades in and out." : "Eerie silence. What awaits?" )} ;
      } : else_if (is_at "r44") {
         : print {( point_tense_ops ? "The sops have much less to say now." : "The sops natter and gripe among themselves." )} ;
      } : else_if (is_at "r26") {
         : if (!point_bah_slumping) {
            : print "You don't really WANT to listen to the {puz_point_boss_lumping}'s beratings, but that's impossible here." ;
         }
      } : else {
         : print "Nothing." ;
      }
   }
   map_stub : subroutine {
      : if (!bonus_point_lo_maps) {
         : print "You haven't gained access to the internal game map command yet. It is in two of the very early rooms. It's not critical to win, though." ;
         : done ;
      }
      : set_true "drawing_map" ;
      : clear_screen ;
      : update_graphic "m_0_blank" ;
      : set_false "drawing_map" ;
      : if (!map_note) {
         : print "{one_time}there are no one-way paths. Dotted paths mean ways that are blocked until you've solved a puzzle." ;
         #: print "{one_time}there are no one-way paths. If you have activated the option to block completed rooms, they will be in <GREY<#888>>." ;
         : set_true "map_note" ;
      }
      : press_any_key ;
      : redescribe ;
      : done ;
   }

   inventory_nouns : subroutine {
      : if (point_girl_only && !point_warm_acres) {
         : match "_ doll" {
            : print "It's a weird looking doll, but it probably helped the girl feel less lonely. Looking at it, you think \"find-all-fine doll.\"" ;
            : done ;
         }
         : match "_ girl" {
            : print "She doesn't have much to say, but she follows you closely now, and she just won't let go of {puz_point_her_doll}." ;
            : done ;
         }
      }
      : if (is_carried "coin") {
         : match "_ coin;_ ooh;_ new;_ coy" {
            : print "It's nothing to be thrilled about on its own. But maybe you can trade up, somehow." ;
            : done ;
         }
      }
      : if (is_carried "dumb_pliers") {
         : match "_ dumb;_ pliers" {
            : print {( point_cloth_robbing ? "They got the job done. But you can't bring yourself to part with them yet. When the time comes, though..." : "Well, they look like they will get the job done, whatever that job is. You're kind of glad they don't have a lot of options. That might make them confusing. You wonder if this makes you dumb." )} ;
            : done ;
         }
      }
      : if (is_carried "vie_neater") {
         : match "_ vie;_ neater;_ coupon;_ promise" {
            : print {( think_vine_eater ? "You know it's to eat vines. Now to find vines, or vine-ish things!" : "The promise on the coupon is a bit vague. But perhaps it has to be, to escape censorship and scrutiny." )} ;
            : done ;
         }
      }
      : if (is_carried "tufty_key") {
         : match "_ tufty;_ key" {
            : print "It's certainly oddly-shaped. Well, the part you hold. Perhaps that will make where it goes more easily identifiable." ;
            : done ;
         }
      }
      : if (point_tense_ops && !point_frame_easily) {
         : match "_ agree;_ aye;_ degree;_ id" {
            : print "The {iaad} certifies you as someone who gets along well with others and helps them achieve their goals." ;
            : done ;
         }
      }
      : if (point_say_loaners && (is_at "r42" || is_at "r43" || is_at "r33")) {
         : match "_ mo;_ tried;_ moat;_ ride" {
            : print {( "Sturdy enough. You couldn't afford anything too expensive. " + ( !has_visited "r43" ? "You may wish to take the moat ride {dir_n_y}, now you own it." : is_at "r33" ? "Sitting on the shore, waiting to take you back." : is_at "r42" ? (point_flow_tripling ? "You can row it to the west or south safely." : "The water is too dead to really move the ride west, but you can easily go back south." ) : (point_girl_only ? "It got you a companion. You're not sure if it can do any more." : "You haven't done everything with it you could, you sense." )) )} ;
            : done ;
         }
      }
      : if (is_carried("dumb_parable")) {
         : match "_ dumb;_ parable" {
            : print "You toss the parable around in your head. It is what it is. (Did you just think that? Ugh!)\nPeople will see what they want in it. You're not trying to scam anyone." ;
            : done ;
         }
      }
      : if (point_say_four) {
         : match "_ oars" {
            : print {( has_visited "r42" ? "The oars you bought got you across the water." : point_say_loaners ? "You should try the oars out going north from {here_r33}." : "You think about what the oars would go with. It'd be nice to get them off the vendors' hands, eventually." )} ;
            : done ;
         }
      }
   }

   ##### AUXILIARY
   note_score_upper_right : subroutine {
      : if (!noted_upper_right) {
         : print "{one_time}you can toggle score notifications with {optt_notify} {yn}. The score is always tracked in the upper right." ;
         : set_true "noted_upper_right" ;
      }
   }
   add_bonus_point : subroutine {
      : print "<You gained a bonus point!<#ff0>>" ;
      : increment "bonus_score" ;
      : update_graphic ;
   }
   add_point : subroutine {
      : gosub "check_100" ;
      : collection_modify { collection = "tried_combo_core" index -> (tempint) content -> ("true") } ;
      : print "<Your score has just gone up by a point!<#ff0>>" ;
      : increment "score" ;
      : update_graphic ;
   }
   note_thinks : subroutine { # special case SCORE vs THINK, note you've cleared all the good ideas you had.
      : if (!think_note_yet) {
         : print "{one_time}{vd_think} will track any command that you need to retry later, after preparation. Also, the status line in the upper left will show +1 or more, for commands you've guessed right but still need prep for." ;
         : set_true "think_note_yet" ;
      }
   }
   check_100 : subroutine {
      : if (tempint >= 100) {
         : print "This hasn't been sorted yet. This won't kill gameplay but will detect how things are sorted for half-right guesses. And you get a point." ;
         : increment "score" ;
         : done ;
      }
   }
   half_hints : subroutine {
      : if (!note_half_think) {
         : print "{one_time}{vd_think} will show half-right guesses until you've gotten both words right." ;
         : set_true "note_half_think" ;
      }
      : if (first_half) {
         : if (half_bonus) {
            : collection_modify { collection = "got_first_bonus" index -> (tempint) content -> ("true") ; }
         } : else {
            : collection_modify { collection = "got_first_core" index -> (tempint) content -> ("true") ; }
         }
      } : else {
         : if (half_bonus) {
            : collection_modify { collection = "got_second_bonus" index -> (tempint) content -> ("true") ; }
         } : else {
            : collection_modify { collection = "got_second_core" index -> (tempint) content -> ("true") ; }
         }
      }
      : set_false "already_got_command" ;
   }
   say_half : subroutine {
      : match "* -;- *" {
         : print "Feels right, but what to pair that word with?" ;
         : gosub "half_hints" ;
         : done ;
      }
      : gosub "check_100" ;
      : cycle key = "one_right" predictable_order = "true" skip_interval = "0" max_loops = "1" {
         : print {( "The {first_or_second} word felt right, but the other didn't. You must be halfway there{for_bonus}.{already_got_check}" )} ;
         : print "That halfway-there feeling again. You must have gotten the {first_or_second} word there{for_bonus}.{already_got_check}" ;
         on_exhausted {
            : print {( (first_half ? "First word right, second word wrong" : "First word wrong, second word right") + "{for_bonus}.{already_got_check}" )} ;
         }
      }
      : gosub "half_hints" ;
      : if (!half_bonus) {
         : done ;
      }
   }

   set_tats_num : subroutine {
      : if (is_at "end_zone") {
         : set_integer var="my_tats_num" {( tats_end )} ;
      } : else_if (is_at "top_zone") {
         : set_integer var="my_tats_num" {( tats_top )} ;
      } : else_if (is_at "middle_zone") {
         : set_integer var="my_tats_num" {( tats_middle )} ;
      } : else_if (is_at "bottom_zone") {
         : set_integer var="my_tats_num" {( tats_bottom )} ;
      } : else {
         : set_integer var="my_tats_num" "0" ;
      }
      : if (gamestate_fail_oops_known && (is_at "r14" || is_at "r04") && !point_fey_loops) {
         : set_integer var="my_tats_num" "35" ;
      }
   }

   r22_npc : subroutine {
      : print {( point_free_crusty ? "They seem happier now you've helped them reframe their life." : "They don't need to be reminded of their weaknesses. They maybe need to restate how things are. It's not their fault. (Small voice: it's mine, actually, being the writer of this. But I hope I--and you--make things turn out okay for them in the end.)" )} ;
      : done ;
   }

   loam_apse_stuff : subroutine {
      : if (!gamestate_loam_apse_placed) {
         : print "Weird. You see a loam apse off to the side of this intersection. Maybe it holds something!" ;
         : set_true "gamestate_loam_apse_placed" ;
         : set_boolean var="apse_at_11" {( is_at "r11" )} ;
         : return ;
      } : else_if (!gamestate_both_loam_apse) {
         : if (apse_at_11 != is_at "r11") {
            : print "Ooh, another loam apse. Odd to have two of them. They must be special." ;
            : set_true "gamestate_both_loam_apse" ;
         }
            : return ;
      } : else {
         : print "One of the two identical loam apses sits at the intersection here." ;
         : return ;
      }
   }
   ########################## options

   colorclue_choice : subroutine {
      : if (won_yet) {
         : return ;
      }
      : ask_bool {
         question   = {this_game} puts critical words in <PURPLE<#f0f>> to help you know what to work with. The option can be changed in-game with {optt_ch} (on/off are reserved by Adventuron.)
         yes_answer = Yes, I'd like to use color-coded hinting. (<RECOMMENDED<#0f0>>)
         no_answer  = No, I'd prefer not to use color-coded hinting.
         var        = opt_color_coding
      }
      : print {( "Color-coded hinting is " + (opt_color_coding ? "now available." : "disabled.") + " We're ready to start the game, now!" )} ;
      : press_any_key ;
      : clear_screen ;
   }

   check_options : subroutine {
      : match "ch _" {
         : gosub "options_colorhint" ;
      }
      : match "notify _" {
         : gosub "options_score_notify" ;
      }
      : match "hone aye;hone eye" {
         : print {( "Available exits are " + (opt_hone_aye ? "already" : "now") + " honed to ones you still need to use to win." )} ;
         : gosub "set_tats_num" ;
         : if (my_tats_num == 0 && !opt_hone_aye) {
            : print "Since you're choosing this option, and you're done here, I'll make a note of that. You can exit, but you might not be able to come back." ;
         }
         : set_true "opt_hone_aye" ;
         : return ;
      }
      : match "ho nigh" {
         : print {( "Exits are " + (opt_hone_aye ? "now" : "already") + " all available, even ones you don't need to revisited." )} ;
         : set_false "opt_hone_aye" ;
         : return ;
      }
      : match "ho _" {
         : print "You need to type {vo_ho_nigh} explicitly." ;
         : done ;
      }
      : match "hone _" {
         : print "You need to type {vo_hone_aye} explicitly." ;
         : done ;
      }
   }

   option_err_stub : subroutine {
      : match "_ -" {
         : print "Toggling {tempopt} without an argument ({yn}) is not supported." ;
         : done ;
      }
      : print "Toggling {tempopt} requires one of {yn} as an argument." ;
      : done ;
   }

   options_colorhint : subroutine {
      : set_boolean var="opt_on_off" {( opt_color_coding )} ;
      : match "ch yes" {
         : print "Now {optt_ch} is activated." ;
         : set_true "opt_color_coding" ;
         : done ;
      }
      : match "ch no" {
         : print "Now {optt_ch} is deactivated." ;
         : set_false "opt_color_coding" ;
         : done ;
      }
      : set_string var="tempopt" text="{optt_ch}" ;
      : gosub "option_err_stub" ;
   }

   options_score_notify : subroutine {
      : set_boolean var="opt_on_off" {( opt_score_notify )} ;
      : match "notify yes;notify y" {
         : print "Score notify is now on.";
         : set_true "opt_score_notify";
         : done ;
      }
      : match "notify no;notify n" {
         : print "Score notify is now off.";
         : set_false "opt_score_notify";
         : done ;
      }
      : set_string var="tempopt" text="{optt_notify}" ;
      : gosub "option_err_stub" ;
   }

   ############################ rejects

   odd_dir_note : subroutine {
      : match "se _;sw _;ne _;nw _" {
         : print "You don't need to use diagonal directions. Only the four main cardinal directions are used here." ;
         : done ;
      }
      : match "u _;d _;enter _;in _;exit _;out _" {
         : print "Only the four main cardinal directions are used here. You never need to go up, down, in or out." ;
         : done ;
      }
   }

   #########################################diagnostics

   diagnostic_think_core_half : subroutine {
      : set_integer var="counter" "0" ;
      : set_false "think_core_yet" ;
      : while (counter < max_score) {
         : if ((collection_get{ collection -> ("tried_combo_core") index -> ( counter )} == "false")) {
            : if (part_core_score > 0) {
               : if (!think_core_yet) {
                  : print "{think_here_also} is a summary of correct bonus command half-guesses:" ;
                  : set_true "think_core_yet" ;
                  : set_true "think_text_yet" ;
               }
               : print {( (part_core_score != 2 ? (collection_get{ collection -> ("think_first_core") index -> (counter) }) : "{noguess_c_1}") + " " + (part_core_score >= 2 ? (collection_get{ collection -> ("think_second_core") index -> (counter) }) : "{noguess}") + " " + (collection_get{ collection -> ("situations_core") index -> (counter) }) )} ;
               : if (!solved_both_parts_core_nag && part_core_score == 3) {
                  : set_true "print_core_nag_after" ;
               }
            }
         }
         : increment "counter" ;
      }
   }

############################### game specific gotos
   goto_basic_check : subroutine {
      : if (gamestate_thug_chase) {
         : print "Sorry, I'm going to make you run through the thug chase." ;
         : done ;
      }
      : if (!has_visited(roomto)) {
         : if (!has_visited "r25" && (roomto == "r15" || roomto == "r25" || roomto == "r35" || roomto == "r26" || roomto == "r27")) {
            : print "That's an endgame room, but you haven't made it to the endgame yet." ;
         } : else {
            : print "You haven't been there yet." ;
         }
         : done ;
      }
      : if (is_at(roomto)) {
         : print "You're already there/here!" ;
         : done ;
      }
      : if (opt_hone_aye && tempblockbool) {
         : set_string var="temproom" {( current_location() )} ;
         : while (temproom != "r25" && temproom != roomto ) {
            : if (temproom == "r00" || temproom == "r02") {
               : set_string var="temproom" {( "r01" )} ;
            } : else_if (temproom == "r10" || temproom == "r01" || temproom == "r12") {
               : set_string var="temproom" {( "r11" )} ;
            } : else_if (temproom == "r13") {
               : set_string var="temproom" {( "r12" )} ;
            } : else_if (temproom == "r14" || temproom == "r03") {
               : set_string var="temproom" {( "r13" )} ;
            } : else_if (temproom == "r04") {
               : set_string var="temproom" {( "r03" )} ;
            } : else_if (temproom == "r20" || temproom == "r11" || temproom == "r31") {
               : set_string var="temproom" {( "r21" )} ;
            } : else_if (temproom == "r21") {
               : set_string var="temproom" {( "r22" )} ;
            } : else_if (temproom == "r22") {
               : set_string var="temproom" {( "r23" )} ;
            } : else_if (temproom == "r23") {
               : set_string var="temproom" {( "r24" )} ;
            } : else_if (temproom == "r24") {
               : set_string var="temproom" {( "r25" )} ;
            } : else_if (temproom == "r30" || temproom == "r41" || temproom == "r32") {
               : set_string var="temproom" {( "r31" )} ;
            } : else_if (temproom == "r33") {
               : set_string var="temproom" {( "r32" )} ;
            } : else_if (temproom == "r43" || temproom == "r34") {
               : set_string var="temproom" {( "r33" )} ;
            } : else_if (temproom == "r40") {
               : set_string var="temproom" {( "r30" )} ;
            } : else_if (temproom == "r42") {
               : set_string var="temproom" {( "r43" )} ;
            } : else_if (temproom == "r44") {
               : set_string var="temproom" {( "r34" )} ;
            } : else {
               : print "Search failed at {temproom}. This is a bug." ;
               : done ;
            }
         }
         : if (temproom != roomto) {
            : print "You are done in that area, so with {vo_hone_aye} on, I won't send you there." ;
            : done ;
         }
      }
      : goto {( roomto )} ;
      : redescribe ;
   }

   gotos : subroutine {
      : match "00 _;* 00;0 _;_ 0" {
         : set_boolean var="tempblockbool" {( coreblock_00 )} ;
         : set_string var="roomto" {( "r00" )} ;
         : gosub "goto_basic_check" ;
      }
      : match "01 _;* 01;1 _;_ 1" {
         : set_boolean var="tempblockbool" {( coreblock_01 )} ;
         : set_string var="roomto" {( "r01" )} ;
         : gosub "goto_basic_check" ;
      }
      : match "02 _;* 02;2 _;_ 2" {
         : set_boolean var="tempblockbool" {( coreblock_02 )} ;
         : set_string var="roomto" {( "r02" )} ;
         : gosub "goto_basic_check" ;
