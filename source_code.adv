booleans {
   # game state (noncritical, mostly informational)
   note_half_think : boolean "false" scope="survivor"  ;
   showed_first_note : boolean "false" scope="survivor" ;
   showed_read_ooh_note : boolean "false" scope="survivor" ;
   warn_score_header : boolean "false" scope="survivor"  ;
   credits_yet : boolean "false" scope="survivor"  ;
   wait_yet : boolean "false" scope="survivor"  ;
   me_x_yet : boolean "false" scope="survivor"  ;
   won_yet : boolean "false" scope="survivor" ;
   in_number_choice : boolean "false" ;
   noted_upper_right : boolean "false" scope="survivor" ;
   think_note_yet : boolean "false" scope="survivor" ;
   map_note : boolean "false" scope="survivor"  ;
   note_thug_pass : boolean "false" scope="survivor"  ;
   shorten_inventory : boolean "false" scope="survivor"  ;
   tats_explanation_yet : boolean "false" scope="survivor"  ;
   zero_explained : boolean "false" scope="survivor" ;

   # option(s)
   opt_hone_aye : boolean "false" ;
   opt_color_coding : boolean "false" ;
   opt_score_notify : boolean "true" scope="survivor" ;

   # game state (critical)
   gamestate_bros_second_trigger : boolean "false" ;
   gamestate_bros_second_placed  : boolean "false" ;
   gamestate_gent_intro          : boolean "false" ;
   gamestate_thug_activated      : boolean "false" ;
   gamestate_thug_chase          : boolean "false" ;
   gamestate_thug_gone           : boolean "false" ;
   gamestate_thug_pass           : boolean "false" ;
   gamestate_r21_e               : boolean "false" ;
   gamestate_fail_oops_known     : boolean "false" ;
   gameflag_note_pals_stay_end   : boolean "false" ;
   gamestate_no_oops_yet         : dynamic_boolean {( (is_at "r14" || is_at "r04") && !point_fey_loops )} ;
   gamestate_end_companions      : dynamic_boolean {( point_mage_urgent && !point_bah_slumping )} ;
   gamestate_tried_beyond_r25    : boolean "false" ;

   # gamestate loam apse stuff
   gamestate_loam_apse_placed    : boolean "false" ;
   gamestate_both_loam_apse      : boolean "false" ;
   apse_at_11 : boolean "false" ;

   # gamestate combo
   girl_present : dynamic_boolean {( point_girl_only && !point_warm_acres )} ;
   need_double_pic: dynamic_boolean {( is_at "r00" && point_vine_eater )} ;

   #blocker(s) derived from gamestate
   r13_secondary_block : dynamic_boolean {( gamestate_bros_second_placed && !point_whee_plucky )} ;
   r22_secondary_block : dynamic_boolean {( gamestate_r21_e && !point_fell_asleep )} ;
   gamestate_bros_blocking : dynamic_boolean {( r13_secondary_block || !point_pose_teasing )} ;

   # points (sorted, beginning or end)
   point_bah_slumping      : boolean "false" ; # 46
   point_blest_able        : boolean "false" ; # 48
   point_broke_lass        : boolean "false" ; # 45
   point_can_do            : boolean "false" ; # 00
   point_catch_acing       : boolean "false" ; # 35
   point_chest_reigning    : boolean "false" ; # 13
   point_cloth_robbing     : boolean "false" ; # 25
   point_coin_ovations     : boolean "false" ; # 10
