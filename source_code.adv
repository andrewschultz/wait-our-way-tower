start_at = "r20"
start_theme = my_theme

#cch.py makes sure of things

game_information {
   game_name                    = Wait-Our-Way Tower
   game_version                 = 1.0.0
   game_shortname               = WOWT
   written_by                   = Andrew Schultz
   uuid                         = b3c1f8e2-5d4a-4f9b-8c3d-2a7e5f6a9b1c
   year_of_release              = 2026
   copyright_message            = Free to distribute, voluntary payments welcome
   short_synopsis               = IFComp 2026 entry, in the vein of {l_wp} and {l_ut}, but in Adventuron
}

## Defines locations in the world

strings {
   # top level
   wowt : string "<Wait-Our-Way Tower<#f80>>" ;
   this_game : string "<Wait-Our-Way Tower<#f80>>" ;
   l_ut : string "<Us Too<#0f0>>[http://andrewschultz.itch.io/us-too]" ;
   l_wp : string "<Why Pout<#0f0>>[http://andrewschultz.itch.io/why-pout]" ;
   ifcomp : string "<IFComp<#f80>>[https://ifcomp.org]" ;

   # basics
   my_score : string "{score}{plus_in_header}/{max_score}" ;
   custom_unknown_verb_error : dynamic_string {( "Nothing special happens. You can use {vm_verbs} for a general overview of standard verbs." )} ;
   exits_err : dynamic_string {(
      is_at "r20" ? "THE DOOR east is the only exit." :
      is_at "r21" ? "Can't go that way." :
      "Can't go that way."
      )} ;

   # parser stuff
   nospecial_custom : string "You see no specific item like that. To examine a room, <LOOK<#0f0>>. Note that the parser may not recognize adjectives as synonyms, so using a noun works best." ;
   yn_or_12_or_14 : dynamic_string {( (verb_is "save" || verb_is "load") ? "Please choose from 1 to 4." : in_number_choice ? "Please choose 1 or 2." : "Please choose YES/Y or NO/N." )}

   # noting stuff
   one_time : string "<ONE-TIME NOTE: <#f0f>>" ;
   key_enter : string "the <ENTER<#f88>>/<RETURN<#f88>> key" ;

   # diagnostic verbs
   vd_bonus : string "<BONUS<#f80>>" ;
   vd_hint : string "<HINT<#f80>>/<HINTS<#f80>>" ;
   vd_i : string "<I<#f80>>" ;
   vd_inv : string "<INV<#f80>>" ;
   vd_i_long : string "<INVENTORY<#f80>>" ;
   vd_i_three : string "{vd_i}/{vd_inv}/{vd_i_long}" ;
   vd_map : string "<MAP<#f80>>" ;
   vd_score : string "<SCORE<#f80>>" ;
   vd_think : string "<THINK<#f80>>" ;

   # meta-verbs
   vm_about : string "<ABOUT<#f80>>" ;
   vm_credits : string "<CREDITS<#f80>>" ;
   vm_think : string "<THINK<#f80>>" ;
   vm_verbs : string "<VERBS<#f80>>" ;
   vm_versions : string "<VERSIONS<#f80>>" ;

   xtats : string "<X TATS<#f80>>" ;
   xme : string "<X ME<#0f0>>" ;

   # verb option strings
   # options, game specific
   vo_hone_aye : string "<HONE AYE<#ff0>>/<HONE EYE<#ff0>>" ;
   vo_ho_nigh : string "<HO NIGH<#ff0>>" ;

   optt_ch : string "<CH<#88f>> or <COLORHINT<#88f>>" ;
   optt_notify : string "<NOTIFY<#88f>>" ;
   yn : string "<YES<#f88>>/<Y<#f88>> or <NO<#f88>>/<N<#f88>>" ;

   # puzzle strings
   puz_point_ace_inc        : dynamic_string {( opt_color_coding ? "<Ace, Inc.<#f80>>" : "Ace, Inc." )}           ; # 26
   puz_point_bleah_stable   : dynamic_string {( opt_color_coding ? "<bleah stable<#f80>>" : "bleah stable" )}     ; # 46
   puz_point_boss_lumping   : dynamic_string {( opt_color_coding ? "<boss lumping<#f80>>" : "boss lumping" )}     ; # 45
   puz_point_bro_class      : dynamic_string {( opt_color_coding ? "<Bro Class<#f80>>" : "Bro Class" )}           ; # 44
   puz_point_canned_ooh     : dynamic_string {( opt_color_coding ? "<Canned, ooh<#f80>>" : "Canned, ooh" )}       ; # 00
   puz_point_cat_chasing    : dynamic_string {( opt_color_coding ? "<cat, chasing<#f80>>" : "cat, chasing" )}     ; # 35
   puz_point_chess_training : dynamic_string {( opt_color_coding ? "<chess training<#f80>>" : "chess training" )} ; # 13
   puz_point_chez_pup       : dynamic_string {( opt_color_coding ? "<chez pup<#f80>>" : "chez pup" )}             ; # 37
   puz_point_claw_throbbing : dynamic_string {( opt_color_coding ? "<claw throbbing<#f80>>" : "claw throbbing" )} ; # 25
   puz_point_coy_novations  : dynamic_string {( opt_color_coding ? "<coy novations<#f80>>" : "coy novations" )}   ; # 10
   puz_point_cube_land      : dynamic_string {( opt_color_coding ? "<cube land<#f80>>" : "cube land" )}           ; # 27
   puz_point_dork_loud      : dynamic_string {( opt_color_coding ? "<dork loud<#f80>>" : "dork loud" )}           ; # 22
   puz_point_drive_enders   : dynamic_string {( opt_color_coding ? "<drive enders<#f80>>" : "drive enders" )}     ; # 07
   puz_point_dull_oozing    : dynamic_string {( opt_color_coding ? "<dull oozing<#f80>>" : "dull oozing" )}       ; # 06
   puz_point_dumb_pliers    : dynamic_string {( opt_color_coding ? "<dumb pliers<#f80>>" : "dumb pliers" )}       ; # 14
   puz_point_dump_arable    : dynamic_string {( opt_color_coding ? "<dump, arable<#f80>>" : "dump, arable" )}     ; # 08
   puz_point_fail_oops      : dynamic_string {( opt_color_coding ? "<\"Fail! Oops!\"<#f80>>" : "fail_oops" )}     ; # 41
   puz_point_field_erring   : dynamic_string {( opt_color_coding ? "<field erring<#f80>>" : "field erring" )}     ; # 15
   puz_point_fellas_leap    : dynamic_string {( opt_color_coding ? "<FELLAS, LEAP<#f80>>" : "FELLAS, LEAP" )}     ; # 04
   puz_point_flight_wraps   : dynamic_string {( opt_color_coding ? "<flight wraps<#f80>>" : "flight wraps" )}     ; # 33
   puz_point_flight_wraps_u : dynamic_string {( opt_color_coding ? "<Flight wraps<#f80>>" : "Flight wraps" )}     ; # 33
   puz_point_float_rippling : dynamic_string {( opt_color_coding ? "<float, rippling<#f80>>" : "float-rippling" )} ; # 23
   puz_point_fray_measly    : dynamic_string {( opt_color_coding ? "<fray measly<#f80>>" : "fray measly" )}       ; # 30
   puz_point_freak_rusty    : dynamic_string {( opt_color_coding ? "<freak rusty<#f80>>" : "freak rusty" )}       ; # 16
   puz_point_grr_lonely     : dynamic_string {( opt_color_coding ? "<grr lonely<#f80>>" : "grr lonely" )}         ; # 32
   puz_point_hall_terror    : dynamic_string {( opt_color_coding ? "<hall terror<#f80>>" : "hall terror" )}       ; # 03
   puz_point_her_doll       : dynamic_string {( opt_color_coding && (!point_heard_all || !point_herd_all) ? "<her doll<#f80>>" : "her doll" )}             ; # 38 36
   puz_point_hey_trash      : dynamic_string {( opt_color_coding ? "<\"HEY, TRASH\"<#f80>>" : "\"HEY, TRASH\"" )} ; # 05
   puz_point_knowin_juries  : dynamic_string {( opt_color_coding ? "<knowin juries<#f80>>" : "knowin' juries" )}   ; # 09
   puz_point_major_gent     : dynamic_string {( opt_color_coding ? "<major gent<#f80>>" : "major gent" )}         ; # 43
   puz_point_meager_oath    : dynamic_string {( opt_color_coding ? "<meager oath<#f80>>" : "meager oath" )}       ; # 24
   puz_point_pit_churning   : dynamic_string {( opt_color_coding ? "<pit churning<#f80>>" : "pit churning" )}     ; # 12
   puz_point_plight_owls    : dynamic_string {( opt_color_coding ? "<plight owls<#f80>>" : "plight owls" )}       ; # 28
   puz_point_post_easing    : dynamic_string {( opt_color_coding ? "<post easing<#f80>>" : "post easing" )}       ; # 19
   puz_point_safe_oar       : dynamic_string {( opt_color_coding ? "<safe oar<#f80>>" : "safe oar" )}             ; # 17
   puz_point_sail_owners    : dynamic_string {( opt_color_coding ? "<sail owners<#f80>>" : "sail owners" )}       ; # 18
   puz_point_seacrest       : dynamic_string {( opt_color_coding ? "<seacrest<#f80>>" : "seacrest" )}             ; # 31
   puz_point_sunk_etching   : dynamic_string {( opt_color_coding ? "<sunk etching<#f80>>" : "sunk etching" )}     ; # 20
   puz_point_ten_sops       : dynamic_string {( opt_color_coding ? "<ten sops<#f80>>" : "ten sops" )}             ; # 29
   puz_point_titan_drowsing : dynamic_string {( opt_color_coding ? "<titan drowsing<#f80>>" : "titan drowsing" )} ; # 11
   puz_point_true_pleading  : dynamic_string {( opt_color_coding ? "<true pleading<#f80>>" : "true pleading" )}   ; # 47
   puz_point_the_floor      : dynamic_string {( opt_color_coding ? "<the floor<#f80>>" : "the floor" )}           ; # 01
   puz_point_tough_tiki     : dynamic_string {( opt_color_coding ? "<tough tiki<#f80>>" : "tough tiki" )}         ; # 21
   puz_point_vie_neater     : dynamic_string {( opt_color_coding ? "<vie neater<#f80>>" : "vie neater" )}         ; # 34
   puz_point_war_makers     : dynamic_string {( opt_color_coding ? "<war makers<#f80>>" : "war makers" )}         ; # 40
   puz_point_weep_lucky     : dynamic_string {( opt_color_coding ? "<weep \"lucky\"<#f80>>" : "weep \"lucky\"" )} ; # 39
   puz_point_wry_tangles    : dynamic_string {( opt_color_coding ? "<Wry Tangles<#f80>>" : "Wry Tangles" )}       ; # 42
   puz_point_yellow_pin     : dynamic_string {( opt_color_coding ? "<yellow pin<#f80>>" : "yellow pin" )}         ; # 02

   # blocking strings
   block_03_04       : string "Weird! It feels like there could almost be something there. But it's disorienting even to plan out a route. For now." ;
   block_dull_oozing : string "Ehh ... the {puz_point_dull_oozing} slows you down. It's probably wrong, and trekking further is probably harmless, but what if it isn't?" ;
   block_hey_trash   : string "The call of {puz_point_hey_trash} freezes you. You half want to show them, whomever they are, and whatever you want to show. You'll decide that later. Also, you worry if you go farther, there'll be more people like that, which could put you in danger. So, for now, no." ;
   block_trrg        : string "Not with the {trrg} around you can't explore somewhere new." ;

   # room(s)
   r00_loc : dynamic_string {( point_catch_acing ? "There's a cat chasing here, mostly fallen leaves and stuff, but it's more coordinated now you helped it." :
      point_vine_eater ? "With the fly traps removed, there's a {puz_point_cat_chasing} here. It's not chasing stuff very well, though." :
      point_fly_traps ? "Fly traps have replaced what was here. Perhaps you could cut through them somehow." :
      "{puz_point_flight_wraps_u} cover the area here. What are {puz_point_flight_wraps}? Well, they just prevent people, or their ideas, from taking flight."
   )} ;
   r00_header : dynamic_string {( point_fly_traps ? "Fly Traps" : "Flight Wraps" )} ;

   r01_loc : dynamic_string {( (point_dumb_parable ? "You've gotten something out of the dump (arable,) and since there isn't much left, it's probably best just to find" : "This is, well, a {puz_point_dump_arable}. Is it really just a connecting passage, or is there more to it? At any rate, not much is here, yet, which is kind of nice, since nothing blocks") + " passage north, east or west." )} ;
   r01_header : string "Dump, Arable" ;

   r02_loc : dynamic_string {( (point_pitch_earning ? "The pit still churns, but the titan is gone. You see nothing else to do here." : point_tightened_rousing ? "The titan is now awake. It's looking for something to do. Maybe you can help it." : "You see a {puz_point_titan_drowsing} here.") + "\nThe {puz_point_pit_churning} rises high all directions except back west." )} ;
   r02_header : string "Pit, Churning" ; # the spit-thus pit

   r03_loc : dynamic_string {( "The trail runs north to east here." + (point_tufty_key ? "The tough tiki has disappeared." : point_sun_catching ? "The sun caught a {puz_point_tough_tiki}." : "\nYou see a {puz_point_sunk_etching} or two scattered around here. Maybe they're hiding something." ) )} ;
   r03_header : string "Sunk Etching" ;

   r04_loc : dynamic_string {( "A {puz_point_meager_oath} reverberates through here in this open ground. Its words are not important. " + (point_me_growth ? "You've gotten its essence." : "Perhaps you can get what you need to from it." ) + "\nPassage leads back west" + (point_fey_loops ? " and, as part of the fey loops, north." : ".") )} ;
   r04_header : string "Meager Oath" ;

   r10_loc : dynamic_string {( point_say_four ? "Since you bought oars, nothing here is interesting." : (point_dry_vendors ? "Dry vendors have parked themselves here. A {puz_point_safe_oar} rests behind them." : "You haven't seen any cars or bikes or whatever around, so it's weird this small selection of dead ends should be called {puz_point_drive_enders}, but it is.") + "\nPassage leads back east." )} ;
   r10_header : dynamic_string {( point_dry_vendors ? "Dry Vendors" : "Drive Enders" )} ;

   r11_loc : dynamic_string {( point_duh_losing ? "You feel up to going in any four directions now that the dull oozing has died down." : "Here {puz_point_dull_oozing}, physical and audible, surrounds you. There's nothing terribly dangerous any way but back north, but right now, your general feeling is, \"Ehh, why bother?\"" )} ;
   r11_header : string "Note 'Eres No Tears" ;

   r12_loc : dynamic_string {( point_coin_ovations ? "The juries are done with you. They care not how many times you amble back west or east, nor for the purpose." :
      point_no_injuries ? "The juries continue their {puz_point_coy_novations}, no longer concerned if you might try to go east, or just go back west." : "Here, {puz_point_knowin_juries} gaze intently at you, mumbling ... well, whatever it is, it seems impressive. It's an east-west passage here, but they seem to cock their heads to indicate you'd best go back west, as-is." )}  ;
   r12_header : string "Knowin' Juries" ;

   r13_loc : dynamic_string {( (!point_pose_teasing ? "Here, {gbgr} chatter about any old thing. Why bother?" :
      !gamestate_bros_second_placed ? "The {gbgr} are gone, for now." :
      !point_whee_plucky ? "The {gbgr} are at it again, asking if you really need to show off the opportunities you've been given, right in front of their faces." :
      "The {gbgr} are gone for good.") + "\nThe way back is west, but paths branch east and south, too."
   )} ;
   r13_header : string "Post, Easing" ;

   r14_loc : dynamic_string {( !point_cloth_robbing && think_cloth_robbing ? "The {puz_point_claw_throbbing} still protects the cloth you'd like to rob." :
   !point_cloth_robbing ? "A claw, throbbing, guards an expanse north and west. But of what?" :
   "The claw, throbbing, continues to pulse, even though you got what you needed from it." ;
   )} ;
   r14_header : string "Claw, Throbbing" ;

   r15_loc : string "This is a library with only one exit north. There's a book called WRY TANGLES and another called THE GAMES." ;
   r15_header : string "Lie-Bury Libe, Airy" ;

   r20_loc : dynamic_string {( "Here you have enough space to, well, wheeze and pace in worry about your predicament. " + (!point_can_do ? "And you do, constantly repeating \"{puz_point_canned_ooh}.\"" : !point_thief_lore ? "As you wheeze and pace, you find you're gazing a lot at {puz_point_the_floor}." : !point_yell_open ? "But you'd like to get out. How could your {puz_point_yellow_pin} help?" : "You can get out now." ) )} ;
   r20_header : string "Wheeze/Pace Wee Space" ;

   r21_loc : dynamic_string {( "The hall leads north and south, with a darker passage east. " + (!point_halt_error ? "A {puz_point_hall_terror}, though, wraps itself around to cover those three exits." : (r22_secondary_block ? "You're worried fellas might leap at you if you go east." : point_fell_asleep ? "No fellas will leap you if you try to go east now." : "" )) + "\nYou could go back west to your cell, too, but that's no fun." )} ;
   r21_header : string "Dredge-Ailing/Dread Jailing" ;

   r22_loc : dynamic_string {( "You " + (point_feel_daring ? "no longer feel uneasy in this field, erring." : "can't shake uneasy emotions in this {puz_point_field_erring}. So many ways to go wrong.") + (!point_free_crusty ? "\nA {point_freak_rusty} watches you." : "") + "\nThe field runs east-west." )} ;
   r22_header : string "Field, Erring" ;

   r23_loc : dynamic_string {( point_frame_easily ? "The fray has died down, and you can just go east-west here." : "A {puz_point_fray_measly} is going on here to the east. It's not very big, yet. But it won't stay that way forever." )} ;
   r23_header : string "Fray, Measly" ;

   r24_loc : dynamic_string {( point_warm_acres ? "The warm acres are just an east-west passageway now." : "Here, {puz_point_war_makers} plot far worse things, but as with the fray to the west, nothing's started yet. Nobody wants to be the same to start it. You sense words won't help here." )} ;
   r24_header : string "War Makers" ;

   r25_loc : string "You can see passage north, south, and east. Back west--well, you're not sure how much is left there." ;
   r25_header : string "The Groom-Thug Room" ;

   r26_loc : dynamic_string {( !point_bah_slumping ? "Well this is pretty miserable. A boss, lumping abuse on you, blocks the way to the east.\nAnd with such sophistry! Such common sense! Did you come here so far for nothing?\nYou can go back west, if you want." : "Well, you've achieved no great power. But you've achieved relief from the boss. You can go east as well as west now." )} ;
   r26_header : string "\"Know Power? NOPE\" Hour" ;

   r27_loc : dynamic_string {( point_blest_able ? "You feel good here. Yet there's still more. You hear and feel {puz_point_true_pleading}, not i-have-to-have, but interest in seeing and doing and offering more.\nSo you still feel restless. Perhaps you need to get the right phrase to say, one more time, to close the book." : "This stable here is pretty bleah. Is it really what the boss was guarding? At least it's well, stable. Bleah, stable ... do you deserve more in life? You guess you do, but you know you're biased." )} ;
   r27_header : string "Bleah Stable" ;

   r30_loc : dynamic_string {( ( point_door_cloud ? "You opened a door in a door-cloud leading north." : "A {puz_point_dork_loud} stands here, going on about how they'd LIKE to let people see great stuff to the north, but peope just AREN'T organized." ) + "\nYou can go back east, too." )} ;
   r30_header : string "Way-Bland Wabe Land" ;

   r31_loc : dynamic_string {( point_hate_rash ? "The yelling is gone now, but even if it wasn't, you are pretty sure you could zone it out. You can go all four directions without nuisance now." : "This place would be kind of unappetizing without the constant echo of {puz_point_hey_trash} from the north, west and east. At least you can go back south." )} ;
   r31_header : string "Way-Still Waste, Ill" ;

   r32_loc : dynamic_string {( (point_chest_reigning ? "A big majestic chest lies here in this east-west thoroughfare." + (point_dump_liars ? " The chest is empty now." : " Also, some dumb pliers are in the chest. You were discouraged from taking them.") : "Here in this east-west thoroughfare all sorts of weird entities train at chess. What could possibly be more important or rewarding than chess? It's the game of royalty, you know!")  )} ;
   r32_header : string "Chess Training" ; # ?? the spit thus pit

   r33_loc : dynamic_string {( (point_say_loaners ? "Your Mo'-Tried Moat Ride can take you north." : "Water blocks foot passage north.") + " However, you can definitely go east or back west." )} ;
   r33_header : string "Sail Owners" ;

   r34_loc : dynamic_string {( ( point_ply_towels ? "The owls no longer block the way north." : "You see {puz_point_plight_owls} blocking passage north. They look wet and unhappy." ) + "\nThere is also passage back west." )} ;
   r34_header : string "Go/Drain/Goad Rain" ;

   r35_loc : string "Here, people are apparently supposed to learn. What, you're not sure. You can only go back south here." ;
   r35_header : string "Bro Class" ;

   r40_loc : string "This is a small hut that smells (pleasantly) of canines. The exit is back south." ;
   r40_header : string "Chez Pup" ;

   r41_loc : dynamic_string {( (!point_eh_sink ? "{puz_point_ace_inc} rises above you on all sides except to the south. You've heard of it. It's one of those soulless corporations that may or may not have already hired all machines." :
      !point_cue_bland ? "This {puz_point_cube_land} gives off unnecessarily dazzling colors. Perhaps there's something among them, but where?" :
      "You've found your way through the cube land. Not much can be here.") +
      "\nThe only way out is back south."
   )} ;
   r41_header : dynamic_string {( point_eh_sink ? "Cube Land" : "Ace, Inc." )} ;

   r42_loc : dynamic_string {( (point_girl_only ? "The island seems cheerier now you found the girl behind the sea crest. Maybe that's just because you got some comanionship. There can't be much else to do here." : point_seek_rest ? "Amidst the sea crest, you hear an odd voice saying {puz_point_grr_lonely}." : "There's a lot of {puz_point_seacrest} covering this otherwise drab and forbidding isle.") + "\nYou can sail back east at any time." )} ;
   r42_header : string "Gray Vile Grave Isle" ;

   r43_loc : dynamic_string {( "Here on your {mtmr} you see land to the west and north.\n" + (point_flow_tripling ? "The flow's picked up, so passage west is viable." : "Unfortunately, you just sort of {puz_point_float_rippling}, and even your oars can't move you west as-is.") )} ;
   r43_header : string "Aww-Flake-Off Lake" ;

   r44_loc : dynamic_string {( "In this small building, " + (point_tense_ops ? "the {puz_point_ten_sops} ignore you now you've helped them, but hey, you're glad they can focus." : "{puz_point_ten_sops} mill around here, discussing plans that don't have much chance of coming off as-is.") + "\nThe only way out of this small building is south." )} ;
   r44_header : string "Ten Sops" ;

   # flavor text
   endgame_friends : dynamic_string {( point_broke_lass ? "Your two friends" : "The mage, urgent" )} ;
   endgame_plural : dynamic_string {( point_broke_lass ? "" : "s" )} ;

   # block strings
   block_pose_teasing : string "The Bros wonder why you need to be running around like this. You need to chillax! Life will be easier that way. And no offense, but if you do have an exciting life, it's a bit unfair. They deserve it a bit more than you do. So you shouldn't rub it in by just walking past them like that." ;
   block_weep_lucky : string "The bros weep about how YOU get all the adventure here. You've been through this before, but since you last visited, you do sort of have to admit you've had a lot of adventures. You feel bad for them. They feel like they're the lovablde underdogs here, that they should get a chance, but noooooo." ;
   block_04_14 : string "Weird! It almost feels like there should be passage that way. You can't say why, but there should. There isn't, now." ;

   # item(s)
   i_fspt : string "<Fey Stats Phase Tats<#ccc>>" ;

   # NPC(s)
   trtg : string "<Thug 'Round the Ground<#ccc>>" ;

   # weird strings
   gbgr : string "<\"Gah, Bros, Gab\" Rows<#ccc>>" ;
   mtmr : string "<Mo' Tried Moat Ride<#ccc>>" ;
   iaad : string "<\"I'd Agree, Aye\" degree<#ccc>>" ;

   # think text and interpretive stuff
   already_got_check : dynamic_string {( already_got_command ? " Though you already got the full command, which you can revisit with {vd_think}." : "" )} ;
   noguess : string "<(unknown)<#888>>" ;
   noguess_c_1 : dynamic_string {( unneeded_half ? "<(unneeded)<#888>>" : "<(unknown)<#888>>" )} ;
   think_here_also : dynamic_string {( think_text_yet ? "Also, here" : "Here" )} ;
   number_as_word : dynamic_string {( collection_get { collection -> ("num_to_word") index -> ( commands_figured ) } )} ;
   plus_in_header : dynamic_string {( think_any ? "+{commands_figured}" : "" )} ;

   #auxiliary for options
   tempopt : string "" ;
   txt_on_off : dynamic_string {( opt_on_off ? "<ON<#f0f>>" : "<OFF<#f0f>>" )} ;

}

integers {
   score : integer "0" ;
   max_score : integer "48" ;

   herd_score : dynamic_integer {( (point_herd_all ? 1 : 0) + (point_heard_all ? 1 : 0) )} ;

   tats_bottom : dynamic_integer {(
      is_at "r00" ? r00_hintnum :
      is_at "r01" ? r01_hintnum :
      is_at "r02" ? r02_hintnum :
      is_at "r03" ? r03_hintnum :
      is_at "r04" ? r04_hintnum :
      is_at "r10" ? r10_hintnum :
      is_at "r11" ? r11_hintnum :
      is_at "r12" ? r12_hintnum :
      is_at "r13" ? r13_hintnum :
      is_at "r14" ? r14_hintnum :
      0
   )} ;
   tats_middle : dynamic_integer {(
      is_at "r20" ? r20_hintnum :
      is_at "r21" ? r21_hintnum :
      is_at "r22" ? r22_hintnum :
      is_at "r23" ? r23_hintnum :
      is_at "r24" ? r24_hintnum :
      0
   )} ;
   tats_top : dynamic_integer {(
      is_at "r30" ? r30_hintnum :
      is_at "r31" ? r31_hintnum :
      is_at "r32" ? r32_hintnum :
      is_at "r33" ? r33_hintnum :
      is_at "r34" ? r34_hintnum :
      is_at "r40" ? r40_hintnum :
      is_at "r41" ? r41_hintnum :
      is_at "r42" ? r42_hintnum :
      is_at "r43" ? r43_hintnum :
      is_at "r44" ? r44_hintnum :
      0
   )} ;
   tats_end : dynamic_integer {(
      is_at "r25" ? r25_hintnum :
      is_at "r26" ? r26_hintnum :
      is_at "r27" ? r27_hintnum :
      is_at "r15" ? r15_hintnum :
      is_at "r35" ? r35_hintnum :
      0 )} ;
   my_tats_num : integer "0" ;
   r00_hintnum : dynamic_integer {( !point_fly_traps ? 35 :
      !point_vine_eater ? (point_cue_bland ? 45 : -45 ) :
      !point_catch_acing ? 55 :
      !point_girl_only ? -1 :
      !point_herd_all ? 43 :
      0 )} ;
   r01_hintnum : dynamic_integer {( !point_dumb_parable ? 47 :
      0 )} ;
   r02_hintnum : dynamic_integer {( !point_tightened_rousing ? 97 :
      !point_pitch_earning ?
      (point_coin_ovations ? 57 : -57) :
      0 )} ;
   r03_hintnum : dynamic_integer {( !point_sun_catching ? 38 :
      !point_tufty_key ? 53 :
      0 )} ;
   r04_hintnum : dynamic_integer {( !point_me_growth ? 26 :
      0 )} ; #?? this is inaccurate but we dont want to spoil things, -1? # fey loops also a problem, can we say -1/swirl not there?
   r10_hintnum : dynamic_integer {( !point_dry_vendors ? 37 :
      !point_say_four ?
	  (point_pitch_earning ? 34 : -34) :
      0 )} ;
   r11_hintnum : dynamic_integer {( !point_duh_losing ? 36 :
      0 )} ;
   r12_hintnum : dynamic_integer {( !point_no_injuries ? 28 :
      !point_coin_ovations ? 48 :
      0 )} ;
   r13_hintnum : dynamic_integer {( !point_pose_teasing ? 47 :
      !point_whee_plucky && gameflag_note_pals_stay_end ? 46 :
      0 )} ;
   r14_hintnum : dynamic_integer {( !point_dump_liars ? -57 :
      !point_cloth_robbing ? 57 :
      0 )} ;
   r20_hintnum : dynamic_integer {( !point_can_do ? 32 :
      !point_thief_lore ? 54 :
      !point_yell_open ? 44 :
      0 )} ;
   r21_hintnum : dynamic_integer {( !point_halt_error ? 45 : !point_fell_asleep ? (gamestate_r21_e ? 46 : -1) :
      0 )} ;
   r22_hintnum : dynamic_integer {( !point_feel_daring ? 46 :
      !point_free_crusty ? 46 :
      0 )} ;
   r23_hintnum : dynamic_integer {( !point_tense_ops ? -56 :
      !point_frame_easily ? 56:
      0 )} ;
   r24_hintnum : dynamic_integer {( point_warm_acres ? 0 :
      (point_heard_all && point_herd_all) ? 45 :
      -45 )} ;
   r30_hintnum : dynamic_integer {( !point_door_cloud ? (point_tufty_key ? 45 : -45) :
      0 )} ;
   r31_hintnum : dynamic_integer {( !point_hate_rash ? 44 :
      0 )} ;
   r32_hintnum : dynamic_integer {( !point_chest_reigning ? 58 :
      !point_dump_liars ? 45 :
      0 )} ;
   r33_hintnum : dynamic_integer {( !point_say_four ? -37 :
      !point_say_loaners ? 37 :
      0 )} ;
   r34_hintnum : dynamic_integer {( !point_cloth_robbing ? -36 :
      !point_ply_towels ? 36 :
      0 )} ;
   r40_hintnum : dynamic_integer {( !point_shape_up ? 52 :
      !point_girl_only ? -1 :
	  !point_heard_all ? 53 :
      0 )} ;
   r41_hintnum : dynamic_integer {( !point_eh_sink ? 24 :
      !point_cue_bland ? 35 :
      0 )} ;
   r42_hintnum : dynamic_integer {( !point_seek_rest ? 35 :
      !point_girl_only ? 44 :
      0 )} ;
   r43_hintnum : dynamic_integer {( !point_flow_tripling ? 48 :
      0 )} ;
   r44_hintnum : dynamic_integer {( !point_me_growth ? -53 :
      !point_tense_ops ? 53 :
      0 )} ;

   # endgame stuff
   r25_hintnum : dynamic_integer {( 0 )} ; #there really is nothing here! The thug guards it all.
   r26_hintnum : dynamic_integer {( !point_broke_lass ? -37 :
      !point_bah_slumping ? 37 :
      0 )} ; #?? remember could be negative
   r27_hintnum : dynamic_integer {( !point_blest_able ? 54 :
      !point_troop_leading ? 37 :
      0 )} ;
   r15_hintnum : dynamic_integer {( !point_mage_urgent ? -56 :
      !point_right_angles ? 56 :
      0 )} ;
   r35_hintnum : dynamic_integer {( !point_mage_urgent ? 46 :
      !point_right_angles ? -54 :
      !point_broke_lass ? 54 :
      0 )} ;

# auxiliary
   tempint : integer "0" ;
   counter : integer "0" ;
   commands_figured : dynamic_integer {( (think_bah_slumping ? 1 : 0) +
      ( think_broke_lass ? 1 : 0) +
      ( think_cloth_robbing ? 1 : 0) +
      ( think_coin_ovations ? 1 : 0) +
      ( think_door_cloud ? 1 : 0) +
      ( think_fey_loops ? 1 : 0) +
      ( think_frame_easily ? 1 : 0) +
      ( think_free_crusty ? 1 : 0) +
      ( think_heard_all ? 1 : 0) +
      ( think_herd_all ? 1 : 0) +
      ( think_pitch_earning ? 1 : 0) +
      ( think_ply_towels ? 1 : 0) +
      ( think_right_angles ? 1 : 0) +
      ( think_say_four ? 1 : 0) +
      ( think_say_loaners ? 1 : 0) +
      ( think_tense_ops ? 1 : 0) +
      ( think_vine_eater ? 1 : 0) +
      ( think_warm_acres ? 1 : 0)
      )} ;
   # for half THINK
   part_core_score : dynamic_integer {( ((collection_get{ collection -> ("got_first_core") index -> ( counter ) } == "true") ? 1 : 0) + ((collection_get{ collection -> ("got_second_core") index -> ( counter ) } == "true") ? 2 : 0) )} ; # this is a really bad hack, but I couldn't find a concise way to code things. Maybe I could use a dynamic boolean.
   part_bonus_score : dynamic_integer {( ((collection_get{ collection -> ("got_first_bonus") index -> ( counter ) } == "true") ? 1 : 0) + ((collection_get{ collection -> ("got_second_bonus") index -> ( counter ) } == "true") ? 2 : 0) )} ; # this is a really bad hack, but I couldn't find a concise way to code things. Maybe I could use a dynamic boolean.
}

