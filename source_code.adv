   block_go_r40 : block {
      location = r40
      block_when_not = point_door_cloud
      message = \"Uggggh, let me tell you, kid-o,\" says the {puz_point_dork_loud}. \"Ain't a DANG THING to the north here. Not that you deserve to see anywhere interesting. Just, I'm saving you from your own worst urges. Why does it always fall to me?\" The {puz_point_dork_loud} then proceeds to disparage people who have too-slick social skills.
   }

