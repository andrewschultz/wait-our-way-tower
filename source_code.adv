                  : print "No need to yell open again!" ;
                  : done ;
               }
               : print "The yellow pin glows and burns in your hand. You throw it at the door, reflexively. The pin sticks in the door! With a loud SSS, you watch the door melt away. You can go {dir_e_y} now!" ;
               : set_integer var="tempint" "2" ;
               : set_true "point_yell_open" ;
               : gosub "add_point" ;
               : done ;
            }
