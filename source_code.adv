booleans {
   # game state (noncritical)
   note_half_think : boolean "false" ;
   showed_first_note : boolean "false" ;
   warn_score_header : boolean "false" ;
   wait_yet : boolean "false" ;
   me_x_yet : boolean "false" ;
   won_yet : boolean "false" scope="survivor" ;
   in_number_choice : boolean "false" ;
   noted_upper_right : boolean "false" ;
   think_note_yet : boolean "false" ;
   map_note : boolean "false" ;

   # option(s)
   opt_hone_aye : boolean "false" ;
   opt_color_coding : boolean "false" ;
   opt_score_notify : boolean "true" scope="survivor" ;

   # game state (critical)
   gamestate_bros_second_trigger : boolean "false" ;
   gamestate_bros_second_placed  : boolean "false" ;
   gamestate_thug_activated      : boolean "false" ;
   gamestate_thug_chase          : boolean "false" ;
   gamestate_thug_gone           : boolean "false" ;
   gamestate_r21_e               : boolean "false" ;
   gamestate_fail_oops_known     : boolean "false" ;
   gameflag_note_pals_stay_end   : boolean "false" ;
   gamestate_no_oops_yet         : dynamic_boolean {( (is_at "r14" || is_at "r04") && !point_fey_loops )} ;
   gamestate_end_companions      : dynamic_boolean {( point_mage_urgent && !point_bah_slumping )} ;

   # gamestate combo
   girl_present : dynamic_boolean {( point_girl_only && !point_warm_acres )} ;

   #blocker(s) derived from gamestate
   r13_secondary_block : dynamic_boolean {( gamestate_bros_second_placed && !point_whee_plucky )} ;
   r22_secondary_block : dynamic_boolean {( gamestate_r21_e && !point_fell_asleep )} ;

   # points (sorted, beginning or end)
   point_bah_slumping      : boolean "false" ; # 45
   point_blest_able        : boolean "false" ; # 46
   point_broke_lass        : boolean "false" ; # 44
   point_can_do            : boolean "false" ; # 00
   point_catch_acing         : boolean "false" ; # 35
   point_chest_reigning    : boolean "false" ; # 13
   point_cloth_robbing     : boolean "false" ; # 25
   point_coin_ovations     : boolean "false" ; # 10
   point_cue_bland         : boolean "false" ; # 27
   point_door_cloud        : boolean "false" ; # 22
   point_dry_vendors       : boolean "false" ; # 07
   point_duh_losing        : boolean "false" ; # 06
   point_dumb_parable      : boolean "false" ; # 08
   point_dump_liars        : boolean "false" ; # 14
   point_eh_sink           : boolean "false" ; # 26
   point_feel_daring       : boolean "false" ; # 15
   point_fell_asleep       : boolean "false" ; # 04
   point_fey_loops         : boolean "false" ; # 41
   point_fly_traps         : boolean "false" ; # 33
   point_flow_tripling     : boolean "false" ; # 23 #?? don't annoy water gods too much
   point_frame_easily      : boolean "false" ; # 30
   point_free_crusty       : boolean "false" ; # 16
   point_girl_only         : boolean "false" ; # 32
   point_halt_error        : boolean "false" ; # 03
   point_hate_rash         : boolean "false" ; # 05
   point_heard_all         : boolean "false" ; # 38
   point_herd_all          : boolean "false" ; # 36
   point_mage_urgent       : boolean "false" ; # 43
   point_me_growth         : boolean "false" ; # 24
   point_no_injuries       : boolean "false" ; # 09
   point_pitch_earning     : boolean "false" ; # 12
   point_ply_towels        : boolean "false" ; # 28
   point_pose_teasing      : boolean "false" ; # 19
   point_right_angles      : boolean "false" ; # 42
   point_say_four          : boolean "false" ; # 17
   point_say_loaners       : boolean "false" ; # 18
   point_seek_rest         : boolean "false" ; # 31
   point_shape_up          : boolean "false" ; # 37
   point_sun_catching      : boolean "false" ; # 20
   point_tense_ops         : boolean "false" ; # 29
   point_thief_lore        : boolean "false" ; # 01
   point_tightened_rousing : boolean "false" ; # 11
   point_troop_leading     : boolean "false" ; # 47
   point_tufty_key         : boolean "false" ; # 21
   point_vine_eater        : boolean "false" ; # 34
   point_warm_acres        : boolean "false" ; # 40
   point_whee_plucky       : boolean "false" ; # 39
   point_yell_open         : boolean "false" ; # 02

   # bonus point(s)
   bonus_point_ho_maps : boolean "true" ;

   # silly random
   r20_jail : boolean "false" ;

   # auxiliary variables
   opt_on_off  : boolean "false" ;
   drawing_map : boolean "false" ;

   # general go-blocking
   goblock_21 : dynamic_boolean {( !point_yell_open)} ;

   #core points-done blockers
   coreblock_20 : dynamic_boolean {( opt_hone_aye && point_yell_open )} ;

   #bonus points-done blockers
   bonusblock_20 : dynamic_boolean {( opt_hone_aye && point_yell_open )} ;

   # blocker dynamic booleans
   r20_hone_block : dynamic_boolean {( opt_hone_aye )} ;

   # think variables
   already_got_command : boolean "false" ;
   first_half : boolean "false" ;
   half_bonus : boolean "false" ;
   bonus_obfuscated_note_yet : boolean "false" ;
   bonus_half_note : boolean "false" ;
   think_core_yet : boolean "false" ;
   think_bonus_yet : boolean "false" ;
   think_text_yet : boolean "false" ;
   print_bonus_nag_after : boolean "false" scope="survivor" ;
   print_core_nag_after : boolean "false" ;
   solved_both_parts_core_nag : boolean "false" ;
   solved_both_parts_bonus_nag : boolean "false" ;

   in_bonus_half : boolean "false" ;
   unneeded_half : dynamic_boolean {( tempint == 0 && !in_bonus_half )} ;

   # think variables
   think_bah_slumping  : boolean "false" ;
   think_broke_lass    : boolean "false" ;
   think_cloth_robbing : boolean "false" ;
   think_coin_ovations : boolean "false" ;
   think_door_cloud    : boolean "false" ;
   think_fey_loops     : boolean "false" ;
   think_frame_easily  : boolean "false" ;
   think_free_crusty   : boolean "false" ;
   think_heard_all     : boolean "false" ;
   think_herd_all      : boolean "false" ;
   think_pitch_earning : boolean "false" ;
   think_ply_towels    : boolean "false" ;
   think_right_angles  : boolean "false" ;
   think_say_four      : boolean "false" ;
   think_say_loaners   : boolean "false" ;
   think_tense_ops     : boolean "false" ;
   think_vine_eater    : boolean "false" ;
   think_warm_acres    : boolean "false" ;

   think_any : dynamic_boolean {( commands_figured > 0 )} ;

   # auxiliary
   tats_blurry  : boolean "false" ;
   show_overlay : boolean "true" ;

   # testing
   tats_each_move : boolean "false" ;
}

vocabulary {

   : verb / aliases = [tj, testjump] ;

}

locations {
   r00 : location "{r00_loc}" header="{r00_header}" {
      on_command {
         : match "fly traps" {
            : if (point_fly_traps) {
               : print "You already unwrapped the fly taps, for better or worse." ;
               : done ;
            }
