subroutines {
# first standard verbs
# second auxiliary
# third options
# fourth game specific GOTO
# fifth noun keywords
# sixth TESTJUMP

   take_inventory : subroutine {
      : if (score < 2) {
         : print "Nothing in your hands." ;
         : return ;
      }
      : if (score == 2) {
         : print "Well, you now have a yellow pin, which is something." ;
         : return ;
      }
      : if (score > 40) {
         : if (!point_bah_slumping && point_mage_urgent) {
            : print {( "You have " + (point_broke_lass ? "two allies in the mage, urgent and the (formerly) broke lass." : "an ally in the mage, urgent." ) )} ;
         }
         : print "You're carrying nothing, but surely all you need is your keen wit and insight to finish things off. You hope." ;
         : return ;
      }
      : set_false "inventory_intangibles" ;
      : if (is_carried "dumb_parable") {
         : print "You have a dumb parable stuck in your head. Perhaps it would help to fob it off on someone else." ;
      }
      : if (is_carried "coin") {
         : print "You have that {cnco} from the juries. Where to spend or increase it?" ;
      }
      : if (is_carried "riches") {
         : print {( "You've acquired riches from the pit. " + (point_say_four ? "You bought four oars with it, but you have a good chunk left over." : "They might buy a couple things you need.") )} ;
      }
      : if (is_carried "dumb_pliers") {
         : print {( "The dumb pliers you got from the chest " + (point_cloth_robbing ? "got some fluffy square cloths you're also carrying." : "could be useful to grab something later.") )} ;
      }
      : if (is_carried "tufty_key") {
         : print "The tough tiki left you a tufty key." ;
      }
      : if (is_carried "vie_neater") {
         : print "You have that coupon promising to {puz_point_vie_neater} you got from the cube land." ;
      }
      : if (point_say_four && !point_say_loaners) {
         : print "The four oars you bought are waiting {here_r10} until you buy a suitable craft." ;
         : set_true "inventory_intangibles" ;
      }
      : if (is_carried "riches") {
         : print {( point_say_four ? "You still have some riches left over from the titan and the pit." : "You have some riches the titan left in the pit." )} ;
      }
      : if (point_me_growth && !point_tense_ops) {
         : print "You felt some growth from the meager oath but didn't find anywhere to share or use it meaningfully yet." ;
         : set_true "inventory_intangibles" ;
      }
      : if (point_say_loaners && !point_girl_only) {
         : print "You bought a {mtmr} which can dock {here_r33}." ;
         : set_true "inventory_intangibles" ;
      }
      : if (point_tense_ops && !point_frame_easily) {
         : set_true "inventory_intangibles" ;
         : print "You have an {iaad} the ten sops gave you. It reminds you to have more confidence in yourself after helping them. Maybe you can tackle bigger things!" ;
      }
      : if (!point_warm_acres && point_girl_only) {
         : print {( "You have a loyal follower in the girl from the island. She's carrying {puz_point_her_doll} around." + (carried() == 0 && !inventory_intangibles ? " And companionship's more important than silly old possessions!" : "" ) )} ;
         : set_true "inventory_intangibles" ;
      }
      : if (!point_warm_acres && herd_score > 0) {
         : print {( "You've gained support from " + ((herd_score == 2) ? "cats and dogs in the western corners of the map" : point_herd_all ? "cats {here_r00}" : "dogs {here_r40}") )} ;
         : set_true "inventory_intangibles" ;
      }
      : if (carried() == 0 && !inventory_intangibles) {
         : print "You're not carrying anything at the moment, tangible or intangible." ;
         : return ;
      }
   }
   listen_stub : subroutine {
      : if (is_at "r11") {
         : print {( point_duh_losing ? "You enjoy the silence and lack of dull oozing words. You can't resist refuting what you remember of them, though." : "The {puz_point_dull_oozing} makes you wonder why bother. The world beyond the tower must be even riskier than the tower! And so forth." )} ;
      } : else_if (is_at "r20") {
         : print "You hear nothing but occasionally mutter to yourself <rue my room, aye<#888>>." ;
      } : else_if (is_at "r21") {
         : print {( point_fell_asleep ? "It's quiet now." : point_halt_error ? (r22_secondary_block ? "The \"{puz_point_fellas_leap}\" order echoes in your head." : "Quiet, for the moment.") : "The hall terror is making all kinds of noise." )} ;
      } : else {
         : print "Nothing." ;
      }
   }
   map_stub : subroutine {
      : if (!bonus_point_ho_maps) {
         : print "You haven't gained access to the internal game map command yet. It's not critical to win, though." ;
         : done ;
      }
      : set_true "drawing_map" ;
      : clear_screen ;
      : update_graphic "m_0_blank" ;
      : set_false "drawing_map" ;
      : if (!map_note) {
         : print "{one_time}there are no one-way paths. Dotted paths mean ways that are blocked until you've solved a puzzle." ;
         #: print "{one_time}there are no one-way paths. If you have activated the option to block completed rooms, they will be in <GREY<#888>>." ;
         : set_true "map_note" ;
      }
      : press_any_key ;
      : redescribe ;
      : done ;
   }

   inventory_nouns : subroutine {
      : if (point_girl_only && !point_warm_acres) {
         : match "_ doll" {
            : print "It's a weird looking doll, but it probably helped the girl feel less lonely. Looking at it, you think \"find-all-fine doll.\"" ;
            : done ;
         }
         : match "_ girl" {
            : print "She doesn't have much to say, but she follows you closely now, and she just won't let go of {puz_point_her_doll}." ;
            : done ;
         }
      }
      : if (is_carried "coin") {
         : match "_ coin;_ ooh;_ new;_ coy" {
            : print "It's nothing to be thrilled about on its own. But maybe you can trade up, somehow." ;
            : done ;
         }
      }
      : if (is_carried "dumb_pliers") {
         : match "_ dumb;_ pliers" {
            : print {( point_cloth_robbing ? "They got the job done. But you can't bring yourself to part with them yet. When the time comes, though..." : "Well, they look like they will get the job done, whatever that job is. You're kind of glad they don't have a lot of options. That might make them confusing. You wonder if this makes you dumb." )} ;
         }
      }
      : if (is_carried "vie_neater") {
         : match "_ vie;_ neater;_ coupon;_ promise" {
            : print {( think_vine_eater ? "You know it's to eat vines. Now to find vines, or vine-ish things!" : "The promise on the coupon is a bit vague. But perhaps it has to be, to escape censorship and scrutiny." )} ;
            : done ;
         }
      }
      : if (is_carried "tufty_key") {
         : match "_ tufty;_ key" {
            : print "It's certainly oddly-shaped. Well, the part you hold. Perhaps that will make where it goes more easily identifiable." ;
            : done ;
         }
      }
      : if (point_tense_ops && !point_frame_easily) {
         : match "_ agree;_ aye;_ degree;_ id" {
            : print "The {iaad} certifies you as someone who gets along well with others and helps them achieve their goals." ;
            : done ;
         }
      }
      : if (point_say_loaners && (is_at "r42" || is_at "r43" || is_at "r33")) {
         : match "_ mo;_ tried;_ moat;_ ride" {
            : print {( "Sturdy enough. You couldn't afford anything too expensive. " + ( !has_visited "r43" ? "You may wish to take the moat ride {dir_n_y}, now you own it." : is_at "r33" ? "Sitting on the shore, waiting to take you back." : is_at "r42" ? (point_flow_tripling ? "You can row it to the west or south safely." : "The water is too dead to really move the ride west, but you can easily go back south." ) : (point_girl_only ? "It got you a companion. You're not sure if it can do any more." : "You haven't done everything with it you could, you sense." )) )} ;
            : done ;
         }
      }
      : if (is_carried("dumb_parable")) {
         : match "_ dumb;_ parable" {
            : print "You toss the parable around in your head. It is what it is. (Did you just think that? Ugh!)\nPeople will see what they want in it. You're not trying to scam anyone." ;
            : done ;
         }
      }
      : if (point_say_four) {
         : match "_ oars" {
            : print {( has_visited "r42" ? "The oars you bought got you across the water." : point_say_loaners ? "You should try the oars out going north from {here_r33}." : "You think about what the oars would go with. It'd be nice to get them off the vendors' hands, eventually." )} ;
            : done ;
         }
      }
   }

   ##### AUXILIARY
   note_score_upper_right : subroutine {
      : if (!noted_upper_right) {
         : print "{one_time}you can toggle score notifications with {optt_notify} {yn}. The score is always tracked in the upper right." ;
         : set_true "noted_upper_right" ;
      }
   }
   add_point : subroutine {
      : gosub "check_100" ;
      : collection_modify { collection = "tried_combo_core" index -> (tempint) content -> ("true") } ;
      : print "<Your score has just gone up by a point!<#ff0>>" ;
      : increment "score" ;
      : update_graphic ;
   }
   note_thinks : subroutine { # special case SCORE vs THINK, note you've cleared all the good ideas you had.
      : if (!think_note_yet) {
         : print "{one_time}{vd_think} will track any command that you need to retry later, after preparation. Also, the status line in the upper left will show +1 or more, for commands you've guessed right but still need prep for." ;
         : set_true "think_note_yet" ;
      }
   }
   check_100 : subroutine {
      : if (tempint >= 100) {
         : print "This hasn't been sorted yet. This won't kill gameplay but will detect how things are sorted for half-right guesses. And you get a point." ;
         : increment "score" ;
         : done ;
      }
   }
   say_half : subroutine {
      : match "* -;- *" {
         : print "Feels right, but what to pair that word with?" ;
         : done ;
      }
      : gosub "check_100" ;
      : cycle key = "one_right" predictable_order = "true" skip_interval = "0" max_loops = "1" {
         : print {( "The {first_or_second} word felt right, but the other didn't. You must be halfway there{for_bonus}.{already_got_check}" )} ;
         : print "That halfway-there feeling again. You must have gotten the {first_or_second} word there{for_bonus}.{already_got_check}" ;
         on_exhausted {
            : print {( (first_half ? "First word right, second word wrong" : "First word wrong, second word right") + "{for_bonus}.{already_got_check}" )} ;
         }
      }
      : if (!note_half_think) {
         : print "{one_time}{vd_think} will show half-right guesses until you've gotten both words right." ;
         : set_true "note_half_think" ;
      }
      : if (first_half) {
         : if (half_bonus) {
            : collection_modify { collection = "got_first_bonus" index -> (tempint) content -> ("true") ; }
         } : else {
            : collection_modify { collection = "got_first_core" index -> (tempint) content -> ("true") ; }
         }
      } : else {
         : if (half_bonus) {
            : collection_modify { collection = "got_second_bonus" index -> (tempint) content -> ("true") ; }
         } : else {
            : collection_modify { collection = "got_second_core" index -> (tempint) content -> ("true") ; }
         }
      }
      : set_false "already_got_command" ;
      : if (!half_bonus) {
         : done ;
      }
   }

   set_tats_num : subroutine {
      : if (is_at "end_zone") {
         : set_integer var="my_tats_num" {( tats_end )} ;
      } : else_if (is_at "top_zone") {
         : set_integer var="my_tats_num" {( tats_top )} ;
      } : else_if (is_at "middle_zone") {
         : set_integer var="my_tats_num" {( tats_middle )} ;
      } : else_if (is_at "bottom_zone") {
         : set_integer var="my_tats_num" {( tats_bottom )} ;
      } : else {
         : set_integer var="my_tats_num" "0" ;
      }
      : if (gamestate_fail_oops_known && (is_at "r14" || is_at "r04") && !point_fey_loops) {
         : set_integer var="my_tats_num" "35" ;
      }
   }
   ########################## options

   colorclue_choice : subroutine {
      : if (won_yet) {
         : return ;
      }
      : ask_bool {
         question   = {this_game} puts critical words in <PURPLE<#f0f>> to help you know what to work with. The option can be changed in-game with {optt_ch} (on/off are reserved by Adventuron.)
         yes_answer = Yes, I'd like to use color-coded hinting. (<RECOMMENDED<#0f0>>)
         no_answer  = No, I'd prefer not to use color-coded hinting.
         var        = opt_color_coding
      }
      : print {( "Color-coded hinting is " + (opt_color_coding ? "now available." : "disabled.") + " We're ready to start the game, now!" )} ;
      : press_any_key ;
      : clear_screen ;
   }

   check_options : subroutine {
      : match "ch _" {
         : gosub "options_colorhint" ;
      }
      : match "notify _" {
         : gosub "options_score_notify" ;
      }
      : match "hone aye;hone eye" {
         : print {( "Available exits are " + (opt_hone_aye ? "already" : "now") + " honed to ones you still need to use to win." )} ;
         : gosub "set_tats_num" ;
         : if (my_tats_num == 0 && !opt_hone_aye) {
            : print "Since you're choosing this option, and you're done here, I'll make a note of that. You can exit, but you can't come back." ;
         }
         : set_true "opt_hone_aye" ;
      }
      : match "ho nigh" {
         : print {( "Exits are " + (opt_hone_aye ? "already" : "now") + " all available, even ones you don't need to revisited." )} ;
         : set_false "opt_hone_aye" ;
      }
   }

   option_err_stub : subroutine {
      : match "_ -" {
         : print "Toggling {tempopt} without an argument ({yn}) is not supported." ;
         : done ;
      }
      : print "Toggling {tempopt} requires one of {yn} as an argument." ;
      : done ;
   }

   options_colorhint : subroutine {
      : set_boolean var="opt_on_off" {( opt_color_coding )} ;
      : match "ch yes" {
         : print "Now {optt_ch} is activated." ;
         : set_true "opt_color_coding" ;
         : done ;
      }
      : match "ch no" {
         : print "Now {optt_ch} is deactivated." ;
         : set_false "opt_color_coding" ;
         : done ;
      }
      : set_string var="tempopt" text="{optt_ch}" ;
      : gosub "option_err_stub" ;
   }

   options_score_notify : subroutine {
      : set_boolean var="opt_on_off" {( opt_score_notify )} ;
      : match "notify yes;notify y" {
         : print "Score notify is now on.";
         : set_true "opt_score_notify";
         : done ;
      }
      : match "notify no;notify n" {
         : print "Score notify is now off.";
         : set_false "opt_score_notify";
         : done ;
      }
      : set_string var="tempopt" text="{optt_notify}" ;
      : gosub "option_err_stub" ;
   }

   ############################ rejects

   odd_dir_note : subroutine {
      : match "se _;sw _;ne _;nw _" {
         : print "You don't need to use diagonal directions. Only the four main cardinal directions, and (where indicated) up/down." ;
         : done ;
      }
      : match "u _;d _;enter _;in _;exit _;out _" {
         : print "Only the four main cardinal directions are used here, and (only when indicated) up/down." ;
         : done ;
      }
   }

   #########################################diagnostics

   diagnostic_think_core_half : subroutine {
      : set_integer var="counter" "0" ;
      : set_false "think_core_yet" ;
      : while (counter < max_score) {
         : if ((collection_get{ collection -> ("tried_combo_core") index -> ( counter )} == "false")) {
            : if (part_core_score > 0) {
               : if (!think_core_yet) {
                  : print "{think_here_also} is a summary of correct bonus command half-guesses:" ;
                  : set_true "think_core_yet" ;
                  : set_true "think_text_yet" ;
               }
               : print {( (part_core_score != 2 ? (collection_get{ collection -> ("think_first_core") index -> (counter) }) : "{noguess_c_1}") + " " + (part_core_score >= 2 ? (collection_get{ collection -> ("think_second_core") index -> (counter) }) : "{noguess}") + " " + (collection_get{ collection -> ("situations_core") index -> (counter) }) )} ;
               : if (!solved_both_parts_core_nag && part_core_score == 3) {
                  : set_true "print_core_nag_after" ;
               }
            }
         }
         : increment "counter" ;
      }
   }

