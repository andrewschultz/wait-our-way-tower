         : match "warm acres" {
            : if (herd_score != 2) {
               : print {( "You don't have " + (herd_score == 1 ? "enough" : "anything") + " to try to warm the hearts of the war makers!" )} ;
               : set_true "think_warm_acres" ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (point_warm_acres) {
               : print "It's already warmer and cozier here. We don't need to burn things up." ;
               : done ;
            }
            : print "What good can a bit of warmth do? Even if it is emotional warmth? Well, you try it, and somehow, the dogs' and cats' animal instincts  sense you're ready. They swarm over the area. Some of the makers absolutely loathe pets, and they flee right away. Other makers, mostly the recently initiative, actually are receptive to the dogs and cats. They seem more interesting than planning war or whatever. Among some of them are the girl's old parents, apparently. She points them out to you. They kind of look at her and run by. But two others near say, wait, you're that kid they talked about, we feel bad about this, why don't you come with us at least temporarily. A dog and cat each follow as she goes. She waves goodbye to you, still holding her doll.\nNow evreyone's gone, you can see what's {dir_e_y}. Not much left {dir_w_v}." ;
            : destroy "only_girl" ;
            : set_integer var="tempint" "40" ;
            : set_false "think_warm_acres" ;
            : set_true "point_warm_acres" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_warm_acres) {
            : match "warm _;_ acres" {
               : set_integer var="tempint" "40" ;
               : set_boolean var="already_got_command" {( think_warm_acres && !point_warm_acres )} ; # this is optional. Delete if point does not rely on any other variables.
               : set_false "first_half" ;
               : match "warm _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }

   }
