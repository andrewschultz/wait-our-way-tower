            : match "cue bland" {
               : if (point_cue_bland) {
                  : print "You already worked your way through this place." ;
                  : done ;
               }
               : print "It only makes sense, doesn't it? With all the garish stuff, the dull stuff will in its way stand out, often is something that's not trying to impress you but maybe valuable, or that only people who are dazzled by silliness would be able to find and use. At the end, you find a simple coupon saying, {puz_point_vie_neater}. It doesn't specify how to buy, or how to be neater, but perhaps the people you summon with it will know all that. Well, it's something at any rate." ;
               : pocket "vie_neater" ;
               : set_integer var="tempint" "27" ;
               : set_true "point_cue_bland" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_cue_bland) {
               : match "queue _" {
                  : print "Hmm. It's unlikely you'll find people or entities queueing up for where to find something. But there might be a similar indicator. Or similar sounding indicator." ;
               }
               : match "cue _;_ bland" {
                  : set_integer var="tempint" "27" ;
                  : set_false "first_half" ;
                  : match "cue _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r42 : location "{r42_loc}" header="{r42_header}" {
      on_command {
         : match "_ seacrest;_ sea;_ crest" {
            : print {( point_seek_rest ? "It's kind of relaxing to look at. Perhaps it leads to bigger things, if observed correctly." : "You're glad it helped you find a less gloomy part of the island." )} ;
            : done ;
         }
         : if (point_seek_rest && !point_girl_only) {
            : match "_ grr;_lonely;listen _" {
               : print "The GRR seems artificial. You can't put your finger on it." ;
               : done ;
            }
         }
         : match "_ gray;_ vile;_ grave;_ isle" {
            : print {( "It's quite expansive. You'd probably be in danger exploring too much. " + ( point_girl_only ? "You've gotten a companion. You both should probably leave." : "There should be something worthwhile here -- find it and get out, you reckon." ) )} ;
            : done ;
         }
         : match "seek rest" {
            : if (point_seek_rest) {
               : print "You already sought and found." ;
               : done ;
            }
            : print "You find it, but just as you're really starting to rest, you hear a {puz_point_grr_lonely}. You can't sleep with that around!" ;
            : set_integer var="tempint" "30" ;
            : set_true "point_seek_rest" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_seek_rest) {
            : match "seek _;_ rest" {
               : set_integer var="tempint" "30" ;
               : set_false "first_half" ;
               : match "seek _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
         : if (point_seek_rest) {
            : match "girl only" {
               : if (point_girl_only) {
                  : print "It would be belittling to repeat this reasoning in front of her." ;
                  : done ;
               }
               : print "You look for the source of the girl, and it does sound a bit put on, and you wonder if it is somebody just trying to intimidate people. Sure enough, you find a small girl towering off to the side, holding {puz_point_her_doll}. She says, did my parents bring me to pick me up? You say no, you don't know who her parents are. She said, well, my parents had me stay here to avoid the really scary bits, but it was scary enough here, but they wouldn't mislead me, right? You don't know what to say to this, but you can only suggest that you should help her find them. She doesn't sound too enthusiastic about this car but she's sick of the island, and you will be glad for the company of her. And, of course, {puz_point_her_doll}." ;
               : set_integer var="tempint" "32" ;
               : set_true "point_girl_only" ;
               : gosub "add_point" ;
               : done ;
            }
            : if (!point_girl_only) {
               : match "girl _;_ only" {
                  : set_integer var="tempint" "32" ;
                  : set_false "first_half" ;
                  : match "girl _" {
                     : set_true "first_half" ;
                  }
                  : gosub "say_half" ;
                  : done ;
               }
            }
         }
      }
   }
   r43 : location "{r43_loc}" header="{r43_header}" {
      on_command {
         : match "_ float;_ rippling" {
            : print {( point_flow_tripling ? "Fast enough to use as transport." : "It barely makes your craft move at all. You need it to pick up a bit." )} ;
            : done ;
         }
         : if (point_flow_tripling) {
            : match "_ flow;_ tripling" {
               : print "It kind of circles around without making a big vortex in the center, so you can go where you need to, {r43_dir_w} or back {dir_s_v}." ;
               : done ;
            }
         }
         : match "flow tripling" {
            : if (point_flow_tripling) {
               : print "Tripling the flow again would probably capsize your craft. It's like compound interest, only it gets places quicker. The wrong places." ;
               : done ;
            }
            : print "Finally, the waters are less calm, and fortunately, they're not rough enough to drag you places, but you see where the currents are, and there's one that flows pretty reliably to the {dir_w_y}. You can take it now, if you want." ;
            : set_integer var="tempint" "23" ;
            : set_true "point_flow_tripling" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_flow_tripling) {
            : match "flow _;_ tripling" {
               : set_integer var="tempint" "23" ;
               : set_false "first_half" ;
               : match "flow _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
   r44 : location "{r44_loc}" header="{r44_header}" graphic="r44_0" {
      on_command {
         : match "_ ten;_ sops" {
            : print {( "The sops crowding inside this building " + (!point_tense_ops ? "look very unsure of themselves but also suspicious of outside help." :  "seem happy now, not really pressing for whatever their plan is. They don't need any more outside help." ) )} ;
            : done ;
         }
         : match "tense ops" {
            : if (!point_me_growth) {
               : print "You just don't have the wherewithal to deal with tension yet! Still, good idea for later." ;
               : set_true "think_tense_ops" ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (point_tense_ops) {
               : print "You already acknowledged and defused the tension." ;
               : done ;
            }
            : print "You get their eternal thanks for sorting things out. Which isn't fungible, but it is a confidence booster." ;
            : set_integer var="tempint" "29" ;
            : set_false "think_tense_ops" ;
            : set_true "point_tense_ops" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_tense_ops) {
            : match "tense _;_ ops" {
               : set_integer var="tempint" "29" ;
               : set_boolean var="already_got_command" {( think_tense_ops && !point_tense_ops )} ; # this is optional. Delete if point does not rely on any other variables.
               : set_false "first_half" ;
               : match "tense _" {
                  : set_true "first_half" ;
               }
               : gosub "say_half" ;
               : done ;
            }
         }
      }
   }
}

# Defines things in the world (scenery cannot be carried)
objects {
   # on you at all times
   phase_tats : object "{i_fspt}" ;

   # objects that come and go
   coin : object "Not much, but it's something." conspicuous = "false" ;
   dumb_pliers : object "Sturdy. Pliers don't have to be smart." conspicuous = "false" ;
   dumb_parable : object "Man. It's pretty dumb." conspicuous = "false" ;
   four_oars : object "You got those four oars from {here_r10}." conspicuous = "false" ;
   only_girl : object "She is holding {puz_point_her_doll}." conspicuous = "false" ;
   riches : object "The lesser of the titan's riches." conspicuous = "false" ;
   towels : object "The towels from under the claw." conspicuous = "false" ;
   tufty_key : object "The tufty key from the tough tiki" conspicuous = "false" ;
   vie_neater : object "The VIE NEATER voucher you got from the Cue, Bland" ;

   # fixed items
   wry_tangles : object "Very interesting, but not quite for you." at = "r15" conspicuous="false" ;

   # npc who follow you, friendly or unfriendly
   major_gent : object "A bit too nice here." at = "r35" conspicuous = "false" ;
   mage_urgent : object "The former major gent has now swung a bit too much the other way." conspicuous = "false" ;
   broke_lass : object "The broke lass doesn't seem that broke, or broken, now." conspicuous = "false" ;
   thug : object "{trtg_status}." at = "r25" conspicuous = "false" ;
}

zones {
   top_zone : zone {
      locations = [ r30, r31, r32, r33, r34, r40, r41, r42, r43, r44 ]
   }
   middle_zone : zone {
      locations = [ r20, r21, r22, r23, r24 ]
   }
   bottom_zone : zone {
      locations = [ r00, r01, r02, r03, r04, r10, r11, r12, r13, r14 ]
   }
   end_zone : zone {
      locations = [ r25, r26, r27, r15, r35 ]
   }
}

