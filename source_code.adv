         : match "broke lass" {
            : if (point_broke_lass) {
               : print "She's already been summoned. You're done here." ;
               : done ;
            }
            : if (!point_mage_urgent) {
               : print "Ugh. The major gent and his drenching self-pity would be a bit too awkward for her right now. He's almost too much for you. He needs change, somehow." ;
               : set_true "think_broke_lass" ;
               : gosub "note_thinks" ;
               : done ;
            }
            : if (!point_right_angles) {
               : print "Ugh. The mage, urgent, would try a bit too hard to impress any Broke Lass right now. You'll need to change him, again, or perhaps affect his own change from within, before you can gain a new companion." ;
               : set_true "think_broke_lass" ;
               : gosub "note_thinks" ;
               : done ;
            }
            : print "The broke lass peers around, and she looks a bit worried to see the major jet there. He immediately says, you know, I made a bad first impression, but I just want to get things done. There is that boss to the right, and we can't deal with it all on our own, but maybe we can together, and if that's all we do, it'll be pretty big. The broke glass nods, impressed. OK, let's do this." ;
            : set_integer var="tempint" "45" ;
            : set_false "think_broke_lass" ;
            : set_true "point_broke_lass" ;
            : gosub "add_point" ;
            : done ;
