            }
            : print "The major gent slowly starts talking louder and faster, and it gets to the point where you can't interrupt them. They start mentioning times they felt ripped off, and how they need to take things back and show them, whoever they are. They they finally get around to asking you what you're doing, and you mentioned you're on a quest, and they say, well, obviously you haven't finished it yet so maybe you need some help, which you guess is flattering. They really could use a bit of subtlety or thought in their new found activity. Where to find it?" ;
            : set_integer var="tempint" "44" ;
            : set_true "point_mage_urgent" ;
            : destroy "major_gent" ;
            : create "mage_urgent" ;
            : gosub "add_point" ;
            : done ;
         }
         : if (!point_mage_urgent) {
            : match "mage _;_ urgent" {
               : set_integer var="tempint" "44" ;
               : set_false "first_half" ;
               : match "mage _" {
