               : done ;
            }
         }
         : match "_ door" {
            : print {( point_yell_open ? "It's open now." : "It's sturdy. It has a small hole where a big keyhole would normally be." )} ;
            : done ;
         }
         : if (!point_yell_open) {
            : match "_ hole;_ keyhole" {
               : print {( point_thief_lore ? "Just sticking the yellow pin in didn't quite do the trick. Perhaps you need to do something as well." : "Very small and round. Maybe you could find a key or key substitute to put in there. Or maybe you need to do something." )} ;
